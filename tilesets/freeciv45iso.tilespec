
[tilespec]

; Freeciv45 iso tileset, built by tilesets/make-freeciv45iso.py from amplio2.tilespec; see RECORD.md.

; Format and options of this tilespec file:
options = "+Freeciv-3.2-tilespec duplicates_ok"

; A simple name for the tileset specified by this file:
name = "Freeciv45 iso"
priority = 4

; There`s no separate versioning in tilesets part of main freeciv distribution
;version = ""

; Summary and full description of the tileset.
summary = _("Freeciv45 iso tileset: 192x96 diamonds, painted ground for every terrain, amplio2 for the rest.")
;description = ""

; TODO: add more overall information fields on tiles,
; eg, authors, colors, etc.

; What is the primary ruleset this tileset is meant for.
for_ruleset = "civ45"

; Basic tile sizes:
normal_tile_width = 192
normal_tile_height = 96

; Tileset pixels per screen point: the map shows a 192x96 tile as 96x48 points, so on a 2x
; (Retina) screen every pixel is drawn (Freeciv45 fork, Qt client).
pixel_ratio = 2
small_tile_width   = 15
small_tile_height  = 20

; The height svg flags should be drawn to, if they are used
svg_height = 88

; Basic tile style.
type = "isometric"
is_hex = FALSE

; Blended fog
fog_style      = "Darkness"
darkness_style = "Corner"

; offset the flags by this amount when drawing units
unit_flag_offset_x = 50
unit_flag_offset_y = 32
city_flag_offset_x = 4
city_flag_offset_y = 18

; offset the city occupied sprite by this amount
occupied_offset_x = 0
occupied_offset_y = 0

; offset the units by this amount
unit_offset_x = 16
unit_offset_y = 0

; offset of the normal activity icons
activity_offset_x = 98
activity_offset_y = 0

; offset of the selected unit sprites
select_offset_x = 0
select_offset_y = 0

; offset of the unit stack size number sprites
stack_size_offset_x = 40
stack_size_offset_y = 40

; offset the cities by this amount
city_offset_x = 0
city_offset_y = 0

; offset the city size number by this amount
; This is relative to full sprite origin.
city_size_offset_x = 0
city_size_offset_y = 0

; offset the city bar text by this amount (from the city tile origin)
citybar_offset_y = 60

; The city bar draws the nation flag as a chip this high (tileset pixels), so the flag does not
; cover the city's own art; 0 draws it at its own size
citybar_flag_height = 32

; offset the tile label text by this amount
tilelabel_offset_y = 30

; offset the upkeep icons by this amount from the top of the unit itself.
; The default is the normal tile height, which means that the upkeep icons
; appear below the unit icon if the unit icons are equal to tile height
; (typical in overhead tileset), or overlay lower part of the unit icon,
; if unit icon is higher than tiles (typical in iso tilesets)
;unit_upkeep_offset_y = 0

; Like unit_upkeep_offset_y, but to be used in case there`s only small
; space for the overall icon produced. Defaults to unit_upkeep_offset_y -
; not having alternative layout.
;unit_upkeep_small_offset_y = 0

; For tilesets with oriented units, the directional sprite to use to
; represent a unit type rather than a specific unit from the map
; (e.g., in worklists, editor, and online help). Does not have to be a
; valid direction for the tileset.
;unit_default_orientation = "s"

; The map is rendered in "layers", just like any decent image editor
; supports. The setting below allows to change the layer drawing order. The
; first layer in the list will be drawn below the others; the second on top
; of it, and so on. No layer can be omitted from the list, nor can new ones
; be added.
;layer_order =
;  "Background", ; Background color (if enabled, the player color where there
;                ; are units or cities). You probably want to leave this
;                ; first.
;  "Terrain1",   ; The three terrain layers. See sections [layerN] below.
;  "Darkness",   ; Darkness (unseen tiles)
;  "Terrain2",
;  "Terrain3",
;  "Water",      ; All extras with "River" style.
;  "Roads",      ; All extras with style "RoadAllSeparate",
;                ; "RoadParityCombined" or "RoadAllCombined".
;  "Special1",   ; 1st layer for extras with style "3Layers", "Single2" or
;                ; "Single1".
;  "Grid1",      ; Grid layer for isometric tilesets.
;  "City1",      ; City and walls.
;  "Special2",   ; 2nd layer for extras with "3Layers" and "Single2" styles.
;  "Fog",        ; Fog of war (on tiles one knows but doesn`t see).
;  "Unit",       ; Units except the selected one(s).
;  "Special3",   ; 3rd layer for extras with "3Layers" style, and base flags.
;  "City2",      ; City size when the city bar is disabled.
;  "Grid2",      ; Second grid layer (overhead tilesets only).
;  "Overlays",   ; Tile output sprites.
;  "TileLabel",  ; Tile labels ("Scorched spot").
;  "CityBar",    ; The city bar with name, production, food, ...
;  "FocusUnit",  ; The focused unit(s).
;  "Goto",       ; Goto turn count and intermediate points, *not* goto lines.
;  "WorkerTask", ; The unit task indicators ("G", "S", ...).
;  "Editor",     ; Editor stuff (selected tile and start points).
;  "InfraWork"   ; Icons for the extras being placed.

; This is special because it gets freed and reloaded as required:
main_intro_file    = "misc/intro"

; Below, the graphics spec files; must be somewhere (anywhere) in
; the data path. Order may be important for color allocation on
; low-color systems, and if there are any duplicate tags (lattermost
; tag is used).
files =
  "freeciv45iso/terrain1.spec",
  "freeciv45iso/terrain45.spec",
  "freeciv45iso/coast.spec",
  "freeciv45iso/blend.spec",
  "freeciv45iso/resources.spec",
  "freeciv45iso/features.spec",
  "freeciv45iso/extras.spec",
  "freeciv45iso/volcano.spec",
  "freeciv45iso/badges.spec",
  "freeciv45iso/tiles.spec",
  "freeciv45iso/marks.spec",
  "freeciv45iso/fog.spec",
  "misc/small.spec",
  "misc/events.spec",
  "misc/governments.spec",
  "misc/specialists.spec",
  "freeciv45iso/units.spec",
  "freeciv45iso/animals.spec",
  "misc/buildings-large.spec",
  "misc/wonders-large.spec",
  "freeciv45iso/building_icons.spec",
  "misc/space.spec",
  "misc/techs.spec",
  "freeciv45iso/tech_icons.spec",
  "misc/treaty.spec",
  "freeciv45iso/nuke.spec",
  "freeciv45iso/explosions.spec",
  "freeciv45iso/cities.spec",
  "freeciv45iso/bases.spec",
  "freeciv45iso/select.spec",
  "freeciv45iso/grid.spec",
  "freeciv45iso/borders.spec",
  "misc/cursors.spec",
  "freeciv45iso/overlays.spec",
  "freeciv45iso/citybar.spec",
  "misc/shields-large.spec",
  "misc/editor.spec",
  "misc/icons.spec"

files_svg =
  "misc/flags.spec"

files_pixel =
  "misc/flags-large.spec"


; Include color definitions
*include "misc/colors.tilespec"

; Terrain info - see README.graphics

; Layers and terrains: freeciv45test's (make-freeciv45test.py), painted ground on layer 0,
; the shore on layers 1 and 2.

[layer0]
match_types = "desert", "forest", "grassland", "hills", "jungle", "mountains", "water", "plains", "swamp", "tundra"

[layer1]
match_types = "water", "land", "ice"

[layer2]
match_types = "water", "arctic", "tundra", "desert", "forest", "jungle", "swamp", "hills", "mountains", "inaccessible"

; Water graphics referenced by terrain.ruleset
;

[tile_coast]
tag = "coast"
blend_layer = 1
num_layers = 3
layer0_match_type = "water"
layer1_match_type = "water"
layer1_match_with = "land"
layer2_match_type = "water"
layer2_match_with = "arctic"
layer1_sprite_type = "corner"
layer2_sprite_type = "corner"

[tile_floor]
tag = "floor"
blend_layer = 1
num_layers = 3
layer0_match_type = "water"
layer1_match_type = "water"
layer1_match_with = "land"
layer2_match_type = "water"
layer2_match_with = "arctic"
layer1_sprite_type = "corner"
layer2_sprite_type = "corner"

[tile_lake]
tag = "lake"
blend_layer = 1
num_layers = 3
layer0_match_type = "water"
layer1_match_type = "water"
layer1_match_with = "land"
layer2_match_type = "water"
layer2_match_with = "arctic"
layer1_sprite_type = "corner"
layer2_sprite_type = "corner"

[tile_inaccessible]
tag = "inaccessible"
blend_layer = 1
num_layers = 3
layer0_match_type = "water"
layer1_match_type = "water"
layer1_match_with = "land"
layer2_match_type = "inaccessible"
layer2_is_tall = TRUE
layer1_sprite_type = "corner"

; Land graphics referenced by terrain.ruleset
;

[tile_arctic]
tag = "arctic"
blend_layer = 1
num_layers = 3
layer0_match_type = "tundra"
layer1_match_type = "ice"
layer2_match_type = "arctic"

[tile_desert]
tag = "desert"
blend_layer = 1
num_layers = 3
layer0_match_type = "desert"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "desert"

[tile_forest]
tag = "forest"
blend_layer = 1
num_layers = 3
layer0_match_type = "forest"
layer0_match_with = "tundra"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "forest"
layer2_match_with = "tundra"
layer2_is_tall = TRUE

[tile_grassland]
tag = "grassland"
blend_layer = 1
num_layers = 3
layer0_match_type = "grassland"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "water"

[tile_hills]
tag = "hills"
blend_layer = 1
num_layers = 3
layer0_match_type = "hills"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "hills"
layer2_match_with = "desert"
layer2_is_tall = TRUE

[tile_jungle]
tag = "jungle"
blend_layer = 1
num_layers = 3
layer0_match_type = "jungle"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "jungle"
layer2_is_tall = TRUE

[tile_mountains]
tag = "mountains"
blend_layer = 1
num_layers = 3
layer0_match_type = "mountains"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "mountains"
layer2_match_with = "tundra", "arctic"
layer2_is_tall = TRUE

[tile_plains]
tag = "plains"
blend_layer = 1
num_layers = 3
layer0_match_type = "plains"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "water"

[tile_swamp]
tag = "swamp"
blend_layer = 1
num_layers = 3
layer0_match_type = "swamp"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "swamp"
layer2_is_tall = TRUE

[tile_tundra]
tag = "tundra"
blend_layer = 1
num_layers = 3
layer0_match_type = "tundra"
layer1_match_type = "land"
layer1_match_with = "water"
layer1_sprite_type = "corner"
layer2_match_type = "tundra"

[tile_volcano]
tag = "volcano"
blend_layer = 1
num_layers = 1
layer0_match_type = "mountains"

[tile_erupting_volcanoa]
tag = "erupting_volcanoa"
blend_layer = 1
num_layers = 1
layer0_match_type = "mountains"

[tile_erupting_volcanob]
tag = "erupting_volcanob"
blend_layer = 1
num_layers = 1
layer0_match_type = "mountains"

[extras]
styles =
    { "name",          "style"
      "road.road",     "RoadAllSeparate"
      "road.rail",     "RoadAllSeparate"
      "road.maglev",   "RoadAllSeparate"
      "road.river",    "River"
      "tx.irrigation", "Cardinals"
      "tx.farmland",   "Cardinals"
      "tx.mine",       "3Layer"
      "tx.oil_mine",   "3Layer"
      "tx.oil_rig",    "3Layer"
      "tx.nets",       "Single1"
      "tx.pollution",  "Single2"
      "tx.fallout",    "Single2"
      "tx.village",    "3Layer"
      "tx.hermit",     "3Layer"
      "tx.cottage",    "3Layer"
      "tx.hamlet",     "3Layer"
      "tx.village_stage", "3Layer"
      "tx.town",       "3Layer"
      "base.outpost",  "3Layer"
      "base.fortress", "3Layer"
      "base.airstrip", "3Layer"
      "base.airbase",  "3Layer"
      "base.buoy",     "3Layer"
      "base.castle",   "3Layer"
      "base.castle2",  "3Layer"
      "extra.ruins",   "3Layer"
      "extra.transport_hub", "3Layer"
      "ts.gold",       "Single1"
      "ts.iron",       "Single1"
      "ts.tundra_game", "Single1"
      "ts.furs",       "Single1"
      "ts.coal",       "Single1"
      "ts.fish",       "Single1"
      "ts.fruit",      "Single1"
      "ts.gems",       "Single1"
      "ts.buffalo",    "Single1"
      "ts.wheat",      "Single1"
      "ts.oasis",      "Single1"
      "ts.peat",       "Single1"
      "ts.pheasant",   "Single1"
      "ts.grassland_resources", "Single1"
      "ts.arctic_ivory", "Single1"
      "ts.silk",       "Single1"
      "ts.spice",      "Single1"
      "ts.whales",     "Single1"
      "ts.wine",       "Single1"
      "ts.oil",        "Single1"
      "ts.horses",     "Single1"
      "ts.seals",      "Single1"
    }
