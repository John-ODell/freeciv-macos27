; National border masks for the Freeciv45 iso tileset, generated by tilesets/make-freeciv45iso.py (see RECORD.md); the client tints them.

[spec]

options = "+Freeciv-3.2-spec"

[info]

artists = "
    John O'Dell (sheet workflow)
"

[file]
gfx = "freeciv45iso/borders"

[grid_main]

x_top_left = 0
y_top_left = 0
dx = 192
dy = 96

tiles = { "row", "column", "tag"
  0, 0, "grid.borders.n"
  0, 1, "grid.borders.s"
  0, 2, "grid.borders.w"
  0, 3, "grid.borders.e"
}

