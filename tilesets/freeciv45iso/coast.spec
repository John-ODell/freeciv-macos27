; Shore cells for the Freeciv45 iso tileset, generated by tilesets/make-freeciv45iso.py (coastline) from
; painted cells: quarter tiles of beach on both sides of a coast (layer 1) and of ice on water next
; to glacier (layer 2).
; Then turned into 96x48 isometric cells (make-freeciv45iso.py, to_iso).

[spec]

options = "+Freeciv-3.2-spec"

[info]

artists = "
    John O'Dell (sheet workflow)
"

[file]
gfx = "freeciv45iso/coast"

[grid_main]

x_top_left = 0
y_top_left = 0
dx = 96
dy = 48

