; Blend masks and the tile outline for the Freeciv45 iso tileset, generated by tilesets/make-freeciv45iso.py:
; 3 x 3 tiles each in map order, every tile a 192x96 diamond in its own rectangle, how strongly a
; terrain shows in each tile around it (fork patches 0019, 0028 and 0033).

[spec]

options = "+Freeciv-3.2-spec"

[info]

artists = "
    Generated (no artist)
"

[file]
gfx = "freeciv45iso/blend"

[grid_masks]

x_top_left = 0
y_top_left = 0
dx = 576
dy = 288

tiles = { "row", "column", "tag"
  0, 0, "t.blend_mask"
  0, 1, "t.blend_mask_2"
  0, 2, "t.blend_mask_3"
  0, 3, "t.blend_mask_4"
}

[grid_tile]

x_top_left = 0
y_top_left = 288
dx = 192
dy = 96

tiles = { "row", "column", "tag"
  0, 0, "mask.tile"
}
