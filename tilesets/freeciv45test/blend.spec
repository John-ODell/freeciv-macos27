; Blend mask for the Freeciv45 test tileset, generated by tilesets/make-freeciv45test.py (blend_mask):
; 3 x 3 tiles, how strongly a terrain shows in each tile around it. Used by blend_layer in
; overhead view (fork patch 0019).

[spec]

options = "+Freeciv-3.2-spec"

[info]

artists = "
    Generated (no artist)
"

[file]
gfx = "freeciv45test/blend"

[grid_main]

x_top_left = 0
y_top_left = 0
dx = 288
dy = 288

tiles = { "row", "column", "tag"
  0, 0, "t.blend_mask"
}
