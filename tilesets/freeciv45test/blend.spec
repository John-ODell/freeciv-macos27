; Blend masks for the Freeciv45 test tileset, generated by tilesets/make-freeciv45test.py (blend_mask):
; 3 x 3 tiles each, how strongly a terrain shows in each tile around it. Used by blend_layer in
; overhead view (fork patches 0019 and 0028).

[spec]

options = "+Freeciv-3.2-spec"

[info]

artists = "
    Generated (no artist)
"

[file]
gfx = "freeciv45test/blend"

[grid_main]

x_top_left = 0
y_top_left = 0
dx = 576
dy = 576

tiles = { "row", "column", "tag"
  0, 0, "t.blend_mask"
  0, 1, "t.blend_mask_2"
  0, 2, "t.blend_mask_3"
  0, 3, "t.blend_mask_4"
  0, 4, "t.blend_mask_same"
}
