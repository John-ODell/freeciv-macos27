@@ -825,7 +825,7 @@ plant_time           = 10
 irrigation_food_incr = 1
 irrigation_time      = 5
 mining_shield_incr   = 0
-mining_time          = 0
+mining_time          = 5
 transform_result     = "Lake"
 transform_time       = 36
 placing_time         = 2
@@ -1322,10 +1322,12 @@ reqs           =
     { "type", "name", "range", "present", "quiet"
       "TerrainClass", "Oceanic", "Tile", FALSE, TRUE
       "UnitClass", "Sea", "Local", FALSE, TRUE
+      "Terrain", "Grassland", "Tile", FALSE, TRUE
+      "Terrain", "Plains", "Tile", FALSE, TRUE
     }
 build_time     = 0
 removal_time   = 0
-conflicts      = "Irrigation", "Farmland"
+conflicts      = "Irrigation", "Farmland", "Cottage"
 hidden_by      = "Oil Well"
 helptext       = _("\
 Mines can be built on some types of terrain, which increases the \
@@ -1336,6 +1338,136 @@ production point.\
 Building a mine on an irrigated tile will destroy the irrigation.\
 ")
 
+[extra_cottage]
+name           = _("Cottage")
