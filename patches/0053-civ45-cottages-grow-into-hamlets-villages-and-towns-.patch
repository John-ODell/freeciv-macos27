+causes         = "Mine"
+rmcauses       = "Pillage"
+graphic        = "tx.cottage"
+graphic_alt    = "tx.village"
+activity_gfx   = "unit.mine"
+act_gfx_alt    = "-"
+act_gfx_alt2   = "-"
+rmact_gfx      = "None"
+rmact_gfx_alt  = "-"
+rmact_gfx_alt2 = "-"
+reqs           =
+    { "type", "name", "range", "present", "quiet"
+      "TerrainClass", "Land", "Tile", TRUE, TRUE
+      "Tech", "Pottery", "Player", TRUE, FALSE
+      "Terrain", "Hills", "Tile", FALSE, TRUE
+      "Terrain", "Mountains", "Tile", FALSE, TRUE
+      "Terrain", "Desert", "Tile", FALSE, TRUE
+      "Terrain", "Tundra", "Tile", FALSE, TRUE
+      "Terrain", "Glacier", "Tile", FALSE, TRUE
+    }
