From 414708788fabbc93a12d6ede0dd7064682c66ff4 Mon Sep 17 00:00:00 2001
From: John O'Dell <johncodell14@gmail.com>
Date: Wed, 21 Oct 2026 01:43:41 -0500
Subject: [PATCH 53/53] civ45: cottages grow into hamlets, villages and towns
 while worked

Issue 275 (notes/freeciv45/design/cottages.md). With Pottery, the
worker's mine job on grassland or plains builds a Cottage (+1 trade);
the Mine stays off those two terrains. While a city works the tile the
cottage grows, by native spontaneous appearance with a "worked"
requirement, into a Hamlet (10% a turn), a Village (5%) and a Town
(2.5%), each worth 1 more trade; Printing adds 1 to villages and towns,
Democracy 1 shield to towns. Pillage takes the top stage only. Cottages
exclude irrigation, farmland and mines.

The tileset tags are tx.cottage, tx.hamlet, tx.village_stage (the hut
has tx.village) and tx.town, each falling back to tx.village.
---
 data/civ45/effects.ruleset |  57 +++++++++++++++
 data/civ45/terrain.ruleset | 138 ++++++++++++++++++++++++++++++++++++-
 2 files changed, 192 insertions(+), 3 deletions(-)

diff --git a/data/civ45/effects.ruleset b/data/civ45/effects.ruleset
index b851410..b143a5c 100644
--- a/data/civ45/effects.ruleset
+++ b/data/civ45/effects.ruleset
@@ -6794,3 +6794,60 @@ reqs    =
     { "type", "name", "range"
       "Building", "Oasis Supply", "Player"
     }
+
+; Cottages (notes/freeciv45/design/cottages.md): each stage adds 1 trade, so 1, 2, 3 and 4 in all.
+[effect_cottage_trade]
+type    = "Output_Add_Tile"
+value   = 1
+reqs    =
+    { "type", "name", "range"
+      "Extra", "Cottage", "Tile"
+      "OutputType", "Trade", "Local"
+    }
+
+[effect_hamlet_trade]
+type    = "Output_Add_Tile"
+value   = 1
+reqs    =
+    { "type", "name", "range"
+      "Extra", "Hamlet", "Tile"
+      "OutputType", "Trade", "Local"
+    }
+
+[effect_village_trade]
+type    = "Output_Add_Tile"
+value   = 1
+reqs    =
+    { "type", "name", "range"
+      "Extra", "Village", "Tile"
+      "OutputType", "Trade", "Local"
+    }
+
+[effect_town_trade]
+type    = "Output_Add_Tile"
+value   = 1
+reqs    =
+    { "type", "name", "range"
+      "Extra", "Town", "Tile"
+      "OutputType", "Trade", "Local"
+    }
+
+[effect_village_printing]
+type    = "Output_Add_Tile"
+value   = 1
+reqs    =
+    { "type", "name", "range"
+      "Extra", "Village", "Tile"
+      "Tech", "Printing", "Player"
+      "OutputType", "Trade", "Local"
+    }
+
+[effect_town_democracy_shield]
+type    = "Output_Add_Tile"
+value   = 1
+reqs    =
+    { "type", "name", "range"
+      "Extra", "Town", "Tile"
+      "Gov", "Democracy", "Player"
+      "OutputType", "Shield", "Local"
+    }
diff --git a/data/civ45/terrain.ruleset b/data/civ45/terrain.ruleset
index 1723e78..326d507 100644
