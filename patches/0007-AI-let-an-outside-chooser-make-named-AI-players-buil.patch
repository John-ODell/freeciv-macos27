+
+#define HARNESS_MAX_OPTIONS 8
+#define HARNESS_DEFAULT_TIMEOUT 60      /* Seconds to wait for an answer */
+#define HARNESS_MAX_TIMEOUT 86400       /* A day; more is a typo */
+#define HARNESS_POLL_USEC 20000
+#define HARNESS_THREAT_RADIUS 3
+#define HARNESS_CONVERT_TURNS 5         /* Coinage turns before asking again */
+
+struct harness_option {
+  struct universal target;
+  char label[256];
+};
+
+/* The last build the chooser picked for a city, the turn it did, and the
+ * city's turn_last_built then. */
+struct harness_pick {
+  int city_id;
+  int turn;
+  int built;
+  struct universal target;
+};
+
+/* A research when the chooser last picked for it: a player's, or a team's
+ * when the team pools its research. */
+struct harness_research {
+  bool asked;
+  int techs;
+  Tech_type_id tech;
+};
+
+enum harness_reason {
+  HR_NONE,
+  HR_NEW,        /* No pick recorded for this city yet */
+  HR_FINISHED,   /* The city finished a build since the last pick */
+  HR_CHANGED,    /* Something else changed the city's build */
+  HR_DANGER,     /* The city is in danger */
+  HR_CONVERTING  /* The city has been on Coinage for a while */
+};
+
+static struct {
+  bool loaded;
+  bool active;
+  bool names_checked;
+  char dir[MAX_LEN_PATH];
+  char names[MAX_NUM_PLAYER_SLOTS][MAX_LEN_NAME];
+  int name_count;
+  int timeout;
+  int next_id;
+  struct harness_pick *picks;
+  int pick_count;
+  int pick_alloc;
+  /* By research_number(), so teammates who pool research share one. */
+  struct harness_research research[MAX(MAX_NUM_PLAYER_SLOTS,
+                                       MAX_NUM_TEAM_SLOTS)];
+} harness;
+
+/**********************************************************************//**
+  Full path of a file in the harness directory.
+**************************************************************************/
+static void harness_path(char *buf, size_t size, const char *name)
+{
+  fc_snprintf(buf, size, "%s/%s", harness.dir, name);
+}
+
+/**********************************************************************//**
+  Read the settings from the environment, once.
+**************************************************************************/
+static void harness_load(void)
+{
+  const char *dir, *names, *timeout, *p;
+  char path[MAX_LEN_PATH];
+  FILE *f;
+
+  if (harness.loaded) {
+    return;
+  }
+  harness.loaded = TRUE;
+  harness.timeout = HARNESS_DEFAULT_TIMEOUT;
+  harness.next_id = 1;
+
+  dir = getenv("FREECIV_HARNESS_DIR");
+  if (dir == NULL || dir[0] == '\0') {
+    return;
+  }
+  names = getenv("FREECIV_HARNESS_PLAYERS");
+  if (names == NULL || names[0] == '\0') {
+    log_error("harness: FREECIV_HARNESS_DIR is set but FREECIV_HARNESS_PLAYERS "
+              "is not, so the hook stays off.");
+    return;
+  }
+  timeout = getenv("FREECIV_HARNESS_TIMEOUT");
+  if (timeout != NULL && timeout[0] != '\0') {
+    char *end;
+    long secs;
+
+    /* A plain number of seconds, 0 to a day. atoi() would read "abc", "-5"
+     * or "2147483648" as 0, which is "never wait": every question would
+     * then fall back to the AI's pick and the game would look healthy. */
+    errno = 0;
+    secs = strtol(timeout, &end, 10);
+    if (end == timeout || *end != '\0' || errno != 0
+        || secs < 0 || secs > HARNESS_MAX_TIMEOUT) {
+      log_error("harness: FREECIV_HARNESS_TIMEOUT '%s' isn't a number of "
+                "seconds, so the hook stays off.", timeout);
+      return;
+    }
+    harness.timeout = (int) secs;
+  }
+  fc_strlcpy(harness.dir, dir, sizeof(harness.dir));
+
+  /* Player names, separated by commas. */
+  p = names;
+  while (*p != '\0' && harness.name_count < MAX_NUM_PLAYER_SLOTS) {
+    const char *end = strchr(p, ',');
+    size_t len = (end != NULL) ? (size_t) (end - p) : strlen(p);
+    char name[MAX_LEN_NAME];
+
+    fc_strlcpy(name, p, MIN(len + 1, sizeof(name)));
+    remove_leading_trailing_spaces(name);
+    if (name[0] != '\0') {
+      fc_strlcpy(harness.names[harness.name_count++], name, MAX_LEN_NAME);
+    }
+    if (end == NULL) {
+      break;
+    }
+    p = end + 1;
+  }
+  if (harness.name_count == 0) {
+    log_error("harness: FREECIV_HARNESS_PLAYERS names no player, so the hook "
+              "stays off.");
+    return;
+  }
+
+  /* Leftovers from an earlier run would be read as this run's files. */
+  harness_path(path, sizeof(path), "question.json");
+  fc_remove(path);
+  harness_path(path, sizeof(path), "answer.txt");
+  fc_remove(path);
+
+  /* One server run per record: ids start at 1 again in each run. */
+  harness_path(path, sizeof(path), "applied.jsonl");
+  f = fc_fopen(path, "w");
+  if (f == NULL) {
+    log_error("harness: can't write in %s, so the hook stays off.",
+              harness.dir);
+    return;
+  }
+  fclose(f);
+
+  harness.active = TRUE;
+  log_normal("harness: on for %s; files in %s; an answer may take up to %d s.",
+             names, harness.dir, harness.timeout);
+}
+
+/**********************************************************************//**
+  Say once if a listed name isn't an AI player of this game.
+**************************************************************************/
+static void harness_check_names(void)
+{
+  int i;
+
+  if (harness.names_checked) {
+    return;
+  }
+  harness.names_checked = TRUE;
+
+  for (i = 0; i < harness.name_count; i++) {
+    struct player *pplayer = player_by_name(harness.names[i]);
+
+    if (pplayer == NULL) {
+      log_error("harness: there is no player named %s.", harness.names[i]);
+    } else if (!is_ai(pplayer)) {
+      log_error("harness: %s isn't AI-controlled, so it isn't asked.",
+                harness.names[i]);
+    }
+  }
+}
+
+/**********************************************************************//**
+  Whether the chooser makes this AI player's build and research choices.
+**************************************************************************/
+bool dai_harness_player(const struct player *pplayer)
+{
+  int i;
+
+  harness_load();
+  if (!harness.active || pplayer == NULL || !is_ai(pplayer)) {
+    return FALSE;
+  }
+  harness_check_names();
+
+  for (i = 0; i < harness.name_count; i++) {
+    if (fc_strcasecmp(harness.names[i], player_name(pplayer)) == 0) {
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+/**********************************************************************//**
+  Append s to out as a JSON string.
+**************************************************************************/
+static void harness_json_string(struct astring *out, const char *s)
+{
+  const char *run = s, *c;
+
+  /* Copy the text between escapes in runs: astr_add() checks that what it
+   * adds is UTF-8, so a byte at a time would drop every non-ASCII letter. */
+  astr_add(out, "\"");
+  for (c = s; *c != '\0'; c++) {
+    unsigned char ch = (unsigned char) *c;
+    char esc[8];
+
+    switch (ch) {
+    case '"':
+      fc_strlcpy(esc, "\\\"", sizeof(esc));
+      break;
+    case '\\':
+      fc_strlcpy(esc, "\\\\", sizeof(esc));
+      break;
+    case '\n':
+      fc_strlcpy(esc, "\\n", sizeof(esc));
+      break;
+    case '\r':
+      fc_strlcpy(esc, "\\r", sizeof(esc));
+      break;
+    case '\t':
+      fc_strlcpy(esc, "\\t", sizeof(esc));
+      break;
+    default:
+      if (ch >= 0x20) {
+        continue;
+      }
+      fc_snprintf(esc, sizeof(esc), "\\u%04x", ch);
+    }
+    astr_add(out, "%.*s%s", (int) (c - run), run, esc);
+    run = c + 1;
+  }
+  astr_add(out, "%s\"", run);
+}
+
+/**********************************************************************//**
+  "3 turns", or what to say when it never finishes.
+**************************************************************************/
+static void harness_turns_text(char *buf, size_t size, int turns)
+{
+  if (turns >= FC_INFINITY) {
+    fc_strlcpy(buf, "never at this rate", size);
+  } else {
+    fc_snprintf(buf, size, "%d %s", turns, turns == 1 ? "turn" : "turns");
+  }
+}
+
+/**********************************************************************//**
+  Enemy units that can attack, seen within a few tiles of the city.
+**************************************************************************/
+static int harness_threats(const struct player *pplayer,
+                           const struct city *pcity)
+{
+  const struct civ_map *nmap = &(wld.map);
+  int count = 0;
+
+  square_iterate(nmap, city_tile(pcity), HARNESS_THREAT_RADIUS, ptile) {
+    unit_list_iterate(ptile->units, punit) {
+      const struct player *owner = unit_owner(punit);
+
+      if (owner != pplayer && pplayers_at_war(pplayer, owner)
+          && unit_type_get(punit)->attack_strength > 0
+          && can_player_see_unit(pplayer, punit)) {
+        count++;
+      }
+    } unit_list_iterate_end;
+  } square_iterate_end;
+
+  return count;
+}
+
+/**********************************************************************//**
+  Whether the city's shields go into a convert build such as Coinage,
+  which never finishes.
+**************************************************************************/
+static bool harness_converting(const struct city *pcity)
+{
+  return (pcity->production.kind == VUT_IMPROVEMENT
+          && is_convert_improvement(pcity->production.value.building));
+}
+
+/**********************************************************************//**
+  The status page sent with every question.
+**************************************************************************/
+static void harness_status(struct astring *out, struct player *pplayer)
+{
+  const struct research *presearch = research_get(pplayer);
+  int counts[U_LAST];
+  int rivals = 0;
+  bool first = TRUE;
+
+  astr_add(out, "Turn %d (%s). You are %s, leader of the %s; government: "
+           "%s.\n", game.info.turn, calendar_text(), player_name(pplayer),
+           nation_plural_for_player(pplayer),
+           government_name_for_player(pplayer));
+  astr_add(out, "Gold %d (%+d a turn). Rates: tax %d%%, luxury %d%%, "
+           "science %d%%. Score %d.\n", pplayer->economic.gold,
+           player_get_expected_income(pplayer), pplayer->economic.tax,
+           pplayer->economic.luxury, pplayer->economic.science,
+           pplayer->score.game);
+  if (valid_advance_by_number(presearch->researching) != NULL) {
+    astr_add(out, "Research: %s, %d of %d bulbs; %d bulbs last turn. "
+             "%d techs known.\n",
+             research_advance_name_translation(presearch,
+                                               presearch->researching),
+             presearch->bulbs_researched,
+             research_total_bulbs_required(presearch, presearch->researching,
+                                           FALSE),
+             pplayer->server.bulbs_last_turn, presearch->techs_researched);
+  } else {
+    astr_add(out, "Research: nothing chosen; %d bulbs last turn. "
+             "%d techs known.\n", pplayer->server.bulbs_last_turn,
+             presearch->techs_researched);
+  }
+
+  astr_add(out, "\nCities (%d):\n", city_list_size(pplayer->cities));
+  city_list_iterate(pplayer->cities, pcity) {
+    char prod[128], when[32], building[256];
+    int enemies = harness_threats(pplayer, pcity);
+
+    universal_name_translation(&pcity->production, prod, sizeof(prod));
+    if (harness_converting(pcity)) {
+      fc_snprintf(building, sizeof(building),
+                  "shields go into %s, so nothing is built", prod);
+    } else {
+      harness_turns_text(when, sizeof(when),
+                         city_production_turns_to_build(pcity, TRUE));
+      fc_snprintf(building, sizeof(building),
+                  "building %s, %d of %d shields (%s)", prod,
+                  pcity->shield_stock,
+                  city_production_build_shield_cost(pcity), when);
+    }
+    astr_add(out, "- %s, size %d: food %+d, shields %+d, trade %+d; "
+             "%s; %d happy, %d content, %d unhappy, %d angry; "
+             "%d units here",
+             city_name_get(pcity), city_size_get(pcity),
+             pcity->surplus[O_FOOD], pcity->surplus[O_SHIELD],
+             pcity->surplus[O_TRADE], building,
+             pcity->feel[CITIZEN_HAPPY][FEELING_FINAL],
+             pcity->feel[CITIZEN_CONTENT][FEELING_FINAL],
+             pcity->feel[CITIZEN_UNHAPPY][FEELING_FINAL],
+             pcity->feel[CITIZEN_ANGRY][FEELING_FINAL],
+             unit_list_size(city_tile(pcity)->units));
+    if (enemies > 0) {
+      astr_add(out, "; %d enemy %s within %d tiles", enemies,
+               enemies == 1 ? "unit" : "units", HARNESS_THREAT_RADIUS);
+    }
+    astr_add(out, ".\n");
+  } city_list_iterate_end;
+
+  memset(counts, 0, sizeof(counts));
+  unit_list_iterate(pplayer->units, punit) {
+    counts[utype_index(unit_type_get(punit))]++;
+  } unit_list_iterate_end;
+  astr_add(out, "\nUnits (%d):", unit_list_size(pplayer->units));
+  unit_type_iterate(ptype) {
+    if (counts[utype_index(ptype)] > 0) {
+      astr_add(out, "%s %s %d", first ? "" : ",",
+               utype_name_translation(ptype), counts[utype_index(ptype)]);
+      first = FALSE;
+    }
+  } unit_type_iterate_end;
+  astr_add(out, "%s\n", first ? " none." : ".");
+
+  astr_add(out, "\nOther players:\n");
+  players_iterate_alive(aplayer) {
+    if (aplayer == pplayer || is_barbarian(aplayer)) {
+      continue;
+    }
+    astr_add(out, "- %s of the %s: %s.\n", player_name(aplayer),
+             nation_plural_for_player(aplayer),
+             diplstate_type_translated_name(
+               player_diplstate_get(pplayer, aplayer)->type));
+    rivals++;
+  } players_iterate_alive_end;
+  if (rivals == 0) {
+    astr_add(out, "- none.\n");
+  }
+}
