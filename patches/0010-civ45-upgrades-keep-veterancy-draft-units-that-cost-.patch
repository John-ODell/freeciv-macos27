From c499bd2940f057d6afbd9d638f79415b52c3da9e Mon Sep 17 00:00:00 2001
From: John O'Dell <johncodell14@gmail.com>
Date: Sat, 17 Oct 2026 16:22:17 -0500
Subject: [PATCH] civ45: upgrades keep veterancy, draft units that cost a
 citizen, the levy as a whip

Freeciv45 slice 3. game.ruleset: upgrade_veteran_loss and
autoupgrade_veteran_loss 0, so an upgraded unit keeps its levels.
units.ruleset: a Draft user flag and three draft units, Levy (Bronze
Working, 2/2, 10 shields), Militia (Gunpowder, 8/8, 20) and Conscripts
(Conscription, 14/14, 25), each with pop_cost 1 and not buildable under
Anarchy, Republic, Democracy or Federation. effects.ruleset: three
Unit_Shield_Value_Pct rows so that any of them disbanded in a city with
"Disband Unit Recover" puts 30 shields into the build, which stands in
for the whip until Lua can shrink a city. README.civ45 says so.
---
 data/civ45/README.civ45    |   8 +++
 data/civ45/effects.ruleset |  33 +++++++++
 data/civ45/game.ruleset    |   4 +-
 data/civ45/units.ruleset   | 139 +++++++++++++++++++++++++++++++++++++
 4 files changed, 182 insertions(+), 2 deletions(-)

diff --git a/data/civ45/README.civ45 b/data/civ45/README.civ45
index 571c17f..97d9d37 100644
--- a/data/civ45/README.civ45
+++ b/data/civ45/README.civ45
@@ -53,6 +53,14 @@ Differences from sandbox
   2050) and at the start of that turn the living player with the highest
   score is named the winner, so the game ends with a victor rather than a
   turn-limit notice. The thresholds are first values, untuned.
+- Upgrades keep a unit's veteran levels (sandbox takes one away).
+- Drafting: Levy (Bronze Working, 2/2, 10 shields), Militia (Gunpowder,
+  8/8, 20 shields) and Conscripts (Conscription, 14/14, 25 shields) are
+  raised from one of the city's citizens (pop_cost 1), only under Tribal,
+  Despotism, Monarchy, Communism or Fundamentalism. They stand in for
+  the whip too: disbanded in a city ("Disband recovering production")
+  each puts 30 shields into the build, whatever it cost, so a citizen
+  becomes 30 shields. No unhappiness follows a draft yet.
 - Strategic resources: Legion needs Iron and Armor needs Oil somewhere in
   the city's radius.
 - Nation-unique units and buildings: Aztec Jaguar Warrior (replaces
diff --git a/data/civ45/effects.ruleset b/data/civ45/effects.ruleset
index cf449a3..bbd97a2 100644
--- a/data/civ45/effects.ruleset
+++ b/data/civ45/effects.ruleset
@@ -5455,6 +5455,39 @@ reqs    =
       "Action", "Disband Unit Recover", "Local", TRUE
     }
 
+; A draft unit disbanded in a city is worth 30 shields to the build (the recycle
+; effect above halves the base; this row brings a Levy to 30).
+[effect_unit_shield_value_draft_levy]
+type    = "Unit_Shield_Value_Pct"
+value   = 250
+reqs    =
+    { "type",     "name",                 "range", "present"
+      "Action",   "Disband Unit Recover", "Local", TRUE
+      "UnitType", "Levy", "Local", TRUE
+    }
+
+; A draft unit disbanded in a city is worth 30 shields to the build (the recycle
+; effect above halves the base; this row brings a Militia to 30).
+[effect_unit_shield_value_draft_militia]
+type    = "Unit_Shield_Value_Pct"
+value   = 100
+reqs    =
+    { "type",     "name",                 "range", "present"
+      "Action",   "Disband Unit Recover", "Local", TRUE
+      "UnitType", "Militia", "Local", TRUE
+    }
+
+; A draft unit disbanded in a city is worth 30 shields to the build (the recycle
+; effect above halves the base; this row brings a Conscripts to 30).
+[effect_unit_shield_value_draft_conscripts]
+type    = "Unit_Shield_Value_Pct"
+value   = 70
+reqs    =
+    { "type",     "name",                 "range", "present"
+      "Action",   "Disband Unit Recover", "Local", TRUE
+      "UnitType", "Conscripts", "Local", TRUE
+    }
+
 [effect_unit_shield_value_in_upgrade_price_calc]
 type    = "Unit_Shield_Value_Pct"
 value   = -50
diff --git a/data/civ45/game.ruleset b/data/civ45/game.ruleset
index 9541728..c922e51 100644
--- a/data/civ45/game.ruleset
+++ b/data/civ45/game.ruleset
@@ -129,10 +129,10 @@ base_bribe_cost  = 750
 ransom_gold      = 100
 
 ; Number of veteran levels lost when upgrading a unit
-upgrade_veteran_loss     = 1
+upgrade_veteran_loss     = 0
 
 ; Number of veteran levels lost when auto-upgrading a unit
-autoupgrade_veteran_loss = 1
+autoupgrade_veteran_loss = 0
 
 ; Whether player gets to select which terrain improvement to pillage.
 pillage_select           = TRUE
diff --git a/data/civ45/units.ruleset b/data/civ45/units.ruleset
index 3f591f4..2dd46d8 100644
--- a/data/civ45/units.ruleset
+++ b/data/civ45/units.ruleset
@@ -53,6 +53,7 @@ flags =
     _("OneAttack")
     _("Collateral"), _("Its bombardment wounds every unit on a tile that holds two or more units, and kills none of them.")
     _("Withdraws"), _("When it attacks, it breaks off after 12 rounds for every 10 hit points it has, instead of fighting to the death.")
+    _("Draft"), _("Raised from one of the city's citizens instead of built from shields alone, and only under Tribal, Despotism, Monarchy, Communism or Fundamentalism. Disbanded in a city, it puts 30 shields into whatever the city is building.")
   }
 
 ; Names for custom unit class flags. There can be up to 25 of these.
@@ -1177,6 +1178,144 @@ Fundamentalist nations can maintain Fanatic units without\
  Instead, each unit reduces the population by 1.\
 ")
 
