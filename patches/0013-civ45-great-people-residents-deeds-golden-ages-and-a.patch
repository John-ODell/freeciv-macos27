diff --git a/data/civ45/script.lua b/data/civ45/script.lua
index 172a234..d7e5742 100644
--- a/data/civ45/script.lua
+++ b/data/civ45/script.lua
@@ -630,3 +630,311 @@ function fc45_victory_turn_begin(turn, year)
   fc45_score_winner(turn, year)
 end
 signal.connect("turn_begin", "fc45_victory_turn_begin")
+
+
+-- Freeciv45 great people and golden ages (notes/freeciv45/design/great-people.md). Every city collects
+-- great-person points each turn (User_Effect_3 of its buildings, times 1 + User_Effect_4 / 100, which a
+-- golden age sets to 100); at FC45_GP_BASE + FC45_GP_STEP per great person the player already had, one is
+-- born of a kind drawn in proportion to the city's sources. A great person settles ("Join City" founds the
+-- Resident building of its kind), does its deed once ("User Action 3") or pledges a golden age ("User Action
+-- 4"); the first player to Philosophy, Theology, Economics or Electricity gets one free. The AI never picks
+-- these actions, so fc45_gp_ai() spends its great people through the same enablers each turn. Every counter
+-- is a scalar global named by a city, player or unit id, so it survives a save (only scalars do).
+FC45_GP_BASE = 150
+FC45_GP_STEP = 75
+FC45_GOLDEN_TURNS = 10
+
+-- Building rule name -> kind, points a turn. Must match the User_Effect_3 rows in effects.ruleset
+-- (scripts/gp-points-check.py diffs them).
+fc45_gp_sources = {
+  ["Temple"] = { "Oracle", 1 },
+  ["Library"] = { "Sage", 1 },
+  ["Marketplace"] = { "Magnate", 1 },
+  ["Colosseum"] = { "Virtuoso", 1 },
+  ["Courthouse"] = { "Spymaster", 1 },
+  ["University"] = { "Sage", 2 },
+  ["Bank"] = { "Magnate", 2 },
+  ["Cathedral"] = { "Oracle", 2 },
+  ["Factory"] = { "Builder", 2 },
+  ["Police Station"] = { "Spymaster", 2 },
+  ["Research Lab"] = { "Sage", 3 },
+  ["Stock Exchange"] = { "Magnate", 3 },
+  ["Mfg. Plant"] = { "Builder", 3 },
+  ["Great Library"] = { "Sage", 2 },
+  ["Copernicus' Observatory"] = { "Sage", 2 },
+  ["Isaac Newton's College"] = { "Sage", 2 },
+  ["Darwin's Voyage"] = { "Sage", 2 },
+  ["Internet"] = { "Sage", 2 },
+  ["Pyramids"] = { "Builder", 2 },
+  ["Great Wall"] = { "Builder", 2 },
+  ["King Richard's Crusade"] = { "Builder", 2 },
+  ["Leonardo's Workshop"] = { "Builder", 2 },
+  ["Hoover Dam"] = { "Builder", 2 },
+  ["Apollo Program"] = { "Builder", 2 },
+  ["Manhattan Project"] = { "Builder", 2 },
+  ["Colossus"] = { "Magnate", 2 },
+  ["Marco Polo's Embassy"] = { "Magnate", 2 },
+  ["A.Smith's Trading Co."] = { "Magnate", 2 },
+  ["Magellan's Expedition"] = { "Magnate", 2 },
+  ["Shakespeare's Theatre"] = { "Virtuoso", 2 },
+  ["Mausoleum of Mausolos"] = { "Virtuoso", 2 },
+  ["Eiffel Tower"] = { "Virtuoso", 2 },
+  ["Guidestones"] = { "Virtuoso", 2 },
+  ["Temple of Artemis"] = { "Oracle", 2 },
+  ["Michelangelo's Chapel"] = { "Oracle", 2 },
+  ["J.S. Bach's Cathedral"] = { "Oracle", 2 },
+  ["Altar to The Divine Ruler"] = { "Oracle", 2 },
+  ["Statue of Zeus"] = { "Commander", 2 },
+  ["Sun Tzu's War Academy"] = { "Commander", 2 },
+  ["Statue of Liberty"] = { "Spymaster", 2 },
+  ["Women's Suffrage"] = { "Spymaster", 2 },
+  ["United Nations"] = { "Spymaster", 2 },
+  ["Resident Sage"] = { "Sage", 2 },
+  ["Resident Builder"] = { "Builder", 2 },
+  ["Resident Magnate"] = { "Magnate", 2 },
+  ["Resident Virtuoso"] = { "Virtuoso", 2 },
+  ["Resident Oracle"] = { "Oracle", 2 },
+  ["Resident Commander"] = { "Commander", 2 },
+  ["Resident Spymaster"] = { "Spymaster", 2 },
+}
+
+fc45_gp_kind_of_unit = { ["Great Sage"] = "Sage", ["Great Builder"] = "Builder", ["Great Magnate"] = "Magnate",
+                         ["Great Virtuoso"] = "Virtuoso", ["Great Oracle"] = "Oracle",
+                         ["Great Commander"] = "Commander", ["Great Spymaster"] = "Spymaster" }
+fc45_gp_tech_gift = { ["Philosophy"] = "Sage", ["Theology"] = "Oracle", ["Economics"] = "Magnate",
+                      ["Electricity"] = "Builder" }
+
+-- Global names carry a city, player or unit id; the id is formatted as an integer, since the saved
+-- script state is Lua source and a float id would not parse back.
+function fc45_gp_key(prefix, id) return prefix .. string.format("%d", id) end
+function fc45_gp_get(name) return rawget(_G, name) or 0 end
+function fc45_gp_set(name, value) rawset(_G, name, value) end
+
+-- The city a free great person appears in: the capital, else the first city.
+function fc45_gp_home(player)
+  local home = nil
+  for c in player:cities_iterate() do
+    if home == nil or c:is_capital() then home = c end
+    if c:is_capital() then break end
+  end
+  return home
+end
+
+function fc45_gp_rate(city)
+  return effects.city_bonus(city, "User_Effect_3"), effects.city_bonus(city, "User_Effect_4")
+end
+
+-- One kind, drawn with probability equal to its share of the city's points.
+function fc45_gp_draw_kind(city)
+  local weights, total = {}, 0
+  for name, src in pairs(fc45_gp_sources) do
+    local b = find.building_type(name)
+    if b ~= nil and city:has_building(b) then
+      weights[src[1]] = (weights[src[1]] or 0) + src[2]
+      total = total + src[2]
+    end
+  end
+  if total == 0 then return "Sage" end
+  local r = random(1, total)
+  for kind, w in pairs(weights) do
+    if r <= w then return kind end
+    r = r - w
+  end
+  return "Sage"
+end
+
+function fc45_gp_birth(city, kind, why)
+  local owner = city.owner
+  local utype = find.unit_type("Great " .. kind)
+  if utype == nil then return nil end
+  local u = edit.create_unit(owner, city.tile, utype, 0, city, -1)
+  if u == nil then return nil end
+  fc45_gp_set(fc45_gp_key("fc45_gp_born_", owner.id), fc45_gp_get(fc45_gp_key("fc45_gp_born_", owner.id)) + 1)
+  fc45_gp_set(fc45_gp_key("fc45_gp_born_turn_", u.id), game.turn())
+  notify.event(owner, city.tile, E.UNIT_BUILT, _("A %s has arisen in %s."), utype:name_translation(), city.name)
+  log.normal("FC45GP turn %d born %s of %s in %s by %s unit %d", game.turn(), utype:rule_name(), owner.name, city.name, why, u.id)
+  return u
+end
+
+-- Points, births, golden age expiry and the AI's use of its great people, every turn.
+function fc45_gp_turn(turn, year)
+  local golden = find.building_type("Golden Age")
+  for p in players_iterate() do
+    if fc45_is_civ(p) then
+      local until_key = fc45_gp_key("fc45_golden_until_", p.id)
+      local until_turn = rawget(_G, until_key)
+      if until_turn ~= nil and turn >= until_turn then
+        for c in p:cities_iterate() do
+          if c:has_building(golden) then edit.remove_building(c, golden) end
+        end
+        fc45_gp_set(until_key, nil)
+        notify.event(p, nil, E.WONDER_OBSOLETE, _("Your golden age has ended."))
+        log.normal("FC45GP turn %d golden age of %s ended", turn, p.name)
+      end
+      for c in p:cities_iterate() do
+        local rate, pct = fc45_gp_rate(c)
+        if rate > 0 then
+          local key = fc45_gp_key("fc45_gp_pool_", c.id)
+          local pool = fc45_gp_get(key) + (rate * (100 + pct)) // 100
+          local need = FC45_GP_BASE + FC45_GP_STEP * fc45_gp_get(fc45_gp_key("fc45_gp_born_", p.id))
+          if pool >= need then
+            fc45_gp_set(key, 0)
+            fc45_gp_birth(c, fc45_gp_draw_kind(c), "points")
+          else
+            fc45_gp_set(key, pool)
+          end
+        end
+      end
+      if not p:is_human() then fc45_gp_ai(p, turn) end
+    end
+  end
+end
+signal.connect("turn_begin", "fc45_gp_turn")
+
+function fc45_gp_city_destroyed(city, loser, destroyer)
+  fc45_gp_set(fc45_gp_key("fc45_gp_pool_", city.id), nil)
+end
+signal.connect("city_destroyed", "fc45_gp_city_destroyed")
+
+-- Settling: "Join City" adds the citizen; the Resident building is founded here.
+function fc45_gp_join(action, actor, city)
+  if action:rule_name() ~= "Join City" then return end
+  local kind = fc45_gp_kind_of_unit[actor.utype:rule_name()]
+  if kind == nil then return end
+  local b = find.building_type("Resident " .. kind)
+  if b ~= nil and not city:has_building(b) then edit.create_building(city, b) end
+  log.normal("FC45GP turn %d settled %s of %s in %s unit %d", game.turn(), actor.utype:rule_name(), actor.owner.name, city.name, actor.id)
+end
+signal.connect("action_started_unit_city", "fc45_gp_join")
+
+-- The deeds and the pledge. Both actions consume the actor.
+function fc45_gp_deed(action, actor)
+  local name = action:rule_name()
+  if name == "User Action 4" then
+    fc45_gp_pledge(actor)
+    return
+  end
+  if name ~= "User Action 3" then return end
+  local kind = fc45_gp_kind_of_unit[actor.utype:rule_name()]
+  local owner, city = actor.owner, actor.tile:city()
+  local what = "nothing"
+  if kind == "Sage" then
+    local tech = edit.give_tech(owner, nil, 0, true, "fc45_great_sage")
+    what = tech and tech:rule_name() or "no tech"
+  elseif kind == "Magnate" and city ~= nil then
+    local gold = 100 + 30 * city.size
+    if city.owner.id ~= owner.id then gold = gold * 2 end
+    edit.change_gold(owner, gold)
+    notify.event(owner, city.tile, E.SCRIPT, _("The trade mission of your Great Magnate to %s brings %d gold."), city.name, gold)
+    what = gold .. " gold"
+  elseif kind == "Virtuoso" and city ~= nil then
+    edit.add_city_history(city, 400)
+    notify.event(owner, city.tile, E.SCRIPT, _("The masterwork of your Great Virtuoso brings %s 400 history points."), city.name)
+    what = "400 history"
+  elseif kind == "Oracle" and city ~= nil then
+    local s = find.building_type("Sanctum")
+    for c in owner:cities_iterate() do
+      if c:has_building(s) then edit.remove_building(c, s) end
+    end
+    edit.create_building(city, s)
+    notify.event(owner, city.tile, E.WONDER_BUILD, _("Your Great Oracle founds the Sanctum in %s."), city.name)
+    what = "Sanctum"
+  elseif kind == "Commander" then
+    local n = 0
+    for u in actor.tile:units_iterate() do
+      if u.id ~= actor.id and u.owner.id == owner.id and not u.utype:has_flag("NoVeteran") then
+        if u:transform(u.utype, -1) then n = n + 1 end
+      end
+    end
+    notify.event(owner, actor.tile, E.SCRIPT, _("Your Great Commander drills %d units."), n)
+    what = n .. " units drilled"
+  end
+  log.normal("FC45GP turn %d deed %s of %s in %s: %s unit %d", game.turn(), actor.utype:rule_name(), owner.name,
+             city and city.name or "the field", what, actor.id)
+end
+signal.connect("action_started_unit_self", "fc45_gp_deed")
+
+-- A pledge counts towards the next age: the first age costs one great person, the second two, and so on.
+-- The age is the "Golden Age" small wonder in the capital for FC45_GOLDEN_TURNS turns.
+function fc45_gp_pledge(actor)
+  local p = actor.owner
+  local key_pl, key_ct = fc45_gp_key("fc45_golden_pledges_", p.id), fc45_gp_key("fc45_golden_count_", p.id)
+  local pledges, need = fc45_gp_get(key_pl) + 1, 1 + fc45_gp_get(key_ct)
+  local home = fc45_gp_home(p)
+  if pledges < need or home == nil then
+    fc45_gp_set(key_pl, pledges)
+    notify.event(p, actor.tile, E.SCRIPT, _("%d of %d great people have pledged your next golden age."), pledges, need)
+    log.normal("FC45GP turn %d pledge %d of %d by %s of %s unit %d", game.turn(), pledges, need, actor.utype:rule_name(), p.name, actor.id)
+    return
+  end
+  fc45_gp_set(key_pl, 0)
+  fc45_gp_set(key_ct, need)
+  fc45_gp_set(fc45_gp_key("fc45_golden_until_", p.id), game.turn() + FC45_GOLDEN_TURNS)
+  edit.create_building(home, find.building_type("Golden Age"))
+  notify.event(p, home.tile, E.WONDER_BUILD, _("A golden age begins: %d turns of plenty."), FC45_GOLDEN_TURNS)
+  log.normal("FC45GP turn %d golden age %d of %s begins for %d turns", game.turn(), need, p.name, FC45_GOLDEN_TURNS)
+end
+
+-- The first player to research one of four techs gets a great person in the capital.
+function fc45_gp_tech(tech, player, reason)
+  local kind = fc45_gp_tech_gift[tech:rule_name()]
+  if kind == nil or reason ~= "researched" or not fc45_is_civ(player) then return end
+  local key = fc45_gp_key("fc45_gp_first_", tech.id)
+  if rawget(_G, key) ~= nil then return end
+  fc45_gp_set(key, player.id)
+  local home = fc45_gp_home(player)
+  if home ~= nil then fc45_gp_birth(home, kind, "first to " .. tech:rule_name()) end
+end
+signal.connect("tech_researched", "fc45_gp_tech")
+
+-- The AI's rule (design note section 6): pledge when enough great people are at hand and no age runs;
+-- Sage, Virtuoso and Magnate do their deed where they stand; Oracle and Commander settle where no Resident
+-- of their kind is, else deed; the Builder is left to the native AI (Help Wonder) for 10 turns and the
+-- Spymaster (diplomat actions) for 20, then they settle. A deed an enabler refuses falls through to settling.
+function fc45_gp_ai(p, turn)
+  local deed, pledge, join = find.action("User Action 3"), find.action("User Action 4"), find.action("Join City")
+  local people = {}
+  for u in p:units_iterate() do
+    if u.utype:has_flag("GreatPerson") then people[#people + 1] = u end
+  end
+  if #people == 0 then return end
+  local running = rawget(_G, fc45_gp_key("fc45_golden_until_", p.id)) ~= nil
+  local need = 1 + fc45_gp_get(fc45_gp_key("fc45_golden_count_", p.id)) - fc45_gp_get(fc45_gp_key("fc45_golden_pledges_", p.id))
+  if not running and #people >= need then
+    for i = 1, need do
+      local u = people[i]
+      local uid, uname = u.id, u.utype:rule_name()
+      if edit.perform_action(u, pledge) then
+        log.normal("FC45GP turn %d ai pledge by %s of %s unit %d", turn, uname, p.name, uid)
+      end
+    end
+    people = {}
+    for u in p:units_iterate() do
+      if u.utype:has_flag("GreatPerson") then people[#people + 1] = u end
+    end
+  end
+  for _, u in ipairs(people) do
+    local kind = fc45_gp_kind_of_unit[u.utype:rule_name()]
+    local city = u.tile:city()
+    local age = turn - fc45_gp_get(fc45_gp_key("fc45_gp_born_turn_", u.id))
+    local resident = find.building_type("Resident " .. kind)
+    local done, how = false, "deed"
+    local uid = u.id
+    if kind == "Sage" or kind == "Virtuoso" or kind == "Magnate" then
+      done = edit.perform_action(u, deed)
+    elseif kind == "Oracle" or kind == "Commander" then
+      if city ~= nil and not city:has_building(resident) then
+        done, how = edit.perform_action(u, join, city), "settle"
+      end
+      if not done then done, how = edit.perform_action(u, deed), "deed" end
+    elseif (kind == "Builder" and age >= 10) or (kind == "Spymaster" and age >= 20) then
+      if city ~= nil then done, how = edit.perform_action(u, join, city), "settle" end
+    end
+    if not done and city ~= nil and (kind == "Sage" or kind == "Virtuoso" or kind == "Magnate") then
+      done, how = edit.perform_action(u, join, city), "settle"
+    end
+    if done then
+      log.normal("FC45GP turn %d ai %s by Great %s of %s unit %d", turn, how, kind, p.name, uid)
+    end
+  end
+end
