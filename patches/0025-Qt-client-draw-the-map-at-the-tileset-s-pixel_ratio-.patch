 extern int last_center_player_city;
 extern int last_center_enemy_city;
 
+// Canvas pixels per map widget point; follows the tileset's pixel_ratio
+static qreal map_canvas_density = 1.0;
+
+/**********************************************************************//**
+  How many map canvas pixels make one point of the map widget. A tileset
+  drawn for high density screens (pixel_ratio 2: 192 px tiles meant as
+  96 point tiles) gets a canvas with that many pixels per point, so on a
+  Retina screen every tileset pixel lands on its own screen pixel.
+**************************************************************************/
+qreal map_density(void)
+{
+  return map_canvas_density;
+}
+
+/**********************************************************************//**
+  The map widget is width x height points: resize the map canvas to match,
+  at the current tileset's density.
+**************************************************************************/
+void qt_map_canvas_resized(int width, int height)
+{
+  map_canvas_density = (tileset != nullptr
+                        ? tileset_pixel_ratio(tileset) : 1.0);
+  map_canvas_resized(qRound(width * map_canvas_density),
+                     qRound(height * map_canvas_density));
+}
+
+/**********************************************************************//**
+  A point of the map widget in map canvas pixels.
+**************************************************************************/
+QPoint map_canvas_pos(const QPoint &widget_pos)
+{
+  return QPoint(qRound(widget_pos.x() * map_canvas_density),
+                qRound(widget_pos.y() * map_canvas_density));
+}
+
+/**********************************************************************//**
+  The map canvas size in map widget points.
+**************************************************************************/
+int map_widget_width(void)
+{
+  return qRound(mapview.width / map_canvas_density);
+}
+
+int map_widget_height(void)
+{
+  return qRound(mapview.height / map_canvas_density);
+}
+
 /**********************************************************************//**
   Check if point x, y is in area (px -> pxe, py - pye)
 **************************************************************************/
@@ -292,9 +340,23 @@ void map_view::paintEvent(QPaintEvent *event)
 **************************************************************************/
 void map_view::paint(QPainter *painter, QPaintEvent *event)
 {
-  painter->drawPixmap(event->rect(), mapview.store->map_pixmap,
-                      event->rect());
+  const qreal d = map_canvas_density;
+  QRectF r(event->rect());
+
+  if (d == 1.0) {
+    painter->drawPixmap(event->rect(), mapview.store->map_pixmap,
+                        event->rect());
+  } else {
+    // One canvas pixel per device pixel when d equals the screen's ratio
+    painter->setRenderHint(QPainter::SmoothPixmapTransform);
+    painter->drawPixmap(r, mapview.store->map_pixmap,
+                        QRectF(r.x() * d, r.y() * d,
+                               r.width() * d, r.height() * d));
+  }
+  painter->save();
+  painter->scale(1.0 / d, 1.0 / d);
   draw_calculated_trade_routes(painter);
+  painter->restore();
 }
 
