diff --git a/client/gui-qt/canvas.cpp b/client/gui-qt/canvas.cpp
index d731e89..85bd9cb 100644
--- a/client/gui-qt/canvas.cpp
+++ b/client/gui-qt/canvas.cpp
@@ -25,11 +25,31 @@
 #include "colors.h"
 #include "fc_client.h"
 #include "fonts.h"
+#include "mapview.h"
 #include "qtg_cxxside.h"
 #include "sprite.h"
 
 static QFont *get_font(enum client_font font);
 
+/************************************************************************//**
+  The font drawn at the given density: a canvas with two pixels per point
+  needs twice the pixels for the same text size on screen.
+****************************************************************************/
+static QFont font_at_density(const QFont &font, qreal density)
+{
+  QFont f(font);
+
+  if (density != 1.0) {
+    if (f.pixelSize() > 0) {
+      f.setPixelSize(qRound(f.pixelSize() * density));
+    } else {
+      f.setPointSizeF(f.pointSizeF() * density);
+    }
+  }
+
+  return f;
+}
+
 /************************************************************************//**
   Create a canvas of the given size.
 ****************************************************************************/
@@ -71,6 +91,7 @@ bool qtg_has_zoom_support()
 ****************************************************************************/
 void qtg_canvas_mapview_init(struct canvas *store)
 {
+  store->density = map_density();
 }
 
