   QFontMetrics *fm;
 
   afont = get_font(font);
-  fm = new QFontMetrics(*afont);
+  if (font == FONT_CITY_NAME || font == FONT_CITY_PROD) {
+    // Map text, measured at the map canvas density
+    fm = new QFontMetrics(font_at_density(*afont, map_density()));
+  } else {
+    fm = new QFontMetrics(*afont);
+  }
   if (width) {
     *width = fm->horizontalAdvance(QString::fromUtf8(text));
   }
@@ -361,13 +389,16 @@ void qtg_canvas_put_text(struct canvas *pcanvas, int canvas_x, int canvas_y,
   QColor color(pcolor->qcolor);
   QFontMetrics *fm;
 
+  QFont dfont;
+
   afont = get_font(font);
+  dfont = font_at_density(*afont, pcanvas->density);
   pen.setColor(color);
-  fm = new QFontMetrics(*afont);
+  fm = new QFontMetrics(dfont);
 
   p.begin(&pcanvas->map_pixmap);
   p.setPen(pen);
-  p.setFont(*afont);
+  p.setFont(dfont);
   p.drawText(canvas_x, canvas_y + fm->ascent(), QString::fromUtf8(text));
