@@ -467,30 +467,82 @@ _("\
 ;
 ; */ <-- avoid gettext warnings
 
-[multiplier_personal_freedom]
-name      = _("Personal Freedom")
+; Civics (notes/freeciv45/design/civics.md, option A): four sliders of four steps.
+; factor = 50 halves every effect value, so "per two steps" effects use value 1
+; and percentage effects carry twice their per-step value.
+
