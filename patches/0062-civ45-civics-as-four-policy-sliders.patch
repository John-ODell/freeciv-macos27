+stop      = 4
+step      = 1
+default   = 0
+factor    = 50
+reqs      =
+    { "type", "name", "range"
+      "Tech", "Currency", "Player"
+    }
+; /* xgettext:no-c-format */
+helptext  = _("\
+From open trade (0) to guarded trade (4). Each step cuts the shields \
+and trade lost to waste and corruption by 5%, and takes 5% from the \
+gold of every city.\
+")
+
+[multiplier_faith]
+name      = _("Faith")
 start     = 0
-stop      = 5
+stop      = 4
 step      = 1
 default   = 0
+factor    = 50
+reqs      =
+    { "type", "name", "range"
+      "Tech", "Mysticism", "Player"
+    }
 ; /* xgettext:no-c-format */
 helptext  = _("\
-Each step of personal freedom you allow your citizens yields a 10% \
-increase in science output, but makes an additional citizen unhappy \
-for every aggressively deployed military unit.\
+From secular (0) to devout (4). Every two steps make one more citizen \
+content in each city that follows your state faith; each step takes \
+5% from the science of every city.\
 ")
 
