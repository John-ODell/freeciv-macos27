+{
+  Q_OBJECT
+public:
+  edge_button(const QString &icon, const QString &tip, QWidget *parent);
+};
+
+/****************************************************************************
+  The right-edge column: round buttons for the overviews (panels.md 8.2)
+****************************************************************************/
