+  the year and turn, and End turn (panels.md section 8.1)
+****************************************************************************/
+class top_strip : public QFrame
+{
+  Q_OBJECT
+public:
+  top_strip(QWidget *parent);
+  void refresh();
+  void set_turn_done_enabled(bool enabled);
+  void set_turn_done_attention(bool attention);
+private:
+  QToolButton *add_number(const QString &icon, void (*click)(bool));
+  QToolButton *research_btn;
+  QToolButton *gold_btn;
+  QToolButton *rates_btn;
+  QToolButton *culture_btn;
+  QToolButton *turn_btn;
+  QPushButton *end_turn_btn;
+};
+
+/****************************************************************************
+  One round button on the right-edge column
+****************************************************************************/
