+// Logical sizes at 1x (panels.md section 8.5); the same at 2x.
+static const int STRIP_HEIGHT = 32;
+static const int STRIP_ICON = 18;
+static const int COLUMN_WIDTH = 64;
+static const int BUTTON_SIZE = 44;
+static const int BUTTON_ICON = 38;
+
+/************************************************************************//**
+  A number with its sign, for per-turn changes
+****************************************************************************/
+static QString signed_number(int n)
+{
+  return (n >= 0 ? "+" : "") + QString::number(n);
+}
+
+/************************************************************************//**
+  Restyle a widget after one of its stylesheet properties changed
+****************************************************************************/
+static void set_attention(QWidget *w, bool attention)
+{
+  if (w->property("attention").toBool() == attention) {
+    return;
+  }
+  w->setProperty("attention", attention);
+  w->style()->unpolish(w);
+  w->style()->polish(w);
+}
+
+/************************************************************************//**
+  The player's own bulbs per turn, as the client's science text counts them
+****************************************************************************/
+static int own_bulbs_per_turn(struct player *pplayer)
+{
+  int bulbs = 0;
+
+  city_list_iterate(pplayer->cities, pcity) {
+    bulbs += pcity->surplus[O_SCIENCE];
+  } city_list_iterate_end;
+
+  return bulbs - pplayer->client.tech_upkeep;
+}
+
+/************************************************************************//**
+  The culture the player gains this turn: the nation's history and every
+  city's, as the server adds them at turn change
+****************************************************************************/
+static int culture_per_turn(struct player *pplayer)
+{
+  int gain = nation_history_gain(pplayer);
+
+  city_list_iterate(pplayer->cities, pcity) {
+    gain += city_history_gain(pcity);
+  } city_list_iterate_end;
+
+  return gain;
+}
+
+/************************************************************************//**
+  Return to the map from a report tab; the strip's turn and the column's
+  Map button
+****************************************************************************/
+static void show_map(bool nothing)
+{
+  side_show_map(nothing);
+}
+
+/************************************************************************//**
+  Open the rates dialog
+****************************************************************************/
+static void open_rates(bool nothing)
+{
+  side_rates_wdg(nothing);
+}
+
+/************************************************************************//**
+  End the turn
+****************************************************************************/
+static void end_turn(bool nothing)
+{
+  side_finish_turn(nothing);
+}
+
+/************************************************************************//**
+  The strip: left to right research, gold, rates, culture; at the right end
+  the year and turn and End turn.
+****************************************************************************/
+top_strip::top_strip(QWidget *parent) : QFrame(parent)
+{
+  QHBoxLayout *row = new QHBoxLayout(this);
+
+  setObjectName("top_strip");
+  row->setContentsMargins(8, 0, 8, 0);
+  row->setSpacing(6);
+  setFixedHeight(STRIP_HEIGHT);
+
+  research_btn = add_number("research", side_left_click_science);
+  gold_btn = add_number("economy", economy_report_dialog_popup);
+  rates_btn = add_number(QString(), open_rates);
+  culture_btn = add_number(QString(), popup_players_dialog);
+  row->addStretch(1);
+  turn_btn = add_number(QString(), show_map);
+
+  // TRANS: the Freeciv45 top strip's end turn button
+  end_turn_btn = new QPushButton(QString(_("End turn")), this);
+  end_turn_btn->setToolTip(QString(_("End the turn (Shift+Return)")));
+  end_turn_btn->setFocusPolicy(Qt::NoFocus);
+  end_turn_btn->setCursor(Qt::PointingHandCursor);
+  connect(end_turn_btn, &QPushButton::clicked, this, [=]() {
+    end_turn(true);
+  });
+  row->addWidget(end_turn_btn);
+}
+
+/************************************************************************//**
+  One number of the strip: a flat button that runs click when pressed
+****************************************************************************/
+QToolButton *top_strip::add_number(const QString &icon,
+                                   void (*click)(bool))
+{
+  QToolButton *btn = new QToolButton(this);
+
+  if (!icon.isEmpty()) {
+    btn->setIcon(fc_icons::instance()->get_icon(icon));
+    btn->setIconSize(QSize(STRIP_ICON, STRIP_ICON));
+    btn->setToolButtonStyle(Qt::ToolButtonTextBesideIcon);
+  } else {
+    btn->setToolButtonStyle(Qt::ToolButtonTextOnly);
+  }
+  btn->setAutoRaise(true);
+  btn->setFocusPolicy(Qt::NoFocus);
+  btn->setCursor(Qt::PointingHandCursor);
+  connect(btn, &QToolButton::clicked, this, [=]() {
+    click(true);
+  });
+  layout()->addWidget(btn);
+
+  return btn;
+}
+
+/************************************************************************//**
+  Read the numbers again; called with the sidebar's tooltips, which follow
+  the player, research and turn packets
+****************************************************************************/
+void top_strip::refresh()
+{
+  struct player *pplayer = client_player();
+  bool playing = (pplayer != nullptr && !client_is_global_observer());
+  QString s;
+
+  research_btn->setVisible(playing);
+  gold_btn->setVisible(playing);
+  rates_btn->setVisible(playing);
+  culture_btn->setVisible(playing);
+
+  /* TRANS: the Freeciv45 top strip's year and turn, "4000 BCE  Turn 1" */
+  s = QString(_("%1  Turn %2")).arg(calendar_text(),
+                                    QString::number(game.info.turn));
+  if (current_turn_timeout() > 0) {
+    s += QString("  %1").arg(get_timeout_label_text());
+  }
+  turn_btn->setText(s);
+  turn_btn->setToolTip(QString(get_info_label_text_popup()));
+
+  if (!playing) {
+    return;
+  }
+
+  {
+    const struct research *presearch = research_get(pplayer);
+
+    if (presearch->researching == A_UNSET) {
+      // TRANS: the Freeciv45 top strip when no research is set
+      research_btn->setText(QString(_("Choose research")));
+      set_attention(research_btn, true);
+    } else {
+      research_btn->setText(QString("%1 %2  %3")
+        .arg(research_advance_name_translation(presearch,
+                                               presearch->researching),
+             signed_number(own_bulbs_per_turn(pplayer)),
+             get_science_target_text(nullptr)));
+      set_attention(research_btn, false);
+    }
+    research_btn->setToolTip(QString(science_dialog_text()));
+  }
+
+  /* TRANS: the Freeciv45 top strip's gold and income, "123 (+5)" */
+  gold_btn->setText(QString(_("%1 (%2)"))
+    .arg(QString::number(pplayer->economic.gold),
+         signed_number(player_get_expected_income(pplayer))));
+  gold_btn->setToolTip(QString(_("Gold and income per turn; opens the "
+                                 "economy report")));
+
+  /* TRANS: the Freeciv45 top strip's rates, tax, luxury and science */
+  rates_btn->setText(QString(_("Tax %1  Lux %2  Sci %3"))
+    .arg(pplayer->economic.tax).arg(pplayer->economic.luxury)
+    .arg(pplayer->economic.science));
+  rates_btn->setToolTip(QString(_("%1 - max rate: %2%; click to change"))
+    .arg(government_name_for_player(pplayer),
+         QString::number(get_player_bonus(pplayer, EFT_MAX_RATES))));
+
+  /* TRANS: the Freeciv45 top strip's culture, "Culture 120 (+3)" */
+  culture_btn->setText(QString(_("Culture %1 (%2)"))
+    .arg(QString::number(pplayer->client.culture),
+         signed_number(culture_per_turn(pplayer))));
+  culture_btn->setToolTip(QString(_("Culture and history gained per turn; "
+                                    "opens the nations report")));
+}
+
+/************************************************************************//**
+  End turn is greyed out while the turn cannot be ended
+****************************************************************************/
+void top_strip::set_turn_done_enabled(bool enabled)
+{
+  end_turn_btn->setEnabled(enabled);
+}
+
+/************************************************************************//**
+  End turn stands out when every unit has moved
+****************************************************************************/
+void top_strip::set_turn_done_attention(bool attention)
+{
+  set_attention(end_turn_btn, attention);
+}
+
+/************************************************************************//**
+  A round button; resource.qss draws the circle
+****************************************************************************/
+edge_button::edge_button(const QString &icon, const QString &tip,
+                         QWidget *parent) : QToolButton(parent)
+{
+  setIcon(fc_icons::instance()->get_icon(icon));
+  setIconSize(QSize(BUTTON_ICON, BUTTON_ICON));
+  setFixedSize(BUTTON_SIZE, BUTTON_SIZE);
+  setToolTip(tip);
+  setFocusPolicy(Qt::NoFocus);
+  setCursor(Qt::PointingHandCursor);
+}
+
+/************************************************************************//**
+  The column: Map, the five overviews, and More for the rest
+****************************************************************************/
+edge_column::edge_column(QWidget *parent) : QFrame(parent)
+{
+  QVBoxLayout *col = new QVBoxLayout(this);
+  edge_button *more;
+  QMenu *menu;
+
+  setObjectName("edge_column");
+  col->setContentsMargins(0, 10, 0, 10);
+  col->setSpacing(10);
+  col->setAlignment(Qt::AlignTop | Qt::AlignHCenter);
+  setFixedWidth(COLUMN_WIDTH);
+
+  add_button("view", QString(_("Map")), show_map);
+  add_button("research", QString(_("Research")), side_left_click_science);
+  add_button("nations", QString(_("Nations")), popup_players_dialog);
+  add_button("cities", QString(_("Cities")), city_report_dialog_popup);
+  add_button("units", QString(_("Units")), toggle_units_report);
+  add_button("economy", QString(_("Economy")), economy_report_dialog_popup);
+
+  // TRANS: the Freeciv45 right-edge button for the other overviews
+  more = new edge_button("list-add", QString(_("More overviews")),
+                         this);
+  menu = new QMenu(more);
+  menu->addAction(QString(_("Demographics")), [=]() {
+    send_report_request(REPORT_DEMOGRAPHIC);
+  });
+  menu->addAction(QString(_("Wonders of the World")), [=]() {
+    send_report_request(REPORT_WONDERS_OF_THE_WORLD_LONG);
+  });
+  menu->addAction(QString(_("Top Cities")), [=]() {
+    send_report_request(REPORT_TOP_CITIES);
+  });
+  menu->addAction(QString(_("Achievements")), [=]() {
+    send_report_request(REPORT_ACHIEVEMENTS);
+  });
+  menu->addAction(QString(_("Spaceship")), [=]() {
+    if (client_has_player()) {
+      popup_spaceship_dialog(client_player());
+    }
+  });
+  more->setMenu(menu);
+  more->setPopupMode(QToolButton::InstantPopup);
+  col->addWidget(more, 0, Qt::AlignHCenter);
+}
+
+/************************************************************************//**
+  One round button of the column
+****************************************************************************/
+edge_button *edge_column::add_button(const QString &icon,
+                                     const QString &tip,
+                                     void (*click)(bool))
+{
+  edge_button *btn = new edge_button(icon, tip, this);
+
+  connect(btn, &QToolButton::clicked, this, [=]() {
+    click(true);
+  });
+  layout()->addWidget(btn);
+  layout()->setAlignment(btn, Qt::AlignHCenter);
+
+  return btn;
+}
+
+/************************************************************************//**
+  With gui_qt_freeciv45_edges on, the strip and the column replace the
+  left sidebar; off brings the sidebar back
+****************************************************************************/
+void apply_freeciv45_edges(void)
+{
+  bool on = gui_options.gui_qt_freeciv45_edges;
+
+  if (gui()->sidebar_wdg != nullptr) {
+    gui()->sidebar_wdg->setVisible(!on);
+  }
+  if (gui()->edgecolumn_wdg != nullptr) {
+    gui()->edgecolumn_wdg->setVisible(on);
+  }
+  if (gui()->topstrip_wdg != nullptr) {
+    gui()->topstrip_wdg->setVisible(on);
+    if (on) {
+      gui()->topstrip_wdg->refresh();
+    }
+  }
+}
