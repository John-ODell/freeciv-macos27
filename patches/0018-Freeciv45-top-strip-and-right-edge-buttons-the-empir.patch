+  // set yet either, so apply_freeciv45_edges() cannot run.
+  if (gui_options.gui_qt_freeciv45_edges) {
+    sidebar_wdg->hide();
+  } else {
+    topstrip_wdg->hide();
+    edgecolumn_wdg->hide();
+  }
