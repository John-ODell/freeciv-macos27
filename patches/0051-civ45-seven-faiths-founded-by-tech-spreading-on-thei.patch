 signal.connect("city_destroyed", "fc45_unrest_city_destroyed")
+
+-- Religion (notes/freeciv45/design/religion.md). Seven faiths, founded by the first civ to learn a tech,
+-- spread on their own into cities that follow none, and a state faith picked for each civ. The record
+-- fc45_rel_<city id> (";1;4;") is the truth; the "<Faith> Faith" and "Holy City" markers mirror it and are
+-- re-created when sold, razed or lost. The content, history and Shrine effects are in effects.ruleset.
+fc45_rel_faiths = { {"Hearth", "Mysticism"}, {"Many Hands", "Polytheism"}, {"Sun Throne", "Ruler Apotheosis"},
+                    {"Quiet Way", "Philosophy"}, {"Star Path", "Astronomy"}, {"One Flame", "Monotheism"},
+                    {"Deep Well", "Theology"} }
+fc45_rel_by_tech = {}
+for n, f in ipairs(fc45_rel_faiths) do fc45_rel_by_tech[f[2]] = n end
+FC45_REL_RANGE_SQ = 100   -- spread reaches 10 tiles
+FC45_REL_CAP = 10         -- at most 10 percent a turn
+
+function fc45_rel_list(city)
+  local out = {}
+  local r = rawget(_G, fc45_gp_key("fc45_rel_", city.id))
+  if r ~= nil then
+    for n in string.gmatch(r, "(%d+)") do out[#out + 1] = tonumber(n) end
+  end
+  return out
+end
+
+function fc45_rel_has(city, n)
+  local r = rawget(_G, fc45_gp_key("fc45_rel_", city.id))
+  return r ~= nil and string.find(r, ";" .. string.format("%d", n) .. ";", 1, true) ~= nil
+end
+
+function fc45_rel_marker(n) return find.building_type(fc45_rel_faiths[n][1] .. " Faith") end
+function fc45_rel_state_marker(n) return find.building_type(fc45_rel_faiths[n][1] .. " State Faith") end
+function fc45_rel_holy(n) return rawget(_G, fc45_gp_key("fc45_rel_holy_", n)) end
+
+function fc45_rel_add(city, n, why)
+  if fc45_rel_has(city, n) then return end
+  local key = fc45_gp_key("fc45_rel_", city.id)
+  fc45_gp_set(key, (rawget(_G, key) or ";") .. string.format("%d", n) .. ";")
+  if not city:has_building(fc45_rel_marker(n)) then edit.create_building(city, fc45_rel_marker(n)) end
+  log.normal("FC45REL turn %d %s %s %s of %s", game.turn(), fc45_rel_faiths[n][1], why, city.name, city.owner.name)
+end
+
+-- Put back every marker the record says the city should have.
+function fc45_rel_restore(city)
+  for _, n in ipairs(fc45_rel_list(city)) do
+    local b = fc45_rel_marker(n)
+    if not city:has_building(b) then edit.create_building(city, b) end
+  end
+  local holy = find.building_type("Holy City")
+  if not city:has_building(holy) then
+    for n = 1, #fc45_rel_faiths do
+      if fc45_rel_holy(n) == city.id then edit.create_building(city, holy); break end
+    end
+  end
+end
+
+-- Founding: the first civ to learn the tech, by any means, founds the faith in its largest city that
+-- follows none, else in its largest city.
+function fc45_rel_tech(tech, player, reason)
+  local n = fc45_rel_by_tech[tech:rule_name()]
+  if n == nil or not fc45_is_civ(player) then return end
+  if rawget(_G, fc45_gp_key("fc45_rel_founded_", n)) ~= nil then return end
+  local best, best_free = nil, nil
+  for c in player:cities_iterate() do
+    if best == nil or c.size > best.size then best = c end
+    if #fc45_rel_list(c) == 0 and (best_free == nil or c.size > best_free.size) then best_free = c end
+  end
+  local holy = best_free or best
+  if holy == nil then return end
+  fc45_gp_set(fc45_gp_key("fc45_rel_founded_", n), player.id)
+  fc45_gp_set(fc45_gp_key("fc45_rel_holy_", n), holy.id)
+  fc45_rel_add(holy, n, "founded in")
+  local hb = find.building_type("Holy City")
+  if not holy:has_building(hb) then edit.create_building(holy, hb) end
+  notify.event(nil, nil, E.SCRIPT, _("The %s has been founded in %s."), fc45_rel_faiths[n][1], holy.name)
+end
+signal.connect("tech_researched", "fc45_rel_tech")
+
+-- Spread into civ cities that follow no faith: every city of faith f within range adds weight 1, doubled
+-- for the same owner, tripled for f's holy city; the chance is min(cap, weight) percent a turn.
+-- Loop variables here are not named _, which would hide the _() used by notify.
+function fc45_rel_spread()
+  local holders, free = {}, {}
+  for p in players_iterate() do
+    if fc45_is_civ(p) then
+      for c in p:cities_iterate() do
+        local l = fc45_rel_list(c)
+        if #l > 0 then holders[#holders + 1] = {c.tile, p.id, l, c.id} else free[#free + 1] = c end
+      end
+    end
+  end
+  if #holders == 0 then return end
+  for _i, c in ipairs(free) do
+    local w, total = {}, 0
+    for _j, h in ipairs(holders) do
+      if c.tile:sq_distance(h[1]) <= FC45_REL_RANGE_SQ then
+        for _k, n in ipairs(h[3]) do
+          local x = 1
+          if h[2] == c.owner.id then x = x * 2 end
+          if fc45_rel_holy(n) == h[4] then x = x * 3 end
+          w[n] = (w[n] or 0) + x
+          total = total + x
+        end
+      end
+    end
+    if total > 0 and random(1, 100) <= math.min(FC45_REL_CAP, total) then
+      local r = random(1, total)
+      for n = 1, #fc45_rel_faiths do
+        local x = w[n] or 0
+        if r <= x then
+          fc45_rel_add(c, n, "spread to")
+          notify.event(c.owner, c.tile, E.SCRIPT, _("The %s has spread to %s."), fc45_rel_faiths[n][1], c.name)
+          break
+        end
+        r = r - x
+      end
+    end
+  end
+end
+
+-- The state faith: kept while any of the civ's cities follows it, else the faith most of its cities
+-- follow (ties to the lower number). Its marker small wonder sits in the capital.
+function fc45_rel_state(p)
+  local counts = {}
+  for c in p:cities_iterate() do
+    for _, n in ipairs(fc45_rel_list(c)) do counts[n] = (counts[n] or 0) + 1 end
+  end
+  local key = fc45_gp_key("fc45_rel_state_", p.id)
+  local cur = rawget(_G, key)
+  if cur == nil or (counts[cur] or 0) == 0 then
+    local best = nil
+    for n = 1, #fc45_rel_faiths do
+      if (counts[n] or 0) > 0 and (best == nil or counts[n] > counts[best]) then best = n end
+    end
+    if best ~= cur then
+      fc45_gp_set(key, best)
+      if best ~= nil then
+        notify.event(p, nil, E.SCRIPT, _("The %s is now your state faith."), fc45_rel_faiths[best][1])
+        log.normal("FC45REL turn %d state faith of %s is %s", game.turn(), p.name, fc45_rel_faiths[best][1])
+      end
+    end
+    cur = best
+  end
+  local cap = p:primary_capital()
+  for n = 1, #fc45_rel_faiths do
+    local b = fc45_rel_state_marker(n)
+    for c in p:cities_iterate() do
+      if c:has_building(b) and (n ~= cur or cap == nil or c.id ~= cap.id) then edit.remove_building(c, b) end
+    end
+  end
+  if cur ~= nil and cap ~= nil and not cap:has_building(fc45_rel_state_marker(cur)) then
+    edit.create_building(cap, fc45_rel_state_marker(cur))
+  end
+end
+
+-- Shrine gold: 1 a turn to the holy city's owner for every civ city in the world following its faith.
+function fc45_rel_shrine_gold(counts)
+  local shrine = find.building_type("Shrine")
+  for n = 1, #fc45_rel_faiths do
+    local id = fc45_rel_holy(n)
+    if id ~= nil and (counts[n] or 0) > 0 then
+      local c = find.city(nil, id)
+      if c ~= nil and c:has_building(shrine) then
+        edit.change_gold(c.owner, counts[n])
+        log.verbose("FC45REL turn %d shrine of %s pays %s %d", game.turn(), fc45_rel_faiths[n][1], c.owner.name, counts[n])
+      end
+    end
+  end
+end
+
+function fc45_rel_turn(turn, year)
+  local counts = {}
+  for p in players_iterate() do
+    if fc45_is_civ(p) then
+      for c in p:cities_iterate() do
+        fc45_rel_restore(c)
+        for _, n in ipairs(fc45_rel_list(c)) do counts[n] = (counts[n] or 0) + 1 end
+      end
+    end
+  end
+  fc45_rel_spread()
+  for p in players_iterate() do
+    if fc45_is_civ(p) then fc45_rel_state(p) end
+  end
+  fc45_rel_shrine_gold(counts)
+end
+signal.connect("turn_begin", "fc45_rel_turn")
+
+-- A sold marker comes straight back; razing at conquest is put back by city_transferred, anything else
+-- by the next turn's sweep.
+function fc45_rel_lost(city, building, reason, destroyer)
+  if city == nil or reason ~= "sold" then return end
+  local name = building:rule_name()
+  if name == "Holy City" or (string.sub(name, -6) == " Faith" and string.sub(name, -12) ~= " State Faith") then
+    fc45_rel_restore(city)
+  end
+end
+signal.connect("building_lost", "fc45_rel_lost")
+
+function fc45_rel_city_transferred(city, loser, winner, reason)
+  fc45_rel_restore(city)
+end
+signal.connect("city_transferred", "fc45_rel_city_transferred")
+
+function fc45_rel_city_destroyed(city, loser, destroyer)
+  fc45_gp_set(fc45_gp_key("fc45_rel_", city.id), nil)
+end
+signal.connect("city_destroyed", "fc45_rel_city_destroyed")
