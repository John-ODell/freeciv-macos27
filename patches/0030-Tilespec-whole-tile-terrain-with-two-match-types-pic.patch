@@ -4381,7 +4419,6 @@ void tileset_setup_tile_type(struct tileset *t,
                                           terrain_rule_name(pterrain), TRUE);
         }
         break;
-      case MATCH_PAIR:
       case MATCH_FULL:
         fc_assert(FALSE); /* Not yet defined */
         break;
@@ -4583,6 +4620,26 @@ void tileset_setup_tile_type(struct tileset *t,
                         dir, FALSE);
       }
     }
+    if (0 < draw->blending) {
+      const struct drawing_layer *dlp = &draw->layer[draw->blending - 1];
+
+      if (dlp->sprite_type == CELL_WHOLE && dlp->match_style == MATCH_PAIR
+          && dlp->pair_first < sprite_vector_size(&dlp->base)) {
+        struct sprite *pair = dlp->base.p[dlp->pair_first];
