+    }
   } else if (NULL != draw->blender) {
     /* Set up blending sprites. This only works in iso-view! */
     const int W = t->normal_tile_width;
@@ -5344,6 +5401,50 @@ static int fill_city_overlays_sprite_array(const struct tileset *t,
   return sprs - saved_sprs;
 }
 
+/************************************************************************//**
+  The index in dlp->base of the sprite drawn on ptile for whole-tile layer l
+  drawn from variants, or -1 when there is none. A pseudo-random
+  reproducible pick by tile index (modulo, to keep the number in
+  [0..32000)). With MATCH_PAIR the pick is among the pair variants when one
+  of the eight neighbours has the layer's second match type, and among the
+  others when none has.
+****************************************************************************/
+static int whole_variant(const struct tileset *t,
+                         const struct drawing_layer *dlp, int l,
+                         const struct tile *ptile)
+{
+  int first = 0, count = sprite_vector_size(&dlp->base);
+
+  if (dlp->match_style == MATCH_PAIR && dlp->pair_first < count) {
+    bool near = FALSE;
+    enum direction8 dir;
+
+    for (dir = 0; dir < DIR8_MAGIC_MAX && !near; dir++) {
+      struct tile *adjc = mapstep(&(wld.map), ptile, dir);
+      const struct drawing_data *odraw;
+
+      if (adjc == NULL || client_tile_get_known(adjc) == TILE_UNKNOWN
+          || tile_terrain(adjc) == NULL) {
+        continue;
+      }
+      odraw = t->sprites.drawing[terrain_index(tile_terrain(adjc))];
+      near = (odraw != NULL && odraw->num_layers > l
+              && odraw->layer[l].match_indices > 0
+              && odraw->layer[l].match_index[0] == dlp->match_index[1]);
+    }
+    if (near) {
+      first = dlp->pair_first;
+    } else {
+      count = dlp->pair_first;
+    }
+  }
+  if (count - first <= 0) {
+    return -1;
+  }
+
+  return first + fc_randomly(tile_index(ptile) % 32000, count - first);
+}
+
 /************************************************************************//**
   Overhead blending: which of the tileset's blend masks the edge between
   ptile and its cardinal neighbour tile1 uses. Both tiles of an edge get the
@@ -5365,21 +5466,44 @@ static int blend_edge_mask(const struct tile *ptile, const struct tile *tile1,
 
 /************************************************************************//**
   The variant of a terrain's blending layer drawn on ptile (as
-  fill_terrain_sprite_array() picks it), or -1 when the layer has no plain
-  variants.
+  fill_terrain_sprite_array() picks it, whole_variant()), or -1 when the
+  layer has no plain variants.
 ****************************************************************************/
-static int blend_variant_of(const struct drawing_data *draw,
+static int blend_variant_of(const struct tileset *t,
+                            const struct drawing_data *draw,
                             const struct tile *ptile)
 {
   const struct drawing_layer *dlp = &draw->layer[draw->blending - 1];
-  int count = sprite_vector_size(&dlp->base);
 
-  if (dlp->sprite_type != CELL_WHOLE || dlp->match_style != MATCH_NONE
-      || dlp->is_tall || count < 2) {
+  if (dlp->sprite_type != CELL_WHOLE
+      || (dlp->match_style != MATCH_NONE && dlp->match_style != MATCH_PAIR)
+      || dlp->is_tall || sprite_vector_size(&dlp->base) < 2) {
     return -1;
   }
 
-  return fc_randomly(tile_index(ptile) % 32000, count);
+  return whole_variant(t, dlp, draw->blending - 1, ptile);
+}
+
+/************************************************************************//**
+  Whether a terrain whose blending layer has MATCH_PAIR is drawn on ptile
+  with its pair set, so that it fades into its neighbours from there
+  (blend_pair) rather than from its usual variants.
+****************************************************************************/
+static bool blend_from_pair(const struct tileset *t,
+                            const struct drawing_data *draw,
+                            const struct tile *ptile)
+{
+  const struct drawing_layer *dlp;
+
+  if (draw->blending <= 0) {
+    return FALSE;
+  }
+  dlp = &draw->layer[draw->blending - 1];
+
+  return (dlp->sprite_type == CELL_WHOLE && dlp->match_style == MATCH_PAIR
+          && dlp->pair_first < sprite_vector_size(&dlp->base)
+          && whole_variant(t, dlp, draw->blending - 1, ptile)
+             >= dlp->pair_first);
 }
 
 /************************************************************************//**
@@ -5404,8 +5528,8 @@ static int fill_blend_variant(const struct tileset *t,
   if (NULL == t->sprites.blend_mask_same || draw->blending <= 0) {
     return 0;
   }
-  v = blend_variant_of(draw, ptile);
-  v1 = blend_variant_of(draw, tile1);
+  v = blend_variant_of(t, draw, ptile);
+  v1 = blend_variant_of(t, draw, tile1);
   if (v < 0 || v1 == v) {
     return 0;
   }
@@ -5417,7 +5541,7 @@ static int fill_blend_variant(const struct tileset *t,
       struct tile *beside = mapstep(&(wld.map), ptile, side[i]);
 
       if (beside != NULL && tile_terrain(beside) == pterrain
-          && blend_variant_of(draw, beside) == v1) {
+          && blend_variant_of(t, draw, beside) == v1) {
         return 0;
       }
     }
@@ -5470,6 +5594,7 @@ static int fill_terrain_sprite_blending(const struct tileset *t,
       struct tile *tile1 = mapstep(&(wld.map), ptile, dir8);
       struct terrain *other = tterrain_near[dir8];
       struct drawing_data *odraw;
+      bool pair;
 
       if (!tile1
           || client_tile_get_known(tile1) == TILE_UNKNOWN
@@ -5490,15 +5615,20 @@ static int fill_terrain_sprite_blending(const struct tileset *t,
               || tterrain_near[dir_ccw(dir8)] == other)) {
         continue;
       }
+      pair = blend_from_pair(t, odraw, tile1);
       if (is_cardinal_dir(dir8) && t->num_blend_masks > 1) {
         int k = blend_edge_mask(ptile, tile1, dir8, t->num_blend_masks);
+        struct sprite *piece = (pair ? odraw->blend_pair[k][dir8]
+                                : 0 < k ? odraw->blend_more[k - 1][dir8]
+                                : NULL);
 
-        if (k > 0 && NULL != odraw->blend_more[k - 1][dir8]) {
-          ADD_SPRITE_FULL(odraw->blend_more[k - 1][dir8]);
+        if (NULL != piece) {
+          ADD_SPRITE_FULL(piece);
           continue;
         }
       }
-      ADD_SPRITE_FULL(odraw->blend[dir8]);
+      ADD_SPRITE_FULL(pair && NULL != odraw->blend_pair[0][dir8]
+                      ? odraw->blend_pair[0][dir8] : odraw->blend[dir8]);
     }
 
     return sprs - saved_sprs;
@@ -5611,19 +5741,16 @@ static int fill_terrain_sprite_array(struct tileset *t,
     {
       switch (dlp->match_style) {
       case MATCH_NONE:
+      case MATCH_PAIR:
         {
-          int count = sprite_vector_size(&dlp->base);
-
-          if (count > 0) {
-            /* Pseudo-random reproducible algorithm to pick a sprite. Use modulo
-             * to limit the number to a handleable size [0..32000). */
-            count = fc_randomly(tile_index(ptile) % 32000, count);
+          int v = whole_variant(t, dlp, l, ptile);
 
+          if (v >= 0) {
             if (dlp->is_tall) {
               ox += FULL_TILE_X_OFFSET;
               oy += FULL_TILE_Y_OFFSET;
             }
-            ADD_SPRITE(dlp->base.p[count], TRUE, ox, oy);
+            ADD_SPRITE(dlp->base.p[v], TRUE, ox, oy);
           }
           break;
         }
@@ -5646,7 +5773,6 @@ static int fill_terrain_sprite_array(struct tileset *t,
           ADD_SPRITE(dlp->match[tileno], TRUE, ox, oy);
           break;
         }
-      case MATCH_PAIR:
       case MATCH_FULL:
         fc_assert(FALSE); /* Not yet defined */
         break;
