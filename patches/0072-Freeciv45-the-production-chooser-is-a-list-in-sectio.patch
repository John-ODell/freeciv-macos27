+/************************************************************************//**
+  The Freeciv45 list: the city's name, then Units, Buildings, Great
+  Wonders, Small Wonders and the rest (Coinage), each under its heading,
+  then Cancel. Takes the
+  targets, in name order; the ones not shown are deleted.
+****************************************************************************/
+void city_production_model::populate_listed(QList<struct universal *> &targets)
+{
+  enum { SEC_UNITS, SEC_BUILDINGS, SEC_GREAT, SEC_SMALL, SEC_OTHER, SEC_N };
+  // TRANS: headings of the Freeciv45 production list
+  const char *names[SEC_N] = { N_("Units"), N_("Buildings"),
+                               N_("Great Wonders"), N_("Small Wonders"),
+                               N_("Other") };
+  QList<struct universal *> sections[SEC_N];
+  QFont f = *fc_font::instance()->get_font(fonts::default_font);
+  QFontMetrics fm(f);
+  int i, name_w = 0;
+
+  for (struct universal *target : targets) {
+    int sec;
+    QString str;
+
+    if (VUT_UTYPE == target->kind) {
+      sec = (show_units ? SEC_UNITS : -1);
+      str = utype_name_translation(target->value.utype);
+    } else {
+      const struct impr_type *pimprove = target->value.building;
+
+      str = improvement_name_translation(pimprove);
+      if (is_great_wonder(pimprove)) {
+        sec = (show_wonders ? SEC_GREAT : -1);
+      } else if (is_small_wonder(pimprove)) {
+        sec = (show_wonders ? SEC_SMALL : -1);
+      } else if (is_convert_improvement(pimprove)) {
+        sec = SEC_OTHER;
+      } else if (is_improvement(pimprove)) {
+        sec = (show_buildings ? SEC_BUILDINGS : -1);
+      } else {
+        sec = (show_buildings ? SEC_OTHER : -1);
+      }
+    }
+    if (sec < 0) {
+      delete target;
+      continue;
+    }
+    name_w = qMax(name_w, fm.horizontalAdvance(str));
+    sections[sec] << target;
+  }
+
+  // The city first: the list can open on its own (issue 373)
+  city_target_list << new production_item(QString(city_name_get(mcity)),
+                                          this);
+  name_w = qMax(name_w, fm.horizontalAdvance(city_name_get(mcity)));
+  for (i = 0; i < SEC_N; i++) {
+    if (sections[i].isEmpty()) {
+      continue;
+    }
+    city_target_list << new production_item(QString(_(names[i])), this);
+    for (struct universal *target : sections[i]) {
+      // Deleted in production_item destructor
+      city_target_list << new production_item(target, this);
+    }
+  }
+  city_target_list << new production_item((struct universal *) nullptr,
+                                          this);
+
+  // Picture, name, and room for "99 turns" on the right
+  sh.setX(sh.y() + 4 + name_w + 24
+          + fm.horizontalAdvance(QString(_("%1 turns")).arg(999)) + 8);
+}
+
+/************************************************************************//**
+  Headings of the Freeciv45 list cannot be picked
+****************************************************************************/
+Qt::ItemFlags city_production_model::flags(const QModelIndex &index) const
+{
+  if (listed && index.isValid() && index.row() < city_target_list.count()
+      && !city_target_list[index.row()]->heading.isEmpty()) {
+    return Qt::NoItemFlags;
+  }
+
+  return QAbstractListModel::flags(index);
+}
