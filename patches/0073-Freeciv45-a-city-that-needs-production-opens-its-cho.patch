 /************************************************************************//**
-  The first own city that needs production: it finished something at this
-  turn's start, or was founded this turn, has nothing queued after the
-  current item, and was not seen this turn. The server sends the worklist
-  and production-changed events to no message window by default, so the
-  city's own data decides, not the messages. Founding stamps
+  A city finished something at this turn's start, or was founded this
+  turn, and has nothing queued after the current item. Founding stamps
   turn_last_built too, so a stamp equal to the founding turn is not a
   finished build.
 ****************************************************************************/
+static bool city_needs_production(const struct city *pcity)
+{
+  bool finished = (city_built_last_turn(pcity)
+                   && pcity->turn_last_built != pcity->turn_founded);
+
+  return ((finished || pcity->turn_founded == game.info.turn)
+          && worklist_is_empty(&pcity->worklist));
+}
+
+/************************************************************************//**
+  The first own city that needs production (city_needs_production) and
+  was not seen this turn. The server sends the worklist and
+  production-changed events to no message window by default, so the
+  city's own data decides, not the messages.
+****************************************************************************/
 struct city *what_next_button::city_waiting(int *count_out)
 {
   struct city *first = nullptr;
@@ -1014,11 +1031,7 @@ struct city *what_next_button::city_waiting(int *count_out)
   }
   note_seen_city();
   city_list_iterate(pplayer->cities, pcity) {
-    bool finished = (city_built_last_turn(pcity)
-                     && pcity->turn_last_built != pcity->turn_founded);
-
-    if ((finished || pcity->turn_founded == game.info.turn)
-        && worklist_is_empty(&pcity->worklist)
+    if (city_needs_production(pcity)
         && !seen_cities.contains(pcity->id)) {
       (*count_out)++;
       if (first == nullptr) {
@@ -1030,6 +1043,81 @@ struct city *what_next_button::city_waiting(int *count_out)
   return first;
 }
 
+/************************************************************************//**
+  Centre the map on the city and open its production chooser beside it;
+  the city counts as seen for the rest of the turn
+****************************************************************************/
+void what_next_button::open_chooser(struct city *pcity)
+{
+  production_widget *pw;
+  QPoint middle;
+  int x, right;
+
+  seen_cities.insert(pcity->id);
+  chooser_cities.insert(pcity->id);
+  side_show_map(true);
+  center_tile_mapcanvas(city_tile(pcity));
+  pw = new production_widget(this, pcity, false, 0, 0, true);
+  connect(pw, &production_widget::destroyed, this, [this]() {
+    // Picked or not, the next city waits a moment; closing it unpicked
+    // stops the automatic choosers for this turn
+    refresh();
+  });
+  connect(pw, &production_widget::chosen, this, [this]() {
+    chooser_stopped_turn = -1;
+  });
+  chooser_stopped_turn = game.info.turn;
+  // Beside the city, which the map now has in the middle, not over it
+  middle = gui()->mapToGlobal(gui()->rect().center());
+  x = middle.x() + tileset_tile_width(tileset);
+  right = gui()->mapToGlobal(gui()->rect().topRight()).x();
+  if (x + pw->width() > right) {
+    x = qMax(gui()->mapToGlobal(QPoint(0, 0)).x(), right - pw->width());
+  }
+  pw->move(x, middle.y() - pw->height() / 2);
+  pw->show();
+}
+
+/************************************************************************//**
+  With the Freeciv45 layout, during the player's own phase, a city that
+  needs production opens its chooser by itself, one city after another
+  (issue 373), unless the game window is not the active one (a popup
+  opened then closes at once), a popup or modal box is up, or the player
+  closed one unpicked this turn
+****************************************************************************/
+void what_next_button::auto_chooser()
+{
+  struct player *pplayer = client_player();
+  struct city *next = nullptr;
+
+  if (!gui_options.gui_qt_freeciv45_edges || pplayer == nullptr
+      || client_is_observer() || C_S_RUNNING != client_state()
+      || !can_client_issue_orders()
+      || !is_player_phase(pplayer, game.info.phase)
+      || chooser_stopped_turn == game.info.turn
+      || !gui()->isActiveWindow()
+      || QApplication::activePopupWidget() != nullptr
+      || QApplication::activeModalWidget() != nullptr) {
+    return;
+  }
+  foreach (QWidget *w, QApplication::topLevelWidgets()) {
+    if (w->isVisible() && w->inherits("production_widget")) {
+      return;
+    }
+  }
+  note_seen_city();
+  city_list_iterate(pplayer->cities, pcity) {
+    if (city_needs_production(pcity)
+        && !chooser_cities.contains(pcity->id)) {
+      next = pcity;
+      break;
+    }
+  } city_list_iterate_end;
+  if (next != nullptr) {
+    open_chooser(next);
+  }
+}
+
 /************************************************************************//**
   Work out the step, in decision 10's order: research unset, a unit that
   needs orders, a city that needs production, then End turn
