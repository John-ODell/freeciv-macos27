+/****************************************************************************
+  The "what next" button above the minimap: what the turn needs next, and a
+  click does it (panels.md section 8.3)
+****************************************************************************/
+class what_next_button : public QPushButton
+{
+  Q_OBJECT
+public:
+  what_next_button(QWidget *minimap, QWidget *parent);
+  void refresh();
+  void place();
+  void set_end_turn_enabled(bool enabled);
+  void set_end_turn_attention(bool attention);
+protected:
+  bool eventFilter(QObject *obj, QEvent *event) override;
+private:
+  enum next_step { NEXT_RESEARCH, NEXT_UNIT, NEXT_CITY, NEXT_END_TURN };
+  void do_next();
+  struct unit *unit_waiting(int *count);
+  struct city *city_waiting(int *count);
+  void note_seen_city();
+  QWidget *minimap;
+  QLabel *what;
+  QLabel *count;
+  QTimer *timer;
+  enum next_step step;
+  bool end_turn_enabled;
+  bool end_turn_attention;
+  int seen_turn;
+  QSet<int> seen_cities;
+};
+
 void apply_freeciv45_edges(void);
 
 #endif // FC__EDGEBAR_H
