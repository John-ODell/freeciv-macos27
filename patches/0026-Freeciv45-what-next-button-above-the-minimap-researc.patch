+/************************************************************************//**
+  Whether a unit still needs orders this turn: the units the focus cycles
+  through, as W and the focus advance pick them, waiting ones included
+****************************************************************************/
+static bool unit_needs_orders(const struct unit *punit)
+{
+  return (unit_owner(punit) == client_player()
+          && punit->client.focus_status != FOCUS_DONE
+          && punit->activity == ACTIVITY_IDLE
+          && !unit_has_orders(punit)
+          && (punit->moves_left > 0
+              || unit_type_get(punit)->move_rate == 0)
+          && !punit->done_moving
+          && punit->ssa_controller == SSA_NONE);
+}
+
+/************************************************************************//**
+  The button: the step's text on the left, "1 of N" on the right when
+  more than one thing waits. It follows the minimap: right-aligned with it,
+  8 px above, hidden with it.
+****************************************************************************/
+what_next_button::what_next_button(QWidget *minimap_wdg, QWidget *parent)
+  : QPushButton(parent)
+{
+  QHBoxLayout *row = new QHBoxLayout(this);
+
+  setObjectName("what_next_button");
+  minimap = minimap_wdg;
+  step = NEXT_END_TURN;
+  end_turn_enabled = true;
+  end_turn_attention = false;
+  seen_turn = -1;
+  setFixedSize(WHAT_NEXT_WIDTH, WHAT_NEXT_HEIGHT);
+  setFocusPolicy(Qt::NoFocus);
+  setCursor(Qt::PointingHandCursor);
+  row->setContentsMargins(14, 0, 12, 0);
+  what = new QLabel(this);
+  what->setObjectName("what_next_text");
+  count = new QLabel(this);
+  count->setObjectName("what_next_count");
+  row->addWidget(what, 1);
+  row->addWidget(count, 0);
+  connect(this, &QPushButton::clicked, this, &what_next_button::do_next);
+  minimap->installEventFilter(this);
+  timer = new QTimer(this);
+  connect(timer, &QTimer::timeout, this, [this]() {
+    note_seen_city();
+    if (isVisible()) {
+      refresh();
+    } else {
+      place();
+    }
+  });
+  timer->start(WHAT_NEXT_REFRESH_MS);
+  hide();
+}
+
+/************************************************************************//**
+  The minimap moved, changed size, or was shown or hidden
+****************************************************************************/
+bool what_next_button::eventFilter(QObject *obj, QEvent *event)
+{
+  if (obj == minimap
+      && (event->type() == QEvent::Move || event->type() == QEvent::Resize
+          || event->type() == QEvent::Show
+          || event->type() == QEvent::Hide)) {
+    place();
+  }
+
+  return QPushButton::eventFilter(obj, event);
+}
+
+/************************************************************************//**
+  Right-aligned with the minimap, 8 px above it (below it when the minimap
+  sits at the top); only with the edges on, in a game, while the minimap
+  shows
+****************************************************************************/
+void what_next_button::place()
+{
+  bool want = (gui_options.gui_qt_freeciv45_edges
+               && C_S_RUNNING <= client_state()
+               && minimap->isVisibleTo(parentWidget()));
+  QRect m = minimap->geometry();
+  int y = m.top() - WHAT_NEXT_GAP - height();
+
+  if (y < 0) {
+    y = m.bottom() + 1 + WHAT_NEXT_GAP;
+  }
+  move(m.right() + 1 - width(), y);
+  if (want != isVisibleTo(parentWidget())) {
+    setVisible(want);
+  }
+  if (want) {
+    raise();
+    refresh();
+  }
+}
+
+/************************************************************************//**
+  The first own unit that needs orders, the focus unit first; count is how
+  many do
+****************************************************************************/
+struct unit *what_next_button::unit_waiting(int *count_out)
+{
+  struct unit *first = nullptr;
+  struct player *pplayer = client_player();
+
+  *count_out = 0;
+  if (pplayer == nullptr) {
+    return nullptr;
+  }
+  unit_list_iterate(get_units_in_focus(), punit) {
+    if (unit_needs_orders(punit)) {
+      first = punit;
+      break;
+    }
+  } unit_list_iterate_end;
+  unit_list_iterate(pplayer->units, punit) {
+    if (unit_needs_orders(punit)) {
+      (*count_out)++;
+      if (first == nullptr) {
+        first = punit;
+      }
+    }
+  } unit_list_iterate_end;
+
+  return first;
+}
+
+/************************************************************************//**
+  A city counts as seen for the rest of the turn once it was opened from
+  here or shown in the city overlay; the timer checks the overlay even
+  while the button hides under it
+****************************************************************************/
+void what_next_button::note_seen_city()
+{
+  struct city *shown;
+
+  if (seen_turn != game.info.turn) {
+    seen_turn = game.info.turn;
+    seen_cities.clear();
+  }
+  if (gui() == nullptr || gui()->cityoverlay_wdg == nullptr) {
+    return;
+  }
+  shown = gui()->cityoverlay_wdg->shown_city();
+  if (shown != nullptr) {
+    seen_cities.insert(shown->id);
+  }
+}
+
+/************************************************************************//**
+  The first own city that needs production: it finished something at this
+  turn's start, or was founded this turn, has nothing queued after the
+  current item, and was not seen this turn. The server sends the worklist
+  and production-changed events to no message window by default, so the
+  city's own data decides, not the messages. Founding stamps
+  turn_last_built too, so a stamp equal to the founding turn is not a
+  finished build.
+****************************************************************************/
+struct city *what_next_button::city_waiting(int *count_out)
+{
+  struct city *first = nullptr;
+  struct player *pplayer = client_player();
+
+  *count_out = 0;
+  if (pplayer == nullptr) {
+    return nullptr;
+  }
+  note_seen_city();
+  city_list_iterate(pplayer->cities, pcity) {
+    bool finished = (city_built_last_turn(pcity)
+                     && pcity->turn_last_built != pcity->turn_founded);
+
+    if ((finished || pcity->turn_founded == game.info.turn)
+        && worklist_is_empty(&pcity->worklist)
+        && !seen_cities.contains(pcity->id)) {
+      (*count_out)++;
+      if (first == nullptr) {
+        first = pcity;
+      }
+    }
+  } city_list_iterate_end;
+
+  return first;
+}
+
+/************************************************************************//**
+  Work out the step, in decision 10's order: research unset, a unit that
+  needs orders, a city that needs production, then End turn
+****************************************************************************/
+void what_next_button::refresh()
+{
+  struct player *pplayer = client_player();
+  bool playing = (pplayer != nullptr && !client_is_global_observer()
+                  && C_S_RUNNING <= client_state());
+  bool no_research = false;
+  int units = 0, cities = 0, total;
+  struct unit *punit = nullptr;
+  struct city *pcity = nullptr;
+  QString text, tip;
+
+  if (!isVisible()) {
+    return;
+  }
+  if (playing) {
+    const struct research *presearch = research_get(pplayer);
+
+    no_research = (presearch != nullptr
+                   && presearch->researching == A_UNSET);
+    punit = unit_waiting(&units);
+    pcity = city_waiting(&cities);
+  }
+  total = (no_research ? 1 : 0) + units + cities;
+
+  if (no_research) {
+    step = NEXT_RESEARCH;
+    // TRANS: the Freeciv45 "what next" button
+    text = _("Choose research");
+    tip = _("Nothing is being researched; opens the research report");
+  } else if (punit != nullptr) {
+    step = NEXT_UNIT;
+    // TRANS: the Freeciv45 "what next" button
+    text = _("Unit needs orders");
+    tip = QString(PL_("%1 unit waits for orders; shows the next one, "
+                      "as W does",
+                      "%1 units wait for orders; shows the next one, "
+                      "as W does", units)).arg(units);
+  } else if (pcity != nullptr) {
+    step = NEXT_CITY;
+    // TRANS: the Freeciv45 "what next" button
+    text = _("City needs production");
+    tip = QString(_("%1 has nothing queued; opens the city"))
+          .arg(city_name_get(pcity));
+  } else {
+    step = NEXT_END_TURN;
+    // TRANS: the Freeciv45 "what next" button
+    text = _("End turn");
+    tip = _("End the turn (Shift+Return); nothing else waits");
+  }
+
+  if (what->text() != text) {
+    what->setText(text);
+  }
+  if (toolTip() != tip) {
+    setToolTip(tip);
+  }
+  if (total > 1) {
+    // TRANS: the Freeciv45 "what next" button, "1 of 3" waiting items
+    count->setText(QString(_("1 of %1")).arg(total));
+    count->show();
+  } else {
+    count->hide();
+  }
+  setEnabled(step != NEXT_END_TURN || end_turn_enabled);
+  {
+    QString state = (step == NEXT_END_TURN ? (end_turn_attention ? "ready"
+                                                                 : "end")
+                                           : "blocked");
+
+    if (property("step").toString() != state) {
+      // The labels too: the theme colours them by the step
+      for (QWidget *w : { (QWidget *) this, (QWidget *) what,
+                          (QWidget *) count }) {
+        w->setProperty("step", state);
+        w->style()->unpolish(w);
+        w->style()->polish(w);
+      }
+    }
+  }
+}
+
+/************************************************************************//**
+  A click does the step
+****************************************************************************/
+void what_next_button::do_next()
+{
+  int n;
+
+  refresh();
+  switch (step) {
+  case NEXT_RESEARCH:
+    side_left_click_science(true);
+    break;
+  case NEXT_UNIT:
+    {
+      struct unit *punit = unit_waiting(&n);
+      struct unit *head = head_of_units_in_focus();
+
+      if (punit == nullptr) {
+        break;
+      }
+      side_show_map(true);
+      if (head != nullptr && unit_needs_orders(head)) {
+        // The next one, as W does
+        key_unit_wait();
+      } else {
+        unit_focus_set_and_select(punit);
+        center_tile_mapcanvas(unit_tile(punit));
+      }
+    }
+    break;
+  case NEXT_CITY:
+    {
+      struct city *pcity = city_waiting(&n);
+
+      if (pcity != nullptr) {
+        seen_cities.insert(pcity->id);
+        side_show_map(true);
+        qtg_real_city_dialog_popup(pcity);
+      }
+    }
+    break;
+  case NEXT_END_TURN:
+    if (end_turn_enabled) {
+      key_end_turn();
+    }
+    break;
+  }
+  refresh();
+}
+
+/************************************************************************//**
+  End turn is greyed out while the turn cannot be ended
+****************************************************************************/
+void what_next_button::set_end_turn_enabled(bool enabled)
+{
+  end_turn_enabled = enabled;
+  refresh();
+}
+
+/************************************************************************//**
+  End turn stands out when every unit has moved
+****************************************************************************/
+void what_next_button::set_end_turn_attention(bool attention)
+{
+  end_turn_attention = attention;
+  refresh();
+}
+
