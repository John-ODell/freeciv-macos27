 data/civ45/actions.ruleset   |  61 ++++++++-
 data/civ45/buildings.ruleset | 240 ++++++++++++++++++++++++++++++++++-
 data/civ45/effects.ruleset   |  34 +++++
 data/civ45/script.lua        |  93 ++++++++++++--
 data/civ45/techs.ruleset     |  44 ++++++-
 data/civ45/terrain.ruleset   |  25 +++-
 data/civ45/units.ruleset     |  86 ++++++++++++-
 8 files changed, 566 insertions(+), 32 deletions(-)

