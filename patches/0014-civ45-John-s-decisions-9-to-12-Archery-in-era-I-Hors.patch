diff --git a/data/civ45/script.lua b/data/civ45/script.lua
index d7e5742..1be5fa7 100644
--- a/data/civ45/script.lua
+++ b/data/civ45/script.lua
@@ -772,6 +772,8 @@ function fc45_gp_turn(turn, year)
         log.normal("FC45GP turn %d golden age of %s ended", turn, p.name)
       end
       for c in p:cities_iterate() do
+        local res_owner = rawget(_G, fc45_gp_key("fc45_gp_res_owner_", c.id))
+        if res_owner ~= nil and res_owner ~= p.id then fc45_gp_residents_restore(c, "new owner") end
         local rate, pct = fc45_gp_rate(c)
         if rate > 0 then
           local key = fc45_gp_key("fc45_gp_pool_", c.id)
@@ -793,9 +795,34 @@ signal.connect("turn_begin", "fc45_gp_turn")
 
 function fc45_gp_city_destroyed(city, loser, destroyer)
   fc45_gp_set(fc45_gp_key("fc45_gp_pool_", city.id), nil)
+  fc45_gp_set(fc45_gp_key("fc45_gp_res_", city.id), nil)
+  fc45_gp_set(fc45_gp_key("fc45_gp_res_owner_", city.id), nil)
 end
 signal.connect("city_destroyed", "fc45_gp_city_destroyed")
 
+-- Settled great people stay with a captured city (John's decision of 2026-10-17): every kind recorded in
+-- fc45_gp_res_<city id> is re-created for the new owner. The city_transferred signal fires only on conquest
+-- (server/citytools.c:2145), so fc45_gp_turn also compares each recorded city's owner with the one at settling
+-- and re-creates after a trade, an incitement or a civil war within the turn.
+function fc45_gp_residents_restore(city, why)
+  local have = rawget(_G, fc45_gp_key("fc45_gp_res_", city.id))
+  if have == nil then return end
+  for kind in string.gmatch(have, "([^;]+);") do
+    local b = find.building_type("Resident " .. kind)
+    if b ~= nil and not city:has_building(b) then
+      edit.create_building(city, b)
+      notify.event(city.owner, city.tile, E.WONDER_BUILD, _("The Resident %s of %s stays on under its new ruler."), kind, city.name)
+      log.normal("FC45GP turn %d resident %s re-created in %s for %s (%s)", game.turn(), kind, city.name, city.owner.name, why)
+    end
+  end
+  fc45_gp_set(fc45_gp_key("fc45_gp_res_owner_", city.id), city.owner.id)
+end
+
+function fc45_gp_city_transferred(city, loser, winner, reason)
+  fc45_gp_residents_restore(city, reason)
+end
+signal.connect("city_transferred", "fc45_gp_city_transferred")
+
 -- Settling: "Join City" adds the citizen; the Resident building is founded here.
 function fc45_gp_join(action, actor, city)
   if action:rule_name() ~= "Join City" then return end
@@ -803,6 +830,10 @@ function fc45_gp_join(action, actor, city)
   if kind == nil then return end
   local b = find.building_type("Resident " .. kind)
   if b ~= nil and not city:has_building(b) then edit.create_building(city, b) end
+  local key = fc45_gp_key("fc45_gp_res_", city.id)
+  local have = rawget(_G, key) or ""
+  if not string.find(have, kind .. ";", 1, true) then fc45_gp_set(key, have .. kind .. ";") end
+  fc45_gp_set(fc45_gp_key("fc45_gp_res_owner_", city.id), city.owner.id)
   log.normal("FC45GP turn %d settled %s of %s in %s unit %d", game.turn(), actor.utype:rule_name(), actor.owner.name, city.name, actor.id)
 end
 signal.connect("action_started_unit_city", "fc45_gp_join")
@@ -854,19 +885,53 @@ function fc45_gp_deed(action, actor)
 end
 signal.connect("action_started_unit_self", "fc45_gp_deed")
 
--- A pledge counts towards the next age: the first age costs one great person, the second two, and so on.
--- The age is the "Golden Age" small wonder in the capital for FC45_GOLDEN_TURNS turns.
+-- A pledge counts towards the next age: the first age costs one great person, the second two of different
+-- kinds, the third three (John's decision of 2026-10-17). Each kind that has pledged holds a "Pledge of the
+-- <Kind>" small wonder in the capital, which its enabler reads, so a second pledge of that kind is refused
+-- before it reaches here. The age is the "Golden Age" small wonder in the capital for FC45_GOLDEN_TURNS turns,
+-- and starting it clears the pledges.
