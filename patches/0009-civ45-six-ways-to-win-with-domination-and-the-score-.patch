diff --git a/data/civ45/script.lua b/data/civ45/script.lua
index 55c602d..172a234 100644
--- a/data/civ45/script.lua
+++ b/data/civ45/script.lua
@@ -527,3 +527,106 @@ end
 
 signal.connect("action_started_unit_tile",
 "action_started_unit_tile_callback")
+
+
+-- Freeciv45 ways to win (notes/freeciv45/design/victory.md). Conquest, culture, space and the allied
+-- win are the server's own rules, set in game.ruleset. The two below are not:
+-- Domination: a player who holds FC45_DOM_LAND_PCT percent of the land tiles and FC45_DOM_POP_PCT percent
+-- of all citizens for FC45_DOM_TURNS turns in a row wins. The check starts at turn FC45_DOM_FROM_TURN,
+-- because nobody can qualify earlier and the map walk costs time.
+-- Score: at the start of the last turn (the endturn setting) the living player with the highest score
+-- is named the winner, so the game ends with a victor instead of a bare turn-limit notice.
+FC45_DOM_LAND_PCT = 60
+FC45_DOM_POP_PCT = 50
+FC45_DOM_TURNS = 3
+FC45_DOM_FROM_TURN = 100
+
+-- A living player who is neither the barbarians nor the animals.
+function fc45_is_civ(p)
+  local n = p.nation:rule_name()
+  return p.is_alive and n ~= "Barbarian" and n ~= "Animal Kingdom"
+end
+
+-- Land tiles, the land tiles each player holds, all citizens, and each civ's citizens.
+function fc45_domination_count()
+  local land, held, pop, pops = 0, {}, 0, {}
+  for tile in whole_map_iterate() do
+    if tile.terrain:class_name() == "Land" then
+      land = land + 1
+      local o = tile.owner
+      if o ~= nil then held[o.id] = (held[o.id] or 0) + 1 end
+    end
+  end
+  for p in players_iterate() do
+    if fc45_is_civ(p) then
+      local s = 0
+      for c in p:cities_iterate() do s = s + c.size end
+      pops[p.id] = s
+      pop = pop + s
+    end
+  end
+  return land, held, pop, pops
+end
+
+-- The civs that pass the two thresholds right now; changes nothing. Also returns the land and
+-- citizen totals.
+function fc45_domination_qualifiers(land_pct, pop_pct)
+  local land, held, pop, pops = fc45_domination_count()
+  local q = {}
+  for p in players_iterate() do
+    if fc45_is_civ(p) and land > 0 and pop > 0
+       and (held[p.id] or 0) * 100 >= land * land_pct
+       and (pops[p.id] or 0) * 100 >= pop * pop_pct then
+      q[#q + 1] = p
+    end
+  end
+  return q, land, pop
+end
+
+function fc45_domination_check(turn, year)
+  if turn < FC45_DOM_FROM_TURN then return end
+  local q = fc45_domination_qualifiers(FC45_DOM_LAND_PCT, FC45_DOM_POP_PCT)
+  local passed = {}
+  for i, p in ipairs(q) do passed[p.id] = true end
+  for p in players_iterate() do
+    if fc45_is_civ(p) then
+      -- One scalar global per player: scalars are saved with the game, tables are not.
+      local key = string.format("fc45_dom_run_%d", p.id)
+      if passed[p.id] then _G[key] = (_G[key] or 0) + 1 else _G[key] = 0 end
+      if _G[key] >= FC45_DOM_TURNS then
+        notify.all(_("The %s hold %d%% of the land and %d%% of the world's people: they rule the known world."),
+                   p.nation:plural_translation(), FC45_DOM_LAND_PCT, FC45_DOM_POP_PCT)
+        edit.player_victory(p)
+      end
+    end
+  end
+end
+
+-- The living civ with the highest score; the first found wins a tie.
+function fc45_best_score()
+  local best, score = nil, -1
+  for p in players_iterate() do
+    if fc45_is_civ(p) then
+      local s = p:civilization_score()
+      if s > score then best, score = p, s end
+    end
+  end
+  return best, score
+end
+
+function fc45_score_winner(turn, year)
+  local last = tonumber(server.setting.get("endturn"))
+  if last == nil or turn ~= last then return end
+  local best, score = fc45_best_score()
+  if best ~= nil then
+    notify.all(_("Turn %d is the last. The %s have the highest score, %d, and win."),
+               turn, best.nation:plural_translation(), score)
+    edit.player_victory(best)
+  end
+end
+
+function fc45_victory_turn_begin(turn, year)
+  fc45_domination_check(turn, year)
+  fc45_score_winner(turn, year)
+end
+signal.connect("turn_begin", "fc45_victory_turn_begin")
