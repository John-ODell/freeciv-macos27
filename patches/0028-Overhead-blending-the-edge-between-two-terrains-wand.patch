+/************************************************************************//**
+  Overhead blending: the part of a tile that a neighbour in direction dir
+  fades into. The whole tile, or with strip only the quarter of the tile
+  next to that neighbour (the edge, or the corner for a diagonal).
+****************************************************************************/
+static void blend_rect(const struct tileset *t, enum direction8 dir,
+                       bool strip, int *x, int *y, int *w, int *h)
+{
+  const int W = t->normal_tile_width;
+  const int H = t->normal_tile_height;
+  int dx, dy;
+
+  DIRSTEP(dx, dy, dir);
+  *w = (strip && dx != 0) ? W / 4 : W;
+  *h = (strip && dy != 0) ? H / 4 : H;
+  *x = (dx > 0) ? W - *w : 0;
+  *y = (dy > 0) ? H - *h : 0;
+}
+
+/************************************************************************//**
+  Overhead blending: src (a terrain tile) seen through the part of a 3x3
+  tile mask that lies on the tile which has src's terrain in direction dir,
+  cut to blend_rect().
+****************************************************************************/
+static struct sprite *blend_piece(const struct tileset *t,
+                                  struct sprite *mask, struct sprite *src,
+                                  enum direction8 dir, bool strip)
+{
+  const int W = t->normal_tile_width;
+  const int H = t->normal_tile_height;
+  struct sprite *piece, *out;
+  int dx, dy, x, y, w, h;
+
+  DIRSTEP(dx, dy, dir);
+  blend_rect(t, dir, strip, &x, &y, &w, &h);
+  piece = crop_sprite(mask, (1 - dx) * W + x, (1 - dy) * H + y, w, h,
+                      NULL, 0, 0, 1.0f, FALSE);
+  out = crop_sprite(src, x, y, w, h, piece, x, y, 1.0f, FALSE);
+  free_sprite(piece);
+
+  return out;
+}
+
