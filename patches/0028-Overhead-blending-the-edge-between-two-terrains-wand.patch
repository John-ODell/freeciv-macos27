+   * (indexed by a direction8; the corners are always blend[]). */
+  struct sprite *blend_more[MAX_BLEND_MASKS - 1][8];
+  /* Overhead view with t.blend_mask_same: each variant of the blending
+   * layer as it fades into a neighbour with another variant of the same
+   * terrain, made when first drawn; blend_variants * 8, by direction8. */
