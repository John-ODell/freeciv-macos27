+/************************************************************************//**
+  Whether an overhead blend mask is there and 3x3 tiles. A scaled tileset
+  (the Qt client's zoom) rounds the mask and the tile size separately, so
+  allow a pixel per tile.
+****************************************************************************/
+static bool blend_mask_fits(struct tileset *t, struct sprite *mask,
+                            const char *tag)
+{
+  int mw, mh;
+
+  if (mask == NULL) {
+    return FALSE;
+  }
+  get_sprite_dimensions(mask, &mw, &mh);
+  if (abs(mw - 3 * t->normal_tile_width) > 3
+      || abs(mh - 3 * t->normal_tile_height) > 3) {
+    log_error("Tileset \"%s\": %s is %dx%d, not 3x3 tiles (%dx%d); "
+              "not used for blending in overhead view.",
+              tileset_name_get(t), tag, mw, mh,
+              3 * t->normal_tile_width, 3 * t->normal_tile_height);
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
