+      draw->blend[dir] = blend_piece(t, t->sprites.blend_mask, draw->blender,
+                                     dir, FALSE);
+      for (k = 1; k < t->num_blend_masks && is_cardinal_dir(dir); k++) {
+        draw->blend_more[k - 1][dir]
+          = blend_piece(t, t->sprites.blend_mask_more[k - 1], draw->blender,
+                        dir, FALSE);
+      }
     }
   } else if (NULL != draw->blender) {
     /* Set up blending sprites. This only works in iso-view! */
@@ -5228,6 +5344,103 @@ static int fill_city_overlays_sprite_array(const struct tileset *t,
   return sprs - saved_sprs;
 }
 
+/************************************************************************//**
+  Overhead blending: which of the tileset's blend masks the edge between
+  ptile and its cardinal neighbour tile1 uses. Both tiles of an edge get the
+  same one, so the fades from either side meet.
+****************************************************************************/
+static int blend_edge_mask(const struct tile *ptile, const struct tile *tile1,
+                           enum direction8 dir, int num_masks)
+{
+  /* The edge is known by its west or north tile and its direction. */
+  const struct tile *first
+    = (dir == DIR8_EAST || dir == DIR8_SOUTH) ? ptile : tile1;
+  unsigned int h = (unsigned int) tile_index(first) * 2
+                   + (dir == DIR8_EAST || dir == DIR8_WEST ? 0 : 1);
+
+  h *= 2654435761u;
+
+  return (h >> 16) % num_masks;
+}
+
+/************************************************************************//**
+  The variant of a terrain's blending layer drawn on ptile (as
+  fill_terrain_sprite_array() picks it), or -1 when the layer has no plain
+  variants.
+****************************************************************************/
+static int blend_variant_of(const struct drawing_data *draw,
+                            const struct tile *ptile)
+{
+  const struct drawing_layer *dlp = &draw->layer[draw->blending - 1];
+  int count = sprite_vector_size(&dlp->base);
+
+  if (dlp->sprite_type != CELL_WHOLE || dlp->match_style != MATCH_NONE
+      || dlp->is_tall || count < 2) {
+    return -1;
+  }
+
+  return fc_randomly(tile_index(ptile) % 32000, count);
+}
+
+/************************************************************************//**
+  Overhead blending between two variants of one terrain, with
+  t.blend_mask_same: tile1's variant fades into ptile along their shared
+  edge or corner, so the texture does not stop dead at the tile edge. A
+  corner is left to the edges when a neighbour beside it shows the same
+  variant.
+****************************************************************************/
+static int fill_blend_variant(const struct tileset *t,
+                              struct drawn_sprite *sprs,
+                              const struct tile *ptile,
+                              const struct tile *tile1,
+                              const struct terrain *pterrain,
+                              enum direction8 dir8)
+{
+  struct drawn_sprite *saved_sprs = sprs;
+  struct drawing_data *draw = t->sprites.drawing[terrain_index(pterrain)];
+  struct sprite **piece;
+  int v, v1, x, y, w, h;
+
+  if (NULL == t->sprites.blend_mask_same || draw->blending <= 0) {
+    return 0;
+  }
+  v = blend_variant_of(draw, ptile);
+  v1 = blend_variant_of(draw, tile1);
+  if (v < 0 || v1 == v) {
+    return 0;
+  }
+  if (!is_cardinal_dir(dir8)) {
+    enum direction8 side[2] = { dir_cw(dir8), dir_ccw(dir8) };
+    int i;
+
+    for (i = 0; i < 2; i++) {
+      struct tile *beside = mapstep(&(wld.map), ptile, side[i]);
+
+      if (beside != NULL && tile_terrain(beside) == pterrain
+          && blend_variant_of(draw, beside) == v1) {
+        return 0;
+      }
+    }
+  }
+
+  if (NULL == draw->blend_variant) {
+    draw->blend_variants
+      = sprite_vector_size(&draw->layer[draw->blending - 1].base);
+    draw->blend_variant = fc_calloc(draw->blend_variants * 8,
+                                    sizeof(*draw->blend_variant));
+  }
+  piece = &draw->blend_variant[v1 * 8 + dir8];
+  if (NULL == *piece) {
+    *piece = blend_piece(t, t->sprites.blend_mask_same,
+                         draw->layer[draw->blending - 1].base.p[v1], dir8,
+                         TRUE);
+  }
+  blend_rect(t, dir8, TRUE, &x, &y, &w, &h);
+  ADD_SPRITE(*piece, TRUE, FULL_TILE_X_OFFSET + x, FULL_TILE_Y_OFFSET + y);
+
+  return sprs - saved_sprs;
+}
+
 /************************************************************************//**
   Helper function for fill_terrain_sprite_layer.
   Fill in the sprite array for blended terrain.
@@ -5260,8 +5473,11 @@ static int fill_terrain_sprite_blending(const struct tileset *t,
 
       if (!tile1
           || client_tile_get_known(tile1) == TILE_UNKNOWN
-          || NULL == other
-          || pterrain == other) {
+          || NULL == other) {
+        continue;
+      }
+      if (pterrain == other) {
+        sprs += fill_blend_variant(t, sprs, ptile, tile1, pterrain, dir8);
         continue;
       }
       odraw = t->sprites.drawing[terrain_index(other)];
@@ -5274,6 +5490,14 @@ static int fill_terrain_sprite_blending(const struct tileset *t,
               || tterrain_near[dir_ccw(dir8)] == other)) {
         continue;
       }
+      if (is_cardinal_dir(dir8) && t->num_blend_masks > 1) {
+        int k = blend_edge_mask(ptile, tile1, dir8, t->num_blend_masks);
+
+        if (k > 0 && NULL != odraw->blend_more[k - 1][dir8]) {
+          ADD_SPRITE_FULL(odraw->blend_more[k - 1][dir8]);
+          continue;
+        }
+      }
       ADD_SPRITE_FULL(odraw->blend[dir8]);
     }
 
