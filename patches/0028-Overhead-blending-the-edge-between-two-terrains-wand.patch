-     * transparent there rather than leaving the blender unmasked. */
-    const int W = t->normal_tile_width;
-    const int H = t->normal_tile_height;
+     * transparent there rather than leaving the blender unmasked. The
+     * edges are also cut through t.blend_mask_2 and up, if the tileset has
