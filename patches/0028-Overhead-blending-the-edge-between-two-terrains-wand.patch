   SET_SPRITE(arrow[ARROW_PLUS], "s.plus");
   SET_SPRITE(arrow[ARROW_MINUS], "s.minus");
+  t->num_blend_masks = 0;
+  memset(t->sprites.blend_mask_more, 0, sizeof(t->sprites.blend_mask_more));
+  t->sprites.blend_mask = NULL;
+  t->sprites.blend_mask_same = NULL;
   if (t->type == TS_ISOMETRIC) {
     SET_SPRITE(dither_tile, "t.dither_tile");
   } else if (t->hex_width == 0 && t->hex_height == 0) {
-    /* Blending in overhead view: the tileset's own soft mask, if any. */
+    /* Blending in overhead view: the tileset's own soft mask, if any,
+     * more masks to pick from per edge, and a mask for two variants of
+     * one terrain. */
     SET_SPRITE_OPT(blend_mask, "t.blend_mask");
+    if (!blend_mask_fits(t, t->sprites.blend_mask, "t.blend_mask")) {
+      t->sprites.blend_mask = NULL;
+    }
     if (t->sprites.blend_mask != NULL) {
-      int mw, mh;
-
-      /* A scaled tileset (the Qt client's zoom) rounds the mask and the
-       * tile size separately, so allow a pixel per tile. */
-      get_sprite_dimensions(t->sprites.blend_mask, &mw, &mh);
-      if (abs(mw - 3 * t->normal_tile_width) > 3
-          || abs(mh - 3 * t->normal_tile_height) > 3) {
-        log_error("Tileset \"%s\": t.blend_mask is %dx%d, not 3x3 tiles "
-                  "(%dx%d); no blending in overhead view.",
-                  tileset_name_get(t), mw, mh,
-                  3 * t->normal_tile_width, 3 * t->normal_tile_height);
-        t->sprites.blend_mask = NULL;
+      int k;
+
+      t->num_blend_masks = 1;
+      for (k = 2; k <= MAX_BLEND_MASKS; k++) {
+        char tag[32];
+        struct sprite *more;
+
+        fc_snprintf(tag, sizeof(tag), "t.blend_mask_%d", k);
+        more = load_sprite(t, tag, TRUE, TRUE, FALSE);
+        if (!blend_mask_fits(t, more, tag)) {
+          break;
