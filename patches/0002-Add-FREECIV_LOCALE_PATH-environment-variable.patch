From 5e65e6b99f5fdb1f3c2051de68ad23fa63ffeac1 Mon Sep 17 00:00:00 2001
From: John O'Dell <johncodell14@gmail.com>
Date: Fri, 16 Oct 2026 07:33:34 -0500
Subject: [PATCH 2/2] Add FREECIV_LOCALE_PATH environment variable

Relocatable installations such as a macOS .app bundle cannot know the
locale directory at compile time. Like FREECIV_DATA_PATH for data files,
FREECIV_LOCALE_PATH overrides the built-in LOCALEDIR in get_locale_dir().
Documented in the client and server man pages.

---
 doc/man/freeciv-client.6.in |  5 +++++
 doc/man/freeciv-server.6.in |  5 +++++
 utility/fcintl.c            | 12 ++++++++++++
 3 files changed, 22 insertions(+)

diff --git a/doc/man/freeciv-client.6.in b/doc/man/freeciv-client.6.in
index 3c5327e..1cc46c3 100644
--- a/doc/man/freeciv-client.6.in
+++ b/doc/man/freeciv-client.6.in
@@ -278,6 +278,11 @@ on the specific client; most clients default to UTF-8.
 Sets the local character encoding (used for the command line and terminal
 output). The default is inferred from other aspects of the environment.
 .TP
+.BI FREECIV_LOCALE_PATH
+Directory containing the compiled message catalogs (the "locale" directory).
+Overrides the directory chosen when Freeciv was built; useful for
+relocatable installations.
+.TP
 .BI FREECIV_MULTICAST_GROUP
 Sets the multicast group (for the LAN tab).
 .TP
diff --git a/doc/man/freeciv-server.6.in b/doc/man/freeciv-server.6.in
index 356625e..2580570 100644
--- a/doc/man/freeciv-server.6.in
+++ b/doc/man/freeciv-server.6.in
@@ -343,6 +343,11 @@ encoding should not be visible at any interface. Defaults to UTF-8.
 Sets the local character encoding (used for the command line and terminal
 output). The default is inferred from other aspects of the environment.
 .TP
+.BI FREECIV_LOCALE_PATH
+Directory containing the compiled message catalogs (the "locale" directory).
+Overrides the directory chosen when Freeciv was built; useful for
+relocatable installations.
+.TP
 .BI FREECIV_MULTICAST_GROUP
 Sets the multicast group (for the LAN tab).
 .TP
diff --git a/utility/fcintl.c b/utility/fcintl.c
index 813eb12..b53d76b 100644
--- a/utility/fcintl.c
+++ b/utility/fcintl.c
@@ -15,6 +15,7 @@
 #include <fc_config.h>
 #endif
 
+#include <stdlib.h>
 #include <string.h>
 
 #ifdef HAVE_UNISTD_H
@@ -23,6 +24,7 @@
 
 /* utility */
 #include "mem.h"
+#include "support.h"
 
 #include "fcintl.h"
 
@@ -115,6 +117,16 @@ const char *get_locale_dir(void)
 
   if (!ldbuf_init) {
     bool absolute = FALSE;
+    const char *env_dir = getenv("FREECIV_LOCALE_PATH");
+
+    if (env_dir != NULL && env_dir[0] != '\0') {
+      /* Relocatable installations (e.g. a macOS .app bundle) can't
+       * know the locale directory at compile time. */
+      sz_strlcpy(buf, env_dir);
+      ldbuf_init = TRUE;
+
+      return buf;
+    }
 
     /* FIXME: On Windows, also something starting with the drive,
      *        e.g., "C:\", can be absolute path. Paths like that
