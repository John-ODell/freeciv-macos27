+/***********************************************************************//**
+  Scroll to the oldest message that is not visited yet
+***************************************************************************/
+void messagewdg::show_unvisited()
+{
+  int i, num = meswin_get_num_messages();
+
+  for (i = 0; i < num; i++) {
+    const struct message *pmsg = meswin_get_message(i);
+
+    if (pmsg != nullptr && !pmsg->visited && pmsg->location_ok
+        && mesg_table->item(i, 0) != nullptr) {
+      mesg_table->scrollToItem(mesg_table->item(i, 0),
+                               QAbstractItemView::PositionAtTop);
+      return;
+    }
+  }
+  mesg_table->scrollToBottom();
+}
