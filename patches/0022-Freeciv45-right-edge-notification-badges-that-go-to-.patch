+/************************************************************************//**
+  The kind of a message, for its badge's icon and the theme: city,
+  diplomacy, military, research or other
+****************************************************************************/
+static const char *badge_kind(enum event_type event)
+{
+  switch (get_event_section(event)) {
+  case E_S_ADVANCE:
+    return "research";
+  case E_S_BUILD:
+  case E_S_CITY:
+  case E_S_WONDER:
+    return "city";
+  case E_S_D_ME:
+  case E_S_D_THEM:
+  case E_S_TREATY:
+    return "diplomacy";
+  case E_S_UNIT:
+    return "military";
+  default:
+    return "other";
+  }
+}
+
+/************************************************************************//**
+  The theme icon for a kind of message
+****************************************************************************/
+static QString badge_icon(const QString &kind)
+{
+  if (kind == "research") {
+    return "research";
+  } else if (kind == "city") {
+    return "cities";
+  } else if (kind == "diplomacy") {
+    return "nations";
+  } else if (kind == "military") {
+    return "units";
+  }
+
+  return "flag";
+}
+
+/************************************************************************//**
+  A round badge; resource.qss draws the circle. Hidden until it has a
+  message.
+****************************************************************************/
+edge_badge::edge_badge(QWidget *parent) : QToolButton(parent)
+{
+  msg = nullptr;
+  setIconSize(QSize(BADGE_ICON, BADGE_ICON));
+  setFixedSize(BADGE_SIZE, BADGE_SIZE);
+  setFocusPolicy(Qt::NoFocus);
+  setCursor(Qt::PointingHandCursor);
+  connect(this, &QToolButton::clicked, this, &edge_badge::visit);
+  hide();
+}
+
+/************************************************************************//**
+  Show one message: its kind's icon, its text as the tooltip
+****************************************************************************/
+void edge_badge::set_message(const struct message *pmsg)
+{
+  QString kind = badge_kind(pmsg->event);
+
+  msg = pmsg;
+  setText(QString());
+  setToolButtonStyle(Qt::ToolButtonIconOnly);
+  setIcon(fc_icons::instance()->get_icon(badge_icon(kind)));
+  setToolTip(QString(pmsg->descr).trimmed());
+  if (property("kind").toString() != kind) {
+    setProperty("kind", kind);
+    style()->unpolish(this);
+    style()->polish(this);
+  }
+  show();
+}
+
+/************************************************************************//**
+  Show "+N" for the messages that have no badge of their own
+****************************************************************************/
+void edge_badge::set_more(int count)
+{
+  msg = nullptr;
+  setIcon(QIcon());
+  setToolButtonStyle(Qt::ToolButtonTextOnly);
+  setText(QString("+%1").arg(count));
+  // TRANS: tooltip of the Freeciv45 "+N" badge on the right edge
+  setToolTip(QString(PL_("%1 more message; opens the messages log",
+                         "%1 more messages; opens the messages log",
+                         count)).arg(count));
+  if (property("kind").toString() != "more") {
+    setProperty("kind", "more");
+    style()->unpolish(this);
+    style()->polish(this);
+  }
+  show();
+}
+
+/************************************************************************//**
+  A click: go to the message's city or tile and mark it visited, which
+  removes the badge; "+N" opens the messages log at the oldest message
+  without a badge
+****************************************************************************/
+void edge_badge::visit()
+{
+  const struct message *target = msg;
+  int num = meswin_get_num_messages();
+  int i;
+
+  if (target == nullptr) {
+    if (city_overlay_is_open()) {
+      gui()->cityoverlay_wdg->close_overlay();
+    }
+    side_show_map(true);
+    if (gui()->infotab != nullptr) {
+      gui()->infotab->show();
+      if (gui()->infotab->chat_maximized) {
+        gui()->infotab->restore_chat();
+      }
+      gui()->infotab->msgwdg->show_unvisited();
+    }
+    return;
+  }
+
+  // The list may have changed since the badge was set
+  for (i = 0; i < num; i++) {
+    if (meswin_get_message(i) == target) {
+      break;
+    }
+  }
+  if (i < num) {
+    struct city *pcity = (target->city_ok ? tile_city(target->tile)
+                                          : nullptr);
+
+    side_show_map(true);
+    if (pcity != nullptr && city_owner(pcity) == client_player()
+        && QString(badge_kind(target->event)) == "city") {
+      // Opens the city overlay
+      meswin_popup_city(i);
+    } else {
+      if (city_overlay_is_open()) {
+        gui()->cityoverlay_wdg->close_overlay();
+      }
+      meswin_goto(i);
+    }
+    meswin_set_visited_state(i, true);
+  }
+  // Redraws the messages log in italics and the badges without this one
+  real_meswin_dialog_update(nullptr);
+}
+
