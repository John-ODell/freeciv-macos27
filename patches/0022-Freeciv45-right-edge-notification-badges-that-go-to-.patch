+/************************************************************************//**
+  Fill the badges from the message list: one per unvisited message with a
+  place to go, newest first, as many as fit below the buttons up to eight,
+  then "+N" for the rest
+****************************************************************************/
+void edge_column::update_badges()
+{
+  QList<const struct message *> waiting;
+  int num = meswin_get_num_messages();
+  int room, shown, i;
+
+  for (i = num - 1; i >= 0; i--) {
+    const struct message *pmsg = meswin_get_message(i);
+
+    if (pmsg != nullptr && !pmsg->visited && pmsg->location_ok) {
+      waiting.append(pmsg);
+    }
+  }
+
+  // The room under the buttons, in badges, counting the "+N" one
+  room = MAX_BADGES + 1;
+  if (more_btn->geometry().isValid() && height() > 0) {
+    int top = more_btn->geometry().bottom() + 1 + BADGE_GAP
+              + layout()->spacing();
+
+    room = qBound(0, (height() - top + BADGE_SPACING)
+                      / (BADGE_SIZE + BADGE_SPACING), MAX_BADGES + 1);
+  }
+  if (waiting.size() <= qMin(room, MAX_BADGES)) {
+    shown = waiting.size();
+  } else {
+    shown = qMax(0, qMin(room - 1, MAX_BADGES));
+  }
+
+  for (i = 0; i < MAX_BADGES; i++) {
+    if (i < shown) {
+      badges[i]->set_message(waiting[i]);
+    } else {
+      badges[i]->hide();
+    }
+  }
+  if (shown < waiting.size() && room > 0) {
+    more_badge->set_more(waiting.size() - shown);
+  } else {
+    more_badge->hide();
+  }
+}
+
+/************************************************************************//**
+  As many badges as fit: the window's height decides
+****************************************************************************/
+void edge_column::resizeEvent(QResizeEvent *event)
+{
+  QFrame::resizeEvent(event);
+  update_badges();
 }
 
