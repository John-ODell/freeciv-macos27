+/**********************************************************************//**
+  The section of the event list the event belongs to, as the message
+  options group them
+**************************************************************************/
+enum event_section_n get_event_section(enum event_type event)
+{
+  fc_assert_ret_val(event_type_is_valid(event), E_S_XYZZY);
+
+  if (events[event_to_index[event]].event == event) {
+    return events[event_to_index[event]].esn;
+  }
+  log_error("unknown event %d", event);
+
+  return E_S_XYZZY;
+}
