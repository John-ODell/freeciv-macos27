diff --git a/client/goto.c b/client/goto.c
index a423a4d..273b4ad 100644
--- a/client/goto.c
+++ b/client/goto.c
@@ -907,6 +907,16 @@ static void goto_fill_parameter_base(struct pf_parameter *parameter,
   }
 }
 
+/************************************************************************//**
+  The client goto's PF parameter for the unit, for drawing the tiles it
+  reaches this turn (Freeciv45, issue 232)
+****************************************************************************/
+void fill_move_range_parameter(struct pf_parameter *parameter,
+                               const struct unit *punit)
+{
+  goto_fill_parameter_base(parameter, punit);
+}
+
 /************************************************************************//**
   Fill the PF parameter with the correct client-goto values.
   The storage behind "connect_speed" must remain valid for the lifetime
