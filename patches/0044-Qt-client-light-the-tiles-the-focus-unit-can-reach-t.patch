+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+   GNU General Public License for more details.
+***********************************************************************/
+
+#ifdef HAVE_CONFIG_H
+#include <fc_config.h>
+#endif
+
+// Qt
+#include <QElapsedTimer>
+#include <QPainter>
+#include <QPolygonF>
+#include <QSet>
+
+// common
+#include "game.h"
+#include "map.h"
+#include "player.h"
+#include "tile.h"
+#include "unit.h"
+#include "unitlist.h"
+
+// common/aicore
+#include "path_finding.h"
+
+// client
+#include "client_main.h"
+#include "control.h"
+#include "goto.h"
+#include "mapview_common.h"
+#include "options.h"
+#include "tilespec.h"
+#include "zoom.h"
+
+// gui-qt
+#include "cityoverlay.h"
+#include "fc_client.h"
+#include "moverange.h"
+
+// Recompute this often even when nothing in the key changed, for zones of
+// control and borders that other players' moves change
+static const int RECHECK_MS = 2000;
+
+static struct {
+  int unit_id;
+  int tile_index;
+  int moves_left;
+  int turn;
+  bool shown;
+  bool hidden;
+  QSet<int> reach;
+  QElapsedTimer since;
+} range = { -1, -1, -1, -1, false, false, QSet<int>(), QElapsedTimer() };
+
+/************************************************************************//**
+  The unit whose range is shown: the head focus unit, own, while orders
+  can be given this turn and the panels are on
+****************************************************************************/
+static struct unit *range_unit(void)
+{
+  struct unit *punit = head_of_units_in_focus();
+
+  if (punit == nullptr || !gui_options.gui_qt_freeciv45_panels
+      || !can_client_issue_orders()
+      || unit_owner(punit) != client_player()
+      || client_player()->phase_done
+      || city_overlay_is_open()) {
+    return nullptr;
+  }
+
+  return punit;
+}
+
+/************************************************************************//**
+  The tiles the unit reaches this turn, by the client goto's own path
+  finding: its moves left, terrain, zones of control, borders and the
+  tiles it knows
+****************************************************************************/
+static QSet<int> reachable(const struct unit *punit)
+{
+  QSet<int> out;
+  struct pf_parameter parameter;
+  struct pf_map *pfm;
+
+  if (punit->moves_left <= 0) {
+    return out;
+  }
+  fill_move_range_parameter(&parameter, punit);
+  pfm = pf_map_new(&parameter);
+  pf_map_positions_iterate(pfm, pos, TRUE) {
+    /* Positions come roughly in order of cost; well past this turn's moves
+     * there are no more to find. A tile reached on the last move point
+     * counts to path finding as turn 1 with full moves, so test the moves
+     * spent instead of the turn. */
+    if (pos.turn > 2) {
+      break;
+    }
+    // Unknown tiles stay black
+    if (pos.total_MC <= (unsigned) punit->moves_left
+        && tile_get_known(pos.tile, client_player()) != TILE_UNKNOWN) {
+      out.insert(tile_index(pos.tile));
+    }
+  } pf_map_positions_iterate_end;
+  pf_map_destroy(pfm);
+
+  return out;
+}
+
+/************************************************************************//**
+  Work the range out again when the focus unit, its tile, its moves or the
+  turn changed, or now and then for other players' moves; repaint the map
+  when the tiles changed. Called from the map's timer and after a click.
+****************************************************************************/
+void move_range_check(void)
+{
+  struct unit *punit = range_unit();
+  int id = (punit != nullptr ? punit->id : -1);
+  int tile = (punit != nullptr ? tile_index(unit_tile(punit)) : -1);
+  int moves = (punit != nullptr ? punit->moves_left : -1);
+  bool changed = (id != range.unit_id || tile != range.tile_index
+                  || moves != range.moves_left
+                  || game.info.turn != range.turn);
+  QSet<int> reach;
+
+  if (id != range.unit_id || game.info.turn != range.turn) {
+    // A new unit or a new turn shows the range again after a cancel
+    range.hidden = false;
+  }
+  if (!changed && range.since.isValid()
+      && range.since.elapsed() < RECHECK_MS) {
+    return;
+  }
+  range.unit_id = id;
+  range.tile_index = tile;
+  range.moves_left = moves;
+  range.turn = game.info.turn;
+  range.since.start();
+  if (punit != nullptr && !range.hidden) {
+    reach = reachable(punit);
+  }
+  if (reach != range.reach) {
+    range.reach = reach;
+    if (gui() != nullptr && gui()->mapview_wdg != nullptr) {
+      gui()->mapview_wdg->update();
+    }
+  }
+}
+
+/************************************************************************//**
+  A click on the focus unit with no order being given shows or hides its
+  range; a click that cancels an order hides it
+****************************************************************************/
+void move_range_toggle(bool hide_only)
+{
+  range.hidden = hide_only || !range.hidden;
+  range.since.invalidate();
+  move_range_check();
+}
+
+/************************************************************************//**
+  How many tiles are lit, and whether a click hid the range
+****************************************************************************/
+int move_range_size(void)
+{
+  return range.reach.size();
+}
+
+bool move_range_hidden(void)
+{
+  return range.hidden;
+}
+
+/************************************************************************//**
+  Light the tiles on the map: a faint fill, so terrain and resources show
+  through, and a line along the range's outer edge. The painter is in map
+  canvas pixels.
+****************************************************************************/
+void move_range_paint(QPainter *painter)
+{
+  float w, h;
+  bool iso;
+  QPen edge;
+  static const enum direction8 sides[4] = {
+    DIR8_NORTH, DIR8_EAST, DIR8_SOUTH, DIR8_WEST
+  };
+
+  if (range.reach.isEmpty() || tileset == nullptr) {
+    return;
+  }
+  w = tileset_tile_width(tileset) * map_zoom;
+  h = tileset_tile_height(tileset) * map_zoom;
+  iso = tileset_is_isometric(tileset);
+  edge = QPen(QColor(255, 236, 160, 230), qMax(2.0f, w / 64.0f));
+  edge.setCapStyle(Qt::RoundCap);
+
+  painter->save();
+  painter->setRenderHint(QPainter::Antialiasing);
+  foreach (int idx, range.reach) {
+    struct tile *ptile = index_to_tile(&(wld.map), idx);
+    float cx, cy;
+    QPolygonF shape;
+    QPointF centre;
+
+    if (ptile == nullptr || !tile_to_canvas_pos(&cx, &cy, map_zoom, ptile)) {
+      continue;
+    }
+    if (iso) {
+      shape << QPointF(cx + w / 2, cy) << QPointF(cx + w, cy + h / 2)
+            << QPointF(cx + w / 2, cy + h) << QPointF(cx, cy + h / 2);
+    } else {
+      shape << QPointF(cx, cy) << QPointF(cx + w, cy)
+            << QPointF(cx + w, cy + h) << QPointF(cx, cy + h);
+    }
+    centre = QPointF(cx + w / 2, cy + h / 2);
+    painter->setPen(Qt::NoPen);
+    painter->setBrush(QColor(255, 248, 220, 46));
+    painter->drawPolygon(shape);
+
+    // The side of the tile that faces a neighbour out of range
+    painter->setPen(edge);
+    for (enum direction8 dir : sides) {
+      struct tile *next = mapstep(&(wld.map), ptile, dir);
+      float gx, gy;
+      int best = 0;
+      qreal best_dot = -1e9;
+
+      if (next != nullptr && range.reach.contains(tile_index(next))) {
+        continue;
+      }
+      map_to_gui_vector(tileset, map_zoom, &gx, &gy,
+                        DIR_DX[dir], DIR_DY[dir]);
+      for (int i = 0; i < 4; i++) {
+        QPointF mid = (shape[i] + shape[(i + 1) % 4]) / 2 - centre;
+        qreal dot = mid.x() * gx + mid.y() * gy;
+
+        if (dot > best_dot) {
+          best_dot = dot;
+          best = i;
+        }
+      }
+      painter->drawLine(shape[best], shape[(best + 1) % 4]);
+    }
+  }
+  painter->restore();
+}
