+#include "moverange.h"
 #include "qtg_cxxside.h"
 #include "shortcuts.h"
 
@@ -535,7 +538,45 @@ void map_view::mousePressEvent(QMouseEvent *event)
 
   pan_armed = false;
   panning = false;
+  range_press_tile = nullptr;
+  range_cancel = false;
   pan_autocenter = gui_options.auto_center_on_unit;
+
+  /* Freeciv45: a left click on the focus unit's own tile cancels the order
+   * being given, goto line and all, and the unit stays selected; with no
+   * order it shows or hides the unit's range on release, in place of the
+   * stack's selection popup (the unit bar's chips select tile mates). */
+  if (event->button() == Qt::LeftButton
+      && event->modifiers() == Qt::NoModifier
+      && gui_options.gui_qt_freeciv45_panels
+      && !gui()->menu_bar->delayed_order
+      && !gui()->menu_bar->quick_airlifting
+      && !gui()->rallies.hover_city && !gui()->rallies.hover_tile
+      && !gui()->trade_gen.hover_city) {
+    QPoint pos = map_canvas_pos(event->pos());
+    struct tile *ptile = canvas_pos_to_tile(pos.x(), pos.y(), map_zoom);
+    bool on_focus = false;
+
+    unit_list_iterate(get_units_in_focus(), punit) {
+      if (ptile != nullptr && unit_tile(punit) == ptile) {
+        on_focus = true;
+      }
+    } unit_list_iterate_end;
+    if (on_focus && order_pending) {
+      clear_hover_state();
+      exit_goto_state();
+      move_range_toggle(true);
+      range_cancel = true;
+      return;
+    }
+    // A click on an own city still opens it
+    if (on_focus && (tile_city(ptile) == nullptr
+                     || !can_player_see_city_internals(client_player(),
+                                                       tile_city(ptile)))) {
+      range_press_tile = ptile;
+    }
+  }
+
   shortcut_pressed(0);
 
   /* Keyboardless goto arms on a left press anywhere while a unit is in
@@ -600,6 +641,26 @@ void map_view::mouseReleaseEvent(QMouseEvent *event)
     return;
   }
   pan_armed = false;
+  if (event->button() == Qt::LeftButton && range_cancel) {
+    // The press cancelled an order: nothing more to do
+    range_cancel = false;
+    return;
+  }
+  if (event->button() == Qt::LeftButton && range_press_tile != nullptr
+      && !keyboardless_goto_active) {
+    QPoint pos = map_canvas_pos(event->pos());
+    struct tile *ptile = canvas_pos_to_tile(pos.x(), pos.y(), map_zoom);
+
+    if (ptile == range_press_tile) {
+      // A click on the focus unit: its range, and no popup or order
+      range_press_tile = nullptr;
+      gui_options.auto_center_on_unit = stored_autocenter;
+      release_goto_button(pos.x(), pos.y());
+      move_range_toggle(false);
+      return;
+    }
+  }
+  range_press_tile = nullptr;
   shortcut_released(event->button());
 }
 
