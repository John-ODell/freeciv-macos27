-roles         = "Ferryboat", "FerryStartUnit"
+roles         = "Ferryboat", "FerryStartUnit", "BarbarianBoatTech"
 helptext      = _("\
 The Caravel is a sailing ship that can enter\
  any ocean tile, but have to spend at least every third\
@@ -2722,7 +2722,7 @@ uk_gold       = 0
 tp_defense    = "Alight"
 cargo         = "Land", "Small Land", "Big Land", "Merchant"
 flags         = "Shield2Gold", "ShieldToGold", "BadCityDefender", "HasNoZOC", "Naval"
-roles         = "Ferryboat", "FerryStartUnit", "BarbarianBoat"
+roles         = "Ferryboat", "FerryStartUnit", "BarbarianBoatTech"
