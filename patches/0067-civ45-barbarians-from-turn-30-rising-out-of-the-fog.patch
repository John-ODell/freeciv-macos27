From 69dc1aa6c794f047e4d62f527103961783f3e896 Mon Sep 17 00:00:00 2001
From: John O'Dell <johncodell14@gmail.com>
Date: Tue, 27 Oct 2026 19:22:08 -0500
Subject: [PATCH] civ45: barbarians from turn 30, rising out of the fog

Barbarians could not appear before turn 120, and on land they could only
rise on tiles the victim had explored, so an early game had none. A new
server setting, barbsfromfog (off by default), lets a land uprising start
on any tile the victim does not see right now. civ45 turns it on, starts
barbarians at turn 30 at the HORDES rate, raids with Warriors, Archers and
Horsemen, and ships them in Triremes until Caravels and Galleons are
known. Issue 345.
---
 common/game.c            |  1 +
 common/game.h            |  3 +++
 data/civ45/game.ruleset  |  7 ++++++-
 data/civ45/units.ruleset | 14 +++++++-------
 server/barbarian.c       | 10 +++++++---
 server/settings.c        | 10 ++++++++++
 6 files changed, 34 insertions(+), 11 deletions(-)

diff --git a/common/game.c b/common/game.c
index 86338d7..c277578 100644
--- a/common/game.c
+++ b/common/game.c
@@ -386,6 +386,7 @@ static void game_defaults(bool keep_ruleset_value)
     game.server.netwait           = GAME_DEFAULT_NETWAIT;
     game.server.occupychance      = GAME_DEFAULT_OCCUPYCHANCE;
     game.server.onsetbarbarian    = GAME_DEFAULT_ONSETBARBARIAN;
+    game.server.barbsfromfog      = GAME_DEFAULT_BARBSFROMFOG;
     game.server.additional_phase_seconds = 0;
     game.server.phase_mode_stored = GAME_DEFAULT_PHASE_MODE;
     game.server.pingtime          = GAME_DEFAULT_PINGTIME;
diff --git a/common/game.h b/common/game.h
index 1250334..56a4b3a 100644
--- a/common/game.h
+++ b/common/game.h
@@ -173,6 +173,7 @@ struct civ_game {
       int num_phases;
       int occupychance;
       int onsetbarbarian;
+      bool barbsfromfog;
       int pingtime;
       int pingtimeout;
       bool ip_hide;
@@ -664,6 +665,8 @@ static inline bool is_ruleset_compat_mode(void)
 #define GAME_MIN_ONSETBARBARIAN      1
 #define GAME_MAX_ONSETBARBARIAN      GAME_MAX_END_TURN
 
+#define GAME_DEFAULT_BARBSFROMFOG    FALSE
+
 #define GAME_DEFAULT_OCCUPYCHANCE    0
 #define GAME_MIN_OCCUPYCHANCE        0
 #define GAME_MAX_OCCUPYCHANCE        100
diff --git a/data/civ45/game.ruleset b/data/civ45/game.ruleset
index 40dd6e5..e9399b8 100644
--- a/data/civ45/game.ruleset
+++ b/data/civ45/game.ruleset
@@ -928,6 +928,9 @@ colorlist =
 ; AIs play at Normal, not the server's Easy, at which they allied into one bloc that never fought (issue 159);
 ; the fork's server also gives this level to the AIs that aifill made before the ruleset loaded.
 ; Maps have 110 land tiles per player (John, 2026-10-18, issue 211), a little more room than the 100 before.
+; Barbarians from turn 30 at the "Raging hordes" rate, and on land they rise out of the fog ("barbsfromfog",
+; a fork setting), so new cities need guards (John, 2026-10-27, issue 345). Early raiders are Warriors, Archers
+; and Horsemen; their boats are Triremes until Caravels and Galleons are about.
 ;
 set =
     { "name", "value", "lock"
@@ -950,7 +953,9 @@ set =
       "foggedborders", "ENABLED", FALSE
       "restrictinfra", "ENABLED", FALSE
       "unreachableprotects", "DISABLED", FALSE
-      "onsetbarbs", 120, FALSE
+      "onsetbarbs", 30, FALSE
+      "barbarians", "HORDES", FALSE
+      "barbsfromfog", TRUE, FALSE
       "occupychance", 50, FALSE
       "techlossforgiveness", 0, FALSE
       "techlossrestore", 50, FALSE
