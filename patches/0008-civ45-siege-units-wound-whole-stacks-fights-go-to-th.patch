+conquer_city_2_blocked_by = "Capture Units", "Bombard", "Bombard 2",
                             "Explode Nuclear", "Nuke City", "Nuke Units",
                             "Attack", "Suicide Attack"
 
@@ -161,7 +166,7 @@ disband_unit_recover_max_range = 1
