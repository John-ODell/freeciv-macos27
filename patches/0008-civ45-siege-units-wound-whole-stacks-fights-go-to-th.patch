+[effect_action_success_move_cost_bombard_stack]
+type    = "Action_Success_Actor_Move_Cost"
+value   = 65535
+reqs    =
+    { "type", "name", "range", "present"
+      "Action", "Bombard 2", "Local", TRUE
+    }
+
 [effect_action_success_move_cost_from_non_native]
 type    = "Action_Success_Actor_Move_Cost"
 value   = 65535
@@ -5183,6 +5223,16 @@ reqs    =
       "Building", "Treuga Dei",           "World", TRUE
     }
 
+; Treuga Dei Casus Belli
+[effect_treuga_dei_casus_belli_bombard_stack]
+type    = "Casus_Belli_Success"
+value   = 1000
+reqs    =
+    { "type",     "name",                 "range", "survives"
+      "Action",   "Bombard 2",            "Local", FALSE
+      "Building", "Treuga Dei",           "World", TRUE
+    }
+
 ; Treuga Dei Casus Belli
 [effect_treuga_dei_casus_belli_explode_nuclear]
 type    = "Casus_Belli_Success"
