 ; action. The value 1 means that the targets must be on a tile adjacent to
@@ -333,6 +338,9 @@ ui_name_join_city = _("%sAdd to City%s")
 ; /* TRANS: _Bombard (100% chance of success). */
 ui_name_bombard = _("%sBombard%s")
 
+; /* TRANS: Bombard _Stack (100% chance of success). */
+ui_name_bombard_2 = _("Bombard %sStack%s")
+
 ; /* TRANS: Destroy _City (100% chance of success). */
 ui_name_destroy_city = _("Destroy %sCity%s")
 
@@ -1262,6 +1270,79 @@ target_reqs    =
       "CityTile",     "Center",  "Tile",  FALSE
     }
 
+; Siege collateral: a unit with the Collateral flag may bombard a tile that
+; holds two or more units. "Bombard 2" is Freeciv's non-lethal bombard, so it
+; wounds every unit on the tile and leaves each with at least 1 hit point.
+; Against a lone unit the siege unit attacks as usual. The four enablers mirror
+; the four "Bombard" enablers above (city or not, Treuga Dei or not) with the
+; Collateral flag and the two-or-more-units requirement.
+[actionenabler_bombard_stack_city]
+action = "Bombard 2"
+actor_reqs    =
+    { "type",         "name",        "range", "present"
+      "UnitFlag",     "Collateral",  "Local", TRUE
+      "UnitState",    "Transported", "Local", FALSE
+      "MinMoveFrags", "1",           "Local", TRUE
+      "DiplRel",      "War",         "Local", TRUE
+      "Building",     "Treuga Dei",  "World", FALSE
+    }
+target_reqs    =
+    { "type",             "name",    "range", "present"
+      "TerrainClass",     "Oceanic", "Tile",  FALSE
+      "DiplRelTileOther", "War",     "Local", TRUE
+      "MaxUnitsOnTile",   "1",       "Tile",  FALSE
+    }
+
+[actionenabler_bombard_stack_no_city]
+action = "Bombard 2"
+actor_reqs    =
+    { "type",         "name",        "range", "present"
+      "UnitFlag",     "Collateral",  "Local", TRUE
+      "UnitState",    "Transported", "Local", FALSE
+      "MinMoveFrags", "1",           "Local", TRUE
+      "DiplRel",      "War",         "Local", TRUE
+    }
+target_reqs    =
+    { "type",           "name",    "range", "present"
+      "TerrainClass",   "Oceanic", "Tile",  FALSE
+      "CityTile",       "Center",  "Tile",  FALSE
+      "MaxUnitsOnTile", "1",       "Tile",  FALSE
+    }
+
+[actionenabler_bombard_stack_city_despite_treuga_dei]
+action = "Bombard 2"
+actor_reqs    =
+    { "type",         "name",        "range", "present", "survives"
+      "UnitFlag",     "Collateral",  "Local", TRUE,      FALSE
+      "UnitState",    "Transported", "Local", FALSE,     FALSE
+      "MinMoveFrags", "1",           "Local", TRUE,      FALSE
+      "DiplRel",      "War",         "Local", TRUE,      FALSE
+      "Tech",         "Communism",   "World", TRUE,      TRUE
+    }
+target_reqs    =
+    { "type",             "name",    "range", "present"
+      "TerrainClass",     "Oceanic", "Tile",  FALSE
+      "DiplRelTileOther", "War",     "Local", TRUE
+      "MaxUnitsOnTile",   "1",       "Tile",  FALSE
+    }
+
+[actionenabler_bombard_stack_no_city_despite_treuga_dei]
+action = "Bombard 2"
+actor_reqs    =
+    { "type",         "name",        "range", "present", "survives"
+      "UnitFlag",     "Collateral",  "Local", TRUE,      FALSE
+      "UnitState",    "Transported", "Local", FALSE,     FALSE
+      "MinMoveFrags", "1",           "Local", TRUE,      FALSE
+      "DiplRel",      "War",         "Local", TRUE,      FALSE
+      "Tech",         "Communism",   "World", TRUE,      TRUE
+    }
+target_reqs    =
+    { "type",           "name",    "range", "present"
+      "TerrainClass",   "Oceanic", "Tile",  FALSE
+      "CityTile",       "Center",  "Tile",  FALSE
+      "MaxUnitsOnTile", "1",       "Tile",  FALSE
+    }
+
 [actionenabler_build_city_pioneer]
 action = "Found City"
 actor_reqs    =
diff --git a/data/civ45/effects.ruleset b/data/civ45/effects.ruleset
index abb010c..cf449a3 100644
--- a/data/civ45/effects.ruleset
+++ b/data/civ45/effects.ruleset
@@ -541,9 +541,40 @@ reqs    =
       "UnitType", "Nuclear", "Local"
     }
 
+; Combat is to the death: 0 rounds means the fight lasts until one side dies
+; (sandbox capped every fight at 15 rounds). A unit with the Withdraws flag
+; breaks off instead: its attack ends after 12 rounds for every 10 hit points
+; it has left (12, 24 or 36), whether or not anyone died. The cap is read for
+; the attacker only, so a Withdraws unit that is attacked fights to the death.
 [effect_combat_rounds_base]
 type    = "Combat_Rounds"
-value   = 15
+value   = 0
+
+[effect_combat_rounds_withdraws]
+type    = "Combat_Rounds"
+value   = 12
+reqs    =
+    { "type", "name", "range"
+      "UnitFlag", "Withdraws", "Local"
+    }
+
+[effect_combat_rounds_withdraws_20hp]
+type    = "Combat_Rounds"
+value   = 12
+reqs    =
+    { "type", "name", "range"
+      "UnitFlag", "Withdraws", "Local"
+      "MinHitPoints", "11", "Local"
+    }
+
+[effect_combat_rounds_withdraws_30hp]
+type    = "Combat_Rounds"
+value   = 12
+reqs    =
+    { "type", "name", "range"
+      "UnitFlag", "Withdraws", "Local"
+      "MinHitPoints", "21", "Local"
+    }
 
