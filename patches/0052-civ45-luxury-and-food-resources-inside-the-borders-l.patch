diff --git a/data/civ45/script.lua b/data/civ45/script.lua
index e23cb6b..1e513d7 100644
--- a/data/civ45/script.lua
+++ b/data/civ45/script.lua
@@ -1336,3 +1336,73 @@ function fc45_rel_city_destroyed(city, loser, destroyer)
   fc45_gp_set(fc45_gp_key("fc45_rel_", city.id), nil)
 end
 signal.connect("city_destroyed", "fc45_rel_city_destroyed")
+
+-- Resource happiness and health (notes/freeciv45/design/resources.md). Each kind of luxury or food resource
+-- inside a civ's borders puts its "<Resource> Supply" small wonder in the capital; the content, size and
+-- health effects are in effects.ruleset. Recomputed from the map every turn, so nothing is recorded.
+fc45_res_luxury = { "Gold", "Gems", "Silk", "Wine", "Spice", "Furs", "Ivory", "Whales" }
+fc45_res_food = { "Wheat", "Buffalo", "Fruit", "Pheasant", "Game", "Fish", "Oasis" }
+fc45_res_all = {}
+for _, r in ipairs(fc45_res_luxury) do fc45_res_all[#fc45_res_all + 1] = r end
+for _, r in ipairs(fc45_res_food) do fc45_res_all[#fc45_res_all + 1] = r end
+
+-- held[player id][resource] = true for every kind inside that player's borders.
+function fc45_res_held()
+  local held = {}
+  for t in whole_map_iterate() do
+    local o = t.owner
+    if o ~= nil then
+      for _, r in ipairs(fc45_res_all) do
+        if t:has_extra(r) then
+          held[o.id] = held[o.id] or {}
+          held[o.id][r] = true
+        end
+      end
+    end
+  end
+  return held
+end
+
+-- The record fc45_res_<R>_<player id> follows the borders, so gains and losses are told once; the marker
+-- follows the record into the capital, and a civ without one holds no markers until it has one again.
+function fc45_res_place(p, have)
+  local cap = p:primary_capital()
+  for _i, r in ipairs(fc45_res_all) do  -- not _, which would hide _()
+    local b = find.building_type(r .. " Supply")
+    local place = have[r] and cap ~= nil
+    local had = false
+    for c in p:cities_iterate() do
+      if c:has_building(b) then
+        if place and c.id == cap.id then had = true else edit.remove_building(c, b) end
+      end
+    end
+    if place and not had then edit.create_building(cap, b) end
+    local key = fc45_gp_key("fc45_res_" .. r .. "_", p.id)
+    if have[r] and rawget(_G, key) == nil then
+      fc45_gp_set(key, 1)
+      if fc45_res_is_food(r) then
+        notify.event(p, nil, E.SCRIPT, _("Your nation now has %s: every city can grow one size larger and resists plague better."), r)
+      else
+        notify.event(p, nil, E.SCRIPT, _("Your nation now has %s: 1 more content citizen in every city."), r)
+      end
+      log.normal("FC45RES turn %d %s gains %s", game.turn(), p.name, r)
+    elseif not have[r] and rawget(_G, key) ~= nil then
+      fc45_gp_set(key, nil)
+      notify.event(p, nil, E.SCRIPT, _("Your nation has lost its %s."), r)
+      log.normal("FC45RES turn %d %s loses %s", game.turn(), p.name, r)
+    end
+  end
+end
+
+function fc45_res_is_food(r)
+  for _, f in ipairs(fc45_res_food) do if f == r then return true end end
+  return false
+end
+
+function fc45_res_turn(turn, year)
+  local held = fc45_res_held()
+  for p in players_iterate() do
+    if fc45_is_civ(p) then fc45_res_place(p, held[p.id] or {}) end
+  end
+end
+signal.connect("turn_begin", "fc45_res_turn")
