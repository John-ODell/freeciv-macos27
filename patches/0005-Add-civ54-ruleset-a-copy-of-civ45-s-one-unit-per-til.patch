+")
+
+[building_womens_suffrage]
+name		= _("Women's Suffrage")
+genus		= "GreatWonder"
+reqs	=
+    { "type", "name", "range"
+      "Tech", "Conscription", "Player"
+    }
+graphic         = "b.womens_suffrage"
