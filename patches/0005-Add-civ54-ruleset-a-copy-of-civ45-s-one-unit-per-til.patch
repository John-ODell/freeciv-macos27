+-- ====================================================================
+-- civ54: one unit per tile
+--
+-- The "Unit Move" and "Transport Disembark" enablers in actions.ruleset
+-- refuse a voluntary move onto a tile that already holds a unit. The
+-- other ways a second unit can arrive on a tile are handled here:
+-- city production, start units, huts, barbarians, captures, airlifts,
+-- paradrops and unloading in port.
+--
+-- * A unit built in a city that already holds a unit is resolved at
+--   once: the better defender stays, the other one moves to the nearest
+--   free tile.
+-- * Every turn starts with a sweep of the map that does the same for any
+--   tile still holding more than one unit.
+--
+-- Not counted: units inside a transport, unit types with the
+-- "StacksAnywhere" flag (aircraft, helicopters, missiles), and types with
+-- the "StacksInPort" flag (ships) while they are on a city tile.
+-- Only functions are global here: the savegame stores global numbers,
+-- strings and game objects, so all state stays local.
+-- ====================================================================
+
+-- Squared distances. On a hex map the squared distance is the square of
+-- the hex distance, so 10 reaches 3 tiles and 50 reaches 7.
+local CIV54_NEAR_SQ_RADIUS = 10
+local CIV54_FAR_SQ_RADIUS = 50
+
+-- Relocations done by the unit_built handler since the last turn began,
+-- reported in the turn_begin log line. Local, so not saved; a reload
+-- only loses the count for one turn.
+local civ54_built_moved, civ54_built_stuck = 0, 0
+
+local function civ54_same_player(a, b)
+  return a ~= nil and b ~= nil and a.id == b.id
+end
+
+local function civ54_stack_exempt(unit, tile)
+  if unit:transporter() ~= nil then
+    return true
+  end
+  local utype = unit.utype
+  if utype:has_flag("StacksAnywhere") then
+    return true
+  end
+  if utype:has_flag("StacksInPort") and tile:city() ~= nil then
+    return true
+  end
+  return false
+end
+
+-- Units on the tile that count towards the limit.
+local function civ54_counted_units(tile)
+  local list = {}
+  for unit in tile:units_iterate() do
+    if not civ54_stack_exempt(unit, tile) then
+      list[#list + 1] = unit
+    end
+  end
+  return list
+end
+
+-- Which unit keeps the tile: the city owner's unit, then military over
+-- civilian, then the better defender role, then the dearer unit, then
+-- veterancy, then the older unit.
+local function civ54_rank(unit, city)
+  local utype = unit.utype
+  local rank = 0
+  if city ~= nil and civ54_same_player(unit.owner, city.owner) then
+    rank = rank + 1000000
+  end
+  if not utype:has_flag("NonMil") then
+    rank = rank + 100000
+  end
+  if utype:has_role("DefendGood") then
+    rank = rank + 20000
+  elseif utype:has_role("DefendOk") then
+    rank = rank + 10000
+  end
+  return rank + utype.build_cost * 10 + unit.veteran
+end
+
+local function civ54_sort_keepers(units, city)
+  table.sort(units, function(a, b)
+    local ra, rb = civ54_rank(a, city), civ54_rank(b, city)
+    if ra ~= rb then
+      return ra > rb
+    end
+    return a.id < b.id
+  end)
+end
+
+-- Free tiles for the unit around `from`, nearest first. Own or unowned
+-- tiles only, unless foreign_ok, in which case only foreign-owned tiles;
+-- the server's teleport check then refuses illegal ones (peace treaty
+-- territory, non-allied cities and units).
+local function civ54_candidates(unit, from, sq_radius, foreign_ok)
+  local list = {}
+  for tile in from:circle_iterate(sq_radius) do
+    if tile:num_units() == 0
+       and unit.utype:can_exist_at_tile(tile)
+       and not tile:has_extra("Hut") and not tile:has_extra("Hermit") then
+      local own = tile.owner == nil or civ54_same_player(tile.owner, unit.owner)
+      local city = tile:city()
+      local city_ok = city == nil or civ54_same_player(city.owner, unit.owner)
+      if (not foreign_ok and own and city_ok) or (foreign_ok and not own) then
+        list[#list + 1] = tile
+      end
+    end
+  end
+  table.sort(list, function(a, b)
+    local da, db = from:sq_distance(a), from:sq_distance(b)
+    if da ~= db then
+      return da < db
+    end
+    return a.id < b.id
+  end)
+  return list
+end
+
+-- Try each tile in turn. Returns the tile reached, or nil, plus whether
+-- the unit is still alive.
+local function civ54_try_tiles(unit, tiles)
+  for _, dest in ipairs(tiles) do
+    if not unit:teleport(dest) then
+      return nil, false
+    end
+    if unit.tile.id == dest.id then
+      return dest, true
+    end
+  end
+  return nil, true
+end
+
+-- Returns true if the unit was moved. Search order: own or unowned land
+-- within 3 tiles, then within 7 tiles, then foreign land within 3 tiles.
+local function civ54_relocate(unit)
+  local from = unit.tile
+  local passes = {
+    { CIV54_NEAR_SQ_RADIUS, false },
+    { CIV54_FAR_SQ_RADIUS, false },
+    { CIV54_NEAR_SQ_RADIUS, true },
+  }
+  local dest = nil
+  for _, pass in ipairs(passes) do
+    local alive
+    dest, alive = civ54_try_tiles(unit, civ54_candidates(unit, from, pass[1], pass[2]))
+    if not alive then
+      return false
+    end
+    if dest ~= nil then
+      break
+    end
+  end
+  if dest == nil then
+    return false
+  end
+  if unit.owner:is_human() then
+    notify.event(unit.owner, dest, E.UNIT_RELOCATED,
+                 _("One unit per tile: %s moved to %s."),
+                 unit:link_text(), dest:link_text())
+  end
+  return true
+end
+
+-- Keep the best unit on the tile, relocate the rest.
+-- Returns relocated, stuck.
+local function civ54_resolve_tile(tile)
+  local units = civ54_counted_units(tile)
+  if #units <= 1 then
+    return 0, 0
+  end
+  civ54_sort_keepers(units, tile:city())
+  local moved, stuck = 0, 0
+  for i = 2, #units do
+    if civ54_relocate(units[i]) then
+      moved = moved + 1
+    else
+      stuck = stuck + 1
+    end
+  end
+  return moved, stuck
+end
+
+function civ54_unit_built_callback(unit, city)
+  local tile = unit.tile
+  if tile:num_units() > 1 then
+    local m, s = civ54_resolve_tile(tile)
+    civ54_built_moved = civ54_built_moved + m
+    civ54_built_stuck = civ54_built_stuck + s
+  end
+  return false
+end
+signal.connect("unit_built", "civ54_unit_built_callback")
+
+function civ54_turn_begin_callback(turn, year)
+  local moved, stuck = 0, 0
+  for tile in whole_map_iterate() do
+    if tile:num_units() > 1 then
+      local m, s = civ54_resolve_tile(tile)
+      moved = moved + m
+      stuck = stuck + s
+    end
+  end
+  if moved + stuck + civ54_built_moved + civ54_built_stuck > 0 then
+    log.normal("civ54 one-unit-per-tile, turn %d: production %d relocated, %d without a free tile; sweep %d relocated, %d without a free tile",
+               turn, civ54_built_moved, civ54_built_stuck, moved, stuck)
+  end
+  civ54_built_moved, civ54_built_stuck = 0, 0
+  return false
+end
+signal.connect("turn_begin", "civ54_turn_begin_callback")
