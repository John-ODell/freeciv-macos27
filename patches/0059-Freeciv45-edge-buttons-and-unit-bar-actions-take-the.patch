diff --git a/client/gui-qt/unitbar.cpp b/client/gui-qt/unitbar.cpp
index 18a0136..a5853b3 100644
--- a/client/gui-qt/unitbar.cpp
+++ b/client/gui-qt/unitbar.cpp
@@ -53,6 +53,7 @@ extern "C" {
 // gui-qt
 #include "canvas.h"
 #include "cityoverlay.h"
+#include "edgebar.h"
 #include "fc_client.h"
 #include "fonts.h"
 #include "menu.h"
@@ -268,20 +269,25 @@ void unit_chip::mousePressEvent(QMouseEvent *event)
 }
 
 /************************************************************************//**
-  Action button: theme icon, key hint from the shortcut table, tooltip
-  from the menu.
+  Action button: the tileset's picture (ui.action.<name>) or else the
+  theme icon, key hint from the shortcut table, tooltip from the menu.
 ****************************************************************************/
 unit_action_button::unit_action_button(shortcut_id sid, const QString &icon,
                                        QWidget *parent)
   : QAbstractButton(parent)
 {
-  QPixmap *pm = fc_icons::instance()->get_pixmap(icon);
   fc_shortcut *sc = fc_shortcuts::sc()->get_shortcut(sid);
 
   action = sid;
-  if (pm != nullptr) {
-    icon_pix = *pm;
-    delete pm;
+  // The theme calls Settle's icon "home"
+  icon_pix = ui_button_pixmap("action", icon == "home" ? "settle" : icon);
+  if (icon_pix.isNull()) {
+    QPixmap *pm = fc_icons::instance()->get_pixmap(icon);
+
+    if (pm != nullptr) {
+      icon_pix = *pm;
+      delete pm;
+    }
   }
   hint = shortcut_to_string(sc);
   setFixedSize(ACTION_SIZE, ACTION_SIZE);
