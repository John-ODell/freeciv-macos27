+/************************************************************************//**
+  Lay the boxes out left to right, wrapping after the given number. Each is
+  shown now, so adjustSize() counts it while the bar is up.
+****************************************************************************/
+void unit_bar::fill_grid(QGridLayout *grid, QList<QWidget *> &items,
+                         int columns)
+{
+  int i = 0;
+
+  foreach (QWidget *w, items) {
+    grid->addWidget(w, i / columns, i % columns,
+                    Qt::AlignLeft | Qt::AlignTop);
+    w->show();
+    i++;
+  }
+  // A spare column takes any room left over, so the boxes sit together
+  for (int c = 0; c < grid->columnCount(); c++) {
+    grid->setColumnStretch(c, 0);
+  }
+  grid->setColumnStretch(columns, 1);
+}
+
+/************************************************************************//**
+  Put the text in the label, cut short with an ellipsis when wider than
+  the room it has; the whole line goes in the tooltip then.
+****************************************************************************/
+static void set_fitted(QLabel *label, const QString &text, int width)
+{
+  QString shown = label->fontMetrics().elidedText(text, Qt::ElideRight,
+                                                  width);
+
+  label->setText(shown);
+  label->setToolTip(shown == text ? QString() : text);
+  label->setVisible(!text.isEmpty());
+}
