From 39766fbe987f6236147eef1dca3cd7f1621e5454 Mon Sep 17 00:00:00 2001
From: John O'Dell <johncodell14@gmail.com>
Date: Sun, 18 Oct 2026 13:27:20 -0500
Subject: [PATCH 38/41] civ45: warships are not city defenders for the AI (no
 DefendGood or DefendOk role)

---
 data/civ45/units.ruleset | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/data/civ45/units.ruleset b/data/civ45/units.ruleset
index f39f15f..6d157e1 100644
--- a/data/civ45/units.ruleset
+++ b/data/civ45/units.ruleset
@@ -2790,7 +2790,6 @@ uk_food       = 1
 uk_gold       = 0
 tp_defense    = "Alight"
 flags         = "Shield2Gold", "ShieldToGold", "BadCityDefender", "IronBased", "Naval"
-roles         = "DefendOk"
 helptext      = _("\
 A ship of two gun decks: half again as strong against a city. It needs iron for its guns.\
 ")
@@ -2908,7 +2907,6 @@ uk_food       = 1
 uk_gold       = 0
 tp_defense    = "Alight"
 flags         = "Shield2Gold", "ShieldToGold", "BadCityDefender", "IronBased", "Naval"
-roles         = "DefendOk", "DefendOkStartUnit"
 helptext      = _("\
 The Cruiser is a strong offensive boat unit.\
 ")
@@ -2945,7 +2943,6 @@ uk_food       = 1
 uk_gold       = 0
 tp_defense    = "Alight"
 flags         = "Shield2Gold", "ShieldToGold", "BadCityDefender", "IronBased", "Naval"
-roles         = "DefendGood", "DefendGoodStartUnit"
 bonuses       =
     { "flag", "type", "value"
       "AirAttacker", "DefenseMultiplier", 4
@@ -2990,7 +2987,6 @@ tp_defense    = "Alight"
 ; No, Sir! Declares President" Chicago Daily Tribune, Feb. 26, 1938.
 ; */ <-- avoid gettext warnings
 flags         = "Shield2Gold", "ShieldToGold", "BadCityDefender", "Naval"
-roles         = "DefendOk", "DefendOkStartUnit"
 helptext      = _("\
 The Battleship is the supreme naval unit with\
  excellent offensive and defensive values.\
@@ -3113,7 +3109,6 @@ tp_defense    = "Alight"
 ; Consensus historical article: Julian Borger. "Wake-up call"
 ; The Guardian, Sep. 6, 2002.
 flags         = "Shield2Gold", "ShieldToGold", "BadCityDefender", "Naval"
-roles         = "DefendGood"
 helptext      = _("\
 The Carrier is a mobile airport.\
 "), _("\
