+/************************************************************************//**
+  A line of the tooltip for each extra
+****************************************************************************/
+void edge_button::add_hint(const QString &hint)
+{
+  setToolTip(toolTip() + "\n" + hint);
+}
+
+/************************************************************************//**
+  What a right-click does, as on the sidebar's matching button
+****************************************************************************/
+void edge_button::set_right_click(void (*func)(void), const QString &hint)
+{
+  right_click = func;
+  add_hint(hint);
+}
+
+/************************************************************************//**
+  What the wheel does, up and down, as on the sidebar's matching button
+****************************************************************************/
+void edge_button::set_wheel(void (*up)(void), void (*down)(void),
+                            const QString &hint)
+{
+  wheel_up = up;
+  wheel_down = down;
+  add_hint(hint);
+}
+
+/************************************************************************//**
+  A right-click runs the button's extra; the left button clicks as usual
+****************************************************************************/
+void edge_button::mousePressEvent(QMouseEvent *event)
+{
+  if (event->button() == Qt::RightButton && right_click != nullptr) {
+    event->accept();
+    right_click();
+    return;
+  }
+  QToolButton::mousePressEvent(event);
+}
+
+/************************************************************************//**
+  The press already ran the right-click; keep the context menu event from
+  reaching the map
+****************************************************************************/
+void edge_button::contextMenuEvent(QContextMenuEvent *event)
+{
+  if (right_click != nullptr) {
+    event->accept();
+    return;
+  }
+  QToolButton::contextMenuEvent(event);
+}
+
+/************************************************************************//**
+  One step of the wheel up or down runs the extra on the map: a mouse
+  sends a notch a step, a touchpad smaller steps that add up
+****************************************************************************/
+void edge_button::wheelEvent(QWheelEvent *event)
+{
+  void (*func)(void) = nullptr;
+
+  if (wheel_up == nullptr && wheel_down == nullptr) {
+    QToolButton::wheelEvent(event);
+    return;
+  }
+  wheel_delta += event->angleDelta().y();
+  if (wheel_delta >= WHEEL_NOTCH) {
+    func = wheel_up;
+  } else if (wheel_delta <= -WHEEL_NOTCH) {
+    func = wheel_down;
+  }
+  if (func != nullptr || qAbs(wheel_delta) >= WHEEL_NOTCH) {
+    wheel_delta = 0;
+  }
+  if (func != nullptr) {
+    if (city_overlay_is_open()) {
+      gui()->cityoverlay_wdg->close_overlay();
+    }
+    side_show_map(true);
+    func();
+  }
+  event->accept();
 }
 
