+/************************************************************************//**
+  Draw the four indicators side by side at the strip's icon height; called
+  when the client changes them (set_indicator_icons) and with the numbers
+****************************************************************************/
+void top_strip::update_indicators()
+{
+  struct sprite *sprites[4] = {
+    client_research_sprite(), client_warming_sprite(),
+    client_cooling_sprite(), client_government_sprite()
+  };
+  qreal dpr = devicePixelRatioF();
+  QSize size(4 * STRIP_ICON + 3 * INDICATOR_GAP, STRIP_ICON);
+  QPixmap pm(size * dpr);
+  QPainter p;
+  int x = 0;
+
+  pm.setDevicePixelRatio(dpr);
+  pm.fill(Qt::transparent);
+  p.begin(&pm);
+  p.setRenderHint(QPainter::SmoothPixmapTransform);
+  for (struct sprite *sp : sprites) {
+    if (sp != nullptr && sp->pm != nullptr && !sp->pm->isNull()) {
+      QSize fit = sp->pm->size().scaled(STRIP_ICON, STRIP_ICON,
+                                        Qt::KeepAspectRatio);
+
+      p.drawPixmap(QRect(x + (STRIP_ICON - fit.width()) / 2,
+                         (STRIP_ICON - fit.height()) / 2,
+                         fit.width(), fit.height()), *sp->pm);
+    }
+    x += STRIP_ICON + INDICATOR_GAP;
+  }
+  p.end();
+  indicators_btn->setIcon(QIcon(pm));
+  indicators_btn->setIconSize(size);
+  // TRANS: the Freeciv45 top strip's indicators, after the game summary
+  indicators_btn->setToolTip(QString(get_info_label_text_popup()) + "\n"
+                             + QString(_("Click: change the government")));
+}
+
+/************************************************************************//**
+  A right press on the indicators offers the government menu too
+****************************************************************************/
+bool top_strip::eventFilter(QObject *obj, QEvent *event)
+{
+  if (obj == indicators_btn && event->type() == QEvent::MouseButtonPress
+      && static_cast<QMouseEvent *>(event)->button() == Qt::RightButton) {
+    indicators_menu();
+    return true;
+  }
+
+  return QFrame::eventFilter(obj, event);
+}
+
+/************************************************************************//**
+  The government menu under the indicators, for a player who can give
+  orders
+****************************************************************************/
+void top_strip::indicators_menu()
+{
+  if (!can_client_issue_orders()) {
+    return;
+  }
+  gov->create();
+  gov->update();
+  gov->popup(indicators_btn->mapToGlobal(QPoint(0,
+                                                indicators_btn->height())));
+}
