+/************************************************************************//**
+  Action button: theme icon, key hint from the shortcut table, tooltip
+  from the menu.
+****************************************************************************/
+unit_action_button::unit_action_button(shortcut_id sid, const QString &icon,
+                                       QWidget *parent)
+  : QAbstractButton(parent)
+{
+  QPixmap *pm = fc_icons::instance()->get_pixmap(icon);
+  fc_shortcut *sc = fc_shortcuts::sc()->get_shortcut(sid);
+
+  action = sid;
+  if (pm != nullptr) {
+    icon_pix = *pm;
+    delete pm;
+  }
+  hint = shortcut_to_string(sc);
+  setFixedSize(ACTION_SIZE, ACTION_SIZE);
+  setToolTip(gui()->menu_bar->shortcut_2_menustring(sid));
+  setFocusPolicy(Qt::NoFocus);
+  connect(this, &QAbstractButton::clicked, this, &unit_action_button::run);
+}
+
+/************************************************************************//**
+  Paint: rounded box, icon on top, hint bottom right.
+****************************************************************************/
+void unit_action_button::paintEvent(QPaintEvent *event)
+{
+  QPainter p(this);
+  QRect box(1, 1, ACTION_SIZE - 2, ACTION_SIZE - 2);
+  QFont f = font();
+
+  p.setRenderHint(QPainter::Antialiasing);
+  p.setRenderHint(QPainter::SmoothPixmapTransform);
+  p.setPen(Qt::NoPen);
+  p.setBrush(palette().color(underMouse() ? QPalette::Highlight
+                                          : QPalette::Base));
+  p.drawRoundedRect(box, 4, 4);
+  if (!icon_pix.isNull()) {
+    p.drawPixmap(QRect((ACTION_SIZE - ACTION_ICON) / 2, 2,
+                       ACTION_ICON, ACTION_ICON), icon_pix);
+  }
+  f.setPixelSize(9);
+  f.setBold(true);
+  p.setFont(f);
+  p.setPen(QColor(255, 213, 74));
+  p.drawText(box.adjusted(0, 0, -2, -1), Qt::AlignRight | Qt::AlignBottom,
+             hint);
+  event->accept();
+}
+
+/************************************************************************//**
+  Run the action the way the menu does.
+****************************************************************************/
+void unit_action_button::run()
+{
+  switch (action) {
+  case SC_FORTIFY:
+    key_unit_fortify();
+    break;
+  case SC_SENTRY:
+    key_unit_sentry();
+    break;
+  case SC_WAIT:
+    key_unit_wait();
+    break;
+  case SC_DONE_MOVING:
+    key_unit_done();
+    break;
+  default:
+    gui()->menu_bar->execute_shortcut(action);
+    break;
+  }
+}
