+// Logical sizes at 1x; the same at 2x, pixmaps carry the pixel ratio.
+static const int PORTRAIT_SIZE = 80;
+static const int PORTRAIT_IMAGE = 64;
+static const int HEALTH_BAR_HEIGHT = 6;
+static const int CHIP_SIZE = 30;
+static const int CHIP_IMAGE = 24;
+static const int MAX_CHIPS = 8;
+static const int ACTION_SIZE = 36;
+static const int ACTION_ICON = 24;
+static const int BAR_MARGIN = 12;
