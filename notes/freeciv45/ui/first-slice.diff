+/************************************************************************//**
+  Chip for one unit of the stack.
+****************************************************************************/
+unit_chip::unit_chip(struct unit *punit, bool focus,
+                     QWidget *parent) : QAbstractButton(parent)
+{
+  unit_id = punit->id;
+  more_count = 0;
+  focused = focus;
+  chip_tile = unit_tile(punit);
+  pix = unit_pixmap(punit, CHIP_IMAGE, devicePixelRatioF());
+  setFixedSize(CHIP_SIZE, CHIP_SIZE);
+  setToolTip(QString(unit_name_translation(punit))
+             + QString(" ") + QString(_("HP:%1/%2"))
+             .arg(QString::number(punit->hp),
+                  QString::number(unit_type_get(punit)->hp)));
+}
+
+/************************************************************************//**
+  Chip that stands for the units beyond the last shown one.
+****************************************************************************/
+unit_chip::unit_chip(int more, struct tile *ptile,
+                     QWidget *parent) : QAbstractButton(parent)
+{
+  unit_id = 0;
+  more_count = more;
+  focused = false;
+  chip_tile = ptile;
+  setFixedSize(CHIP_SIZE, CHIP_SIZE);
+  setToolTip(QString(PL_("%1 more unit on this tile",
+                         "%1 more units on this tile", more)).arg(more));
+}
+
+/************************************************************************//**
+  Paint the chip: rounded box, unit image or "+N", ring when focused.
+****************************************************************************/
+void unit_chip::paintEvent(QPaintEvent *event)
+{
+  QPainter p(this);
+  QRect box(1, 1, CHIP_SIZE - 2, CHIP_SIZE - 2);
+
+  p.setRenderHint(QPainter::Antialiasing);
+  p.setRenderHint(QPainter::SmoothPixmapTransform);
+  p.setPen(Qt::NoPen);
+  p.setBrush(palette().color(QPalette::Base));
+  p.drawRoundedRect(box, 4, 4);
+  if (more_count > 0) {
+    p.setPen(palette().color(QPalette::Text));
+    p.drawText(box, Qt::AlignCenter, QString("+%1").arg(more_count));
+  } else if (!pix.isNull()) {
+    QSizeF ls = pix.deviceIndependentSize();
+
+    p.drawPixmap((CHIP_SIZE - qRound(ls.width())) / 2,
+                 (CHIP_SIZE - qRound(ls.height())) / 2, pix);
+  }
+  if (focused) {
+    p.setPen(QPen(palette().color(QPalette::Highlight), 2));
+    p.setBrush(Qt::NoBrush);
+    p.drawRoundedRect(box, 4, 4);
+  }
+  event->accept();
+}
+
+/************************************************************************//**
+  Click: focus that unit alone; Shift+click adds it to the focus; the
+  "+N" chip opens the stack chooser.
+****************************************************************************/
+void unit_chip::mousePressEvent(QMouseEvent *event)
+{
+  struct unit *punit;
+
+  if (event->button() != Qt::LeftButton) {
+    return;
+  }
+  if (more_count > 0) {
+    unit_select_dialog_popup(chip_tile);
+    return;
+  }
+  punit = game_unit_by_number(unit_id);
+  if (punit == nullptr) {
+    return;
+  }
+  if (event->modifiers() & Qt::ShiftModifier) {
+    unit_focus_add(punit);
+  } else {
+    unit_focus_set(punit);
+  }
+}
