+/************************************************************************//**
+  The bar itself.
+****************************************************************************/
+unit_bar::unit_bar(QWidget *parent) : QFrame(parent)
+{
+  QFont name_font = *fc_font::instance()->get_font(fonts::default_font);
+  QFont small_font = *fc_font::instance()->get_font(fonts::notify_label);
+
+  setObjectName("unit_bar");
+  setFrameShape(QFrame::StyledPanel);
+  main_row = new QHBoxLayout(this);
+  main_row->setContentsMargins(BAR_MARGIN, 8, BAR_MARGIN, 8);
+  main_row->setSpacing(BAR_MARGIN);
+
+  portrait = new unit_portrait(this);
+  main_row->addWidget(portrait, 0, Qt::AlignTop);
+
+  text_column = new QVBoxLayout;
+  text_column->setSpacing(2);
+  name_label = new QLabel(this);
+  name_font.setBold(true);
+  name_label->setFont(name_font);
+  sub_label = new QLabel(this);
+  sub_label->setFont(small_font);
+  stats_label = new QLabel(this);
+  stats_label->setFont(small_font);
+  text_column->addWidget(name_label);
+  text_column->addWidget(sub_label);
+  text_column->addWidget(stats_label);
+  text_column->addStretch(1);
+  main_row->addLayout(text_column);
+
+  right_column = new QVBoxLayout;
+  right_column->setSpacing(6);
+  chips_row = new QHBoxLayout;
+  chips_row->setSpacing(6);
+  chips_row->addStretch(1);
+  actions_row = new QHBoxLayout;
+  actions_row->setSpacing(6);
+  actions_row->addStretch(1);
+  right_column->addLayout(chips_row);
+  right_column->addLayout(actions_row);
+  main_row->addLayout(right_column);
+
+  setFocusPolicy(Qt::NoFocus);
+  hide();
+}
