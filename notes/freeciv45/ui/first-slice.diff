+/************************************************************************//**
+  Draw the unit as the map draws it, cropped to its ink, scaled to the given
+  logical height, with the widget's pixel ratio so the OS does not scale
+  it a second time.
+****************************************************************************/
+static QPixmap unit_pixmap(struct unit *punit, int height, qreal dpr)
+{
+  struct canvas *cv;
+  struct tileset *tmp = nullptr;
+  QImage img, cropped, scaled;
+  QPixmap pm;
+
+  if (unscaled_tileset) {
+    tmp = tileset;
+    tileset = unscaled_tileset;
+  }
+  cv = qtg_canvas_create(tileset_unit_width(tileset),
+                         tileset_unit_height(tileset));
+  cv->map_pixmap.fill(Qt::transparent);
+  put_unit(punit, cv, 1.0, 0, 0);
+  img = cv->map_pixmap.toImage();
+  cropped = img.copy(zealous_crop_rect(img));
+  qtg_canvas_free(cv);
+  if (tmp != nullptr) {
+    tileset = tmp;
+  }
+  if (cropped.isNull() || cropped.height() == 0) {
+    return pm;
+  }
+  scaled = cropped.scaledToHeight(qRound(height * dpr),
+                                  Qt::SmoothTransformation);
+  pm = QPixmap::fromImage(scaled);
+  pm.setDevicePixelRatio(dpr);
+
+  return pm;
+}
