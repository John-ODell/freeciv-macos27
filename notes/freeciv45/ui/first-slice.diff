+/************************************************************************//**
+  Fill the bar for the head focus unit, or hide it when nothing is in
+  focus or the option is off.
+****************************************************************************/
+void unit_bar::refresh(struct unit_list *punits)
+{
+  struct unit *punit = head_of_units_in_focus();
+  const struct unit_type *ptype;
+  struct city *home;
+  const char *vet;
+  QString sub, stats;
+  int shown = 0;
+  int own = 0;
+  int focus_count;
+
+  if (punit == nullptr || !gui_options.gui_qt_freeciv45_panels
+      || !can_client_change_view()) {
+    hide();
+    return;
+  }
+
+  setUpdatesEnabled(false);
+  ptype = unit_type_get(punit);
+  portrait->set_unit(punit);
+  name_label->setText(QString(unit_name_translation(punit)));
+
+  vet = utype_veteran_name_translation(ptype, punit->veteran);
+  if (vet != nullptr) {
+    sub = QString(vet);
+  }
+  home = player_city_by_number(unit_owner(punit), punit->homecity);
+  if (home != nullptr) {
+    if (!sub.isEmpty()) {
+      sub += " ";
+    }
+    sub += QString("(%1)").arg(city_name_get(home));
+  }
+  sub_label->setText(sub);
+
+  // TRANS: unit bar: attack / defence, moves left, hit points
+  stats = QString(_("str %1 / %2   moves %3   hp %4/%5"))
+          .arg(QString::number(ptype->attack_strength),
+               QString::number(ptype->defense_strength),
+               QString(move_points_text(punit->moves_left, false)),
+               QString::number(punit->hp),
+               QString::number(ptype->hp));
+  focus_count = unit_list_size(get_units_in_focus());
+  if (focus_count > 1) {
+    stats += QString(PL_("   (Selected %1 unit)", "   (Selected %1 units)",
+                         focus_count)).arg(focus_count);
+  }
+  stats_label->setText(stats);
+
+  clear_row(chips_row);
+  unit_list_iterate(unit_tile(punit)->units, other) {
+    if (unit_owner(other) != client_player()) {
+      continue;
+    }
+    own++;
+    if (shown < MAX_CHIPS) {
+      bool focused = (unit_list_search(get_units_in_focus(), other) != nullptr);
+      unit_chip *chip = new unit_chip(other, focused, this);
+
+      chips_row->insertWidget(chips_row->count() - 1, chip);
+      chips.append(chip);
+      shown++;
+    }
+  } unit_list_iterate_end;
+  if (own > shown) {
+    unit_chip *chip = new unit_chip(own - shown, unit_tile(punit), this);
+
+    chips_row->insertWidget(chips_row->count() - 1, chip);
+    chips.append(chip);
+  }
+
+  clear_row(actions_row);
+  {
+    QList<unit_action_button *> row;
+
+    row.append(new unit_action_button(SC_GOTO, "goto", this));
+    if (can_unit_do_activity_client(punit, ACTIVITY_FORTIFYING)) {
+      row.append(new unit_action_button(SC_FORTIFY, "fortify", this));
+    }
+    if (can_unit_do_activity_client(punit, ACTIVITY_SENTRY)) {
+      row.append(new unit_action_button(SC_SENTRY, "sentry", this));
+    }
+    row.append(new unit_action_button(SC_WAIT, "wait", this));
+    row.append(new unit_action_button(SC_DONE_MOVING, "done", this));
+    foreach (unit_action_button *b, row) {
+      actions_row->insertWidget(actions_row->count() - 1, b);
+      actions.append(b);
+    }
+  }
+
+  setUpdatesEnabled(true);
+  adjustSize();
+  place();
+  show();
+  raise();
+}
+
+/************************************************************************//**
+  Centre the bar at the bottom of the map.
+****************************************************************************/
+void unit_bar::place()
+{
+  QWidget *parent = parentWidget();
+
+  if (parent == nullptr) {
+    return;
+  }
+  adjustSize();
+  move((parent->width() - width()) / 2,
+       parent->height() - height() - BAR_MARGIN);
+}
