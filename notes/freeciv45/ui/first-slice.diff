+/************************************************************************//**
+  Portrait: the unit image with a health bar under it.
+****************************************************************************/
+unit_portrait::unit_portrait(QWidget *parent) : QWidget(parent)
+{
+  hp = 0;
+  hp_max = 1;
+  setFixedSize(PORTRAIT_SIZE, PORTRAIT_SIZE);
+}
+
+/************************************************************************//**
+  Take the unit's image and hit points.
+****************************************************************************/
+void unit_portrait::set_unit(struct unit *punit)
+{
+  pix = unit_pixmap(punit, PORTRAIT_IMAGE, devicePixelRatioF());
+  hp = punit->hp;
+  hp_max = MAX(1, unit_type_get(punit)->hp);
+  update();
+}
+
+/************************************************************************//**
+  Paint the portrait: image centred above, bar below.
+****************************************************************************/
+void unit_portrait::paintEvent(QPaintEvent *event)
+{
+  QPainter p(this);
+  QRect bar(4, PORTRAIT_SIZE - HEALTH_BAR_HEIGHT - 4,
+            PORTRAIT_SIZE - 8, HEALTH_BAR_HEIGHT);
+  QColor fill;
+  int w;
+
+  p.setRenderHint(QPainter::SmoothPixmapTransform);
+  if (!pix.isNull()) {
+    QSizeF ls = pix.deviceIndependentSize();
+    int x = (PORTRAIT_SIZE - qRound(ls.width())) / 2;
+    int y = (bar.top() - 4 - qRound(ls.height())) / 2;
+
+    p.drawPixmap(x, y, pix);
+  }
+  p.setPen(Qt::NoPen);
+  p.setBrush(palette().color(QPalette::Shadow));
+  p.drawRoundedRect(bar, 2, 2);
+  w = (bar.width() * hp) / hp_max;
+  if (3 * hp > 2 * hp_max) {
+    fill = QColor(76, 175, 80);
+  } else if (3 * hp > hp_max) {
+    fill = QColor(255, 213, 74);
+  } else {
+    fill = QColor(194, 59, 59);
+  }
+  p.setBrush(fill);
+  p.drawRoundedRect(QRect(bar.left(), bar.top(), w, bar.height()), 2, 2);
+  event->accept();
+}
+
+/************************************************************************//**
+  A click on the portrait centres the map on the unit.
+****************************************************************************/
+void unit_portrait::mousePressEvent(QMouseEvent *event)
+{
+  if (event->button() == Qt::LeftButton) {
+    request_center_focus_unit();
+  }
+}
