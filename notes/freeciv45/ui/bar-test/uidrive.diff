+/************************************************************************//**
+  Find a target widget: portrait, chip N (0-based), action TEXT
+****************************************************************************/
+static QWidget *find_target(const QStringList &w)
+{
+  if (w.size() >= 2 && w[1] == "portrait") {
+    QList<unit_portrait *> l = visible_in_bar<unit_portrait>();
+
+    return l.isEmpty() ? nullptr : l[0];
+  }
+  if (w.size() >= 3 && w[1] == "chip") {
+    QList<unit_chip *> l = visible_in_bar<unit_chip>();
+    int i = w[2].toInt();
+
+    return (i >= 0 && i < l.size()) ? l[i] : nullptr;
+  }
+  if (w.size() >= 3 && w[1] == "button") {
+    foreach (QAbstractButton *b, gui()->findChildren<QAbstractButton *>()) {
+      if (b->isVisible() && b->text().contains(w[2], Qt::CaseInsensitive)) {
+        return b;
+      }
+    }
+  }
+  if (w.size() >= 3 && w[1] == "tip") {
+    QString tip = QStringList(w.mid(2)).join(' ');
+
+    // An exact tooltip first, then one that contains the text
+    foreach (QAbstractButton *b, gui()->findChildren<QAbstractButton *>()) {
+      if (b->isVisible() && b->toolTip() == tip) {
+        return b;
+      }
+    }
+    foreach (QAbstractButton *b, gui()->findChildren<QAbstractButton *>()) {
+      if (b->isVisible() && b->toolTip().contains(tip, Qt::CaseInsensitive)) {
+        return b;
+      }
+    }
+  }
+  if (w.size() >= 3 && w[1] == "label") {
+    foreach (QLabel *l, gui()->findChildren<QLabel *>()) {
+      if (l->isVisible() && l->text() == w[2]) {
+        return l;
+      }
+    }
+  }
+  if (w.size() >= 3 && w[1] == "action") {
+    foreach (unit_action_button *b, visible_in_bar<unit_action_button>()) {
+      if (b->toolTip().contains(w[2], Qt::CaseInsensitive)) {
+        return b;
+      }
+    }
+  }
+
+  return nullptr;
+}
