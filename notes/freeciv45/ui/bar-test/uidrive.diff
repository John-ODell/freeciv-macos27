+/************************************************************************//**
+  One line describing the client's unit focus and the bar
+****************************************************************************/
+static void log_state(const QString &label)
+{
+  QString s = QString("== %1  turn %2").arg(label).arg(game.info.turn);
+  unit_bar *bar = gui()->unitbar_wdg;
+  QStringList chips, acts, texts;
+
+  s += QString("  hover_state %1").arg((int) hover_state);
+  unit_list_iterate(get_units_in_focus(), punit) {
+    int x, y;
+
+    index_to_map_pos(&x, &y, tile_index(unit_tile(punit)));
+    s += QString("\n   focus #%1 %2 at (%3,%4) activity %5 moves %6 hp %7"
+                 " orders %8 done %9 ssa %10")
+         .arg(punit->id).arg(unit_rule_name(punit)).arg(x).arg(y)
+         .arg(get_activity_text(punit->activity))
+         .arg(punit->moves_left).arg(punit->hp)
+         .arg(punit->has_orders ? "yes" : "no")
+         .arg(punit->done_moving ? "yes" : "no")
+         .arg((int) punit->ssa_controller);
+  } unit_list_iterate_end;
+  if (unit_list_size(get_units_in_focus()) == 0) {
+    s += "\n   focus: none";
+  } else {
+    s += "\n   stack";
+    unit_list_iterate(unit_tile(head_of_units_in_focus())->units, punit) {
+      if (unit_owner(punit) == client_player()) {
+        s += QString(" #%1:%2%3").arg(punit->id)
+             .arg(get_activity_text(punit->activity))
+             .arg(punit->done_moving ? "(done)" : "");
+      }
+    } unit_list_iterate_end;
+  }
+  s += QString("\n   window active %1")
+       .arg(gui()->isActiveWindow() ? "yes" : "no");
+  if (bar != nullptr) {
+    foreach (QLabel *l, visible_in_bar<QLabel>()) {
+      texts << l->text();
+    }
+    foreach (unit_chip *c, visible_in_bar<unit_chip>()) {
+      chips << c->toolTip();
+    }
+    foreach (unit_action_button *b, visible_in_bar<unit_action_button>()) {
+      acts << b->toolTip();
+    }
+    s += QString("\n   bar visible %1 at %2,%3 %4x%5")
+         .arg(bar->isVisible() ? "yes" : "no")
+         .arg(bar->x()).arg(bar->y()).arg(bar->width()).arg(bar->height());
+    if (bar->isVisible()) {
+      s += QString("\n   labels [%1]\n   chips [%2]\n   actions [%3]")
+           .arg(texts.join(" | "), chips.join(" | "), acts.join(" | "));
+    }
+  }
+  {
+    // The city overlay's parts, found by their theme names
+    QStringList parts;
+    const char *names[] = { "city_yields", "city_sections",
+                            "city_production", "city_footer" };
+
+    for (const char *n : names) {
+      QWidget *p = gui()->findChild<QWidget *>(n);
+
+      if (p != nullptr && p->isVisible()) {
+        parts << QString("%1 %2,%3 %4x%5").arg(n).arg(p->x()).arg(p->y())
+                 .arg(p->width()).arg(p->height());
+      }
+    }
+    if (!parts.isEmpty()) {
+      QStringList otexts;
+
+      foreach (QLabel *l, gui()->findChildren<QLabel *>()) {
+        if (l->isVisible() && !l->text().isEmpty()
+            && l->parentWidget() != nullptr
+            && l->window() == gui()
+            && QString(l->parentWidget()->objectName()).startsWith("city_")) {
+          otexts << l->text().simplified();
+        }
+      }
+      s += QString("\n   city overlay [%1]\n   overlay text [%2]")
+           .arg(parts.join(" | "), otexts.join(" | "));
+    }
+    s += QString("\n   minimap visible %1, chat visible %2")
+         .arg(gui()->minimapview_wdg->isVisible() ? "yes" : "no")
+         .arg(gui()->infotab->isVisible() ? "yes" : "no");
+  }
+  s += QString("\n   hud_units visible %1")
+       .arg(gui()->unitinfo_wdg->isVisible() ? "yes" : "no");
+  s += QString("\n   map origin %1,%2").arg(mapview.gui_x0).arg(mapview.gui_y0);
+  {
+    QStringList tops;
+
+    foreach (QWidget *w, QApplication::topLevelWidgets()) {
+      if (w->isVisible() && w != gui() && !w->inherits("QTipLabel")) {
+        QMessageBox *mb = qobject_cast<QMessageBox *>(w);
+
+        tops << QString(w->metaObject()->className())
+                + (w->isModal() ? " (modal)" : "")
+                + (mb != nullptr ? " \"" + mb->text().left(80) + "\"" : "");
+      }
+    }
+    s += QString("\n   other windows [%1]").arg(tops.join(", "));
+    if (QApplication::activeModalWidget() != nullptr) {
+      s += QString("\n   active modal %1").arg(
+           QApplication::activeModalWidget()->metaObject()->className());
+    }
+  }
+  s += QString("\n   tooltip %1")
+       .arg(QToolTip::isVisible() ? "\"" + QToolTip::text() + "\"" : "none");
+  drive_log(s);
+}
