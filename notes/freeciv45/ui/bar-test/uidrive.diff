+/************************************************************************//**
+  The bar's visible children of one class, left to right, top to bottom
+****************************************************************************/
+template <class T> static QList<T *> visible_in_bar()
+{
+  QList<T *> out;
+  unit_bar *bar = gui()->unitbar_wdg;
+
+  if (bar == nullptr) {
+    return out;
+  }
+  foreach (T *w, bar->findChildren<T *>()) {
+    if (w->isVisible()) {
+      out.append(w);
+    }
+  }
+  std::sort(out.begin(), out.end(), [bar](T *a, T *b) {
+    QPoint pa = a->mapTo(bar, QPoint(0, 0));
+    QPoint pb = b->mapTo(bar, QPoint(0, 0));
+
+    return pa.y() != pb.y() ? pa.y() < pb.y() : pa.x() < pb.x();
+  });
+
+  return out;
+}
