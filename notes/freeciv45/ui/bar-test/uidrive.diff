+/************************************************************************//**
+  Run one script line
+****************************************************************************/
+static void run_line(const QString &raw)
+{
+  QString line = raw;
+  struct unit *head = focus_head();
+  QStringList w;
+
+  if (head != nullptr) {
+    int x, y;
+
+    index_to_map_pos(&x, &y, tile_index(unit_tile(head)));
+    line.replace("$UNIT", QString::number(head->id));
+    line.replace("$HPMAX", QString::number(unit_type_get(head)->hp));
+    line.replace("$HP", QString::number(head->hp));
+    line.replace("$X", QString::number(x));
+    line.replace("$Y", QString::number(y));
+  }
+  w = line.split(' ', Qt::SkipEmptyParts);
+  QString cmd = w.isEmpty() ? QString() : w[0];
+
+  drive_log("> " + line);
+  if (cmd == "pace" && w.size() > 1) {
+    pace = w[1].toInt();
+  } else if (cmd == "wait" && w.size() > 1) {
+    drive_timer->setInterval(pace + w[1].toInt());
+    return;
+  } else if (cmd == "wheel" && w.size() > 3) {
+    QStringList tw({ "wheel", w[2], QStringList(w.mid(3)).join(' ') });
+    QWidget *t = find_target(tw);
+
+    if (t == nullptr) {
+      drive_log("   !! no such target");
+    } else {
+      QPoint local = t->rect().center();
+      QWheelEvent we(QPointF(local), QPointF(t->mapToGlobal(local)),
+                     QPoint(), QPoint(0, w[1].toInt()), Qt::NoButton,
+                     Qt::NoModifier, Qt::NoScrollPhase, false);
+
+      drive_log(QString("   wheel %1 on %2 \"%3\"").arg(w[1])
+                .arg(t->metaObject()->className())
+                .arg(t->toolTip().left(40)));
+      QApplication::sendEvent(t, &we);
+    }
+  } else if (cmd == "hover" || cmd == "click" || cmd == "rclick") {
+    QStringList tw = w;
+    bool shift = tw.last() == "shift";
+    QWidget *t;
+
+    if (shift) {
+      tw.removeLast();
+    }
+    if (tw.size() > 2
+        && (tw[1] == "action" || tw[1] == "button" || tw[1] == "label")) {
+      // the text may have spaces
+      tw = QStringList({ tw[0], tw[1], QStringList(tw.mid(2)).join(' ') });
+    }
+    t = find_target(tw);
+    if (t == nullptr) {
+      drive_log("   !! no such target");
+    } else {
+      // Through the window, as the platform delivers a real mouse: Qt
+      // hit-tests, sends enter and leave, and starts the tooltip timer.
+      QWindow *win = gui()->windowHandle();
+      QPoint c = t->mapTo(gui(), t->rect().center());
+
+      // Started from a shell, the app is not frontmost and macOS takes
+      // the active state back; tooltips only show in an active window.
+      QApplication::setActiveWindow(gui());
+
+      {
+        QWidget *under = gui()->childAt(c);
+
+        drive_log(QString("   at %1,%2 target %3, under %4 \"%5\"")
+                  .arg(c.x()).arg(c.y()).arg(t->metaObject()->className())
+                  .arg(under != nullptr ? under->metaObject()->className()
+                                        : "nothing")
+                  .arg(under != nullptr ? under->toolTip() : QString()));
+      }
+      QCursor::setPos(gui()->mapToGlobal(c));
+      QTest::mouseMove(win, c);
+      if (cmd == "rclick") {
+        QTest::mouseClick(win, Qt::RightButton, Qt::NoModifier, c);
+      } else if (cmd == "click") {
+        QTest::mouseClick(win, Qt::LeftButton,
+                          shift ? Qt::ShiftModifier : Qt::NoModifier, c);
+      }
+    }
+  } else if (cmd == "key" && w.size() > 1) {
+    QString k = w[1].toLower();
+    Qt::Key key = Qt::Key_unknown;
+
+    if (k == "space") {
+      key = Qt::Key_Space;
+    } else if (k == "escape") {
+      key = Qt::Key_Escape;
+    } else if (k == "enter" || k == "shift+enter") {
+      key = Qt::Key_Return;
+    } else if (k.size() == 1) {
+      key = (Qt::Key) k.toUpper()[0].unicode();
+    }
+    // Through the window, so menu shortcuts (W, F, S...) fire too
+    QTest::keyClick(gui()->windowHandle(), key,
+                    k.startsWith("shift+") ? Qt::ShiftModifier
+                                           : Qt::NoModifier);
+  } else if (cmd == "research" && w.size() > 1) {
+    struct advance *padv
+      = advance_by_rule_name(QStringList(w.mid(1)).join(' ')
+                             .toUtf8().constData());
+
+    if (padv == nullptr) {
+      drive_log("   !! no such advance");
+    } else {
+      dsend_packet_player_research(&client.conn, advance_number(padv));
+    }
+  } else if (cmd == "clicktile" && w.size() > 2) {
+    struct unit *punit = focus_head();
+
+    if (punit == nullptr) {
+      drive_log("   !! no focus unit");
+    } else {
+      int x, y;
+      float cx, cy;
+      struct tile *ptile;
+
+      index_to_map_pos(&x, &y, tile_index(unit_tile(punit)));
+      ptile = map_pos_to_tile(&(wld.map), x + w[1].toInt(),
+                              y + w[2].toInt());
+      if (ptile == nullptr
+          || !tile_to_canvas_pos(&cx, &cy, map_zoom, ptile)) {
+        drive_log("   !! tile not on the canvas");
+      } else {
+        cx += tileset_tile_width(tileset) * map_zoom / 2;
+        cy += tileset_tile_height(tileset) * map_zoom / 2;
+        drive_log(QString("   tile (%1,%2) %3").arg(x + w[1].toInt())
+                  .arg(y + w[2].toInt())
+                  .arg(terrain_rule_name(tile_terrain(ptile))));
+        action_button_pressed(cx, cy, SELECT_POPUP);
+      }
+    }
+  } else if (cmd == "drag" && w.size() > 3) {
+    QPoint from, by;
+    bool ok = true;
+
+    if (w[1] == "unit") {
+      struct unit *punit = focus_head();
+      float cx, cy;
+
+      if (punit == nullptr
+          || !tile_to_canvas_pos(&cx, &cy, map_zoom, unit_tile(punit))) {
+        drive_log("   !! no focus unit on the canvas");
+        ok = false;
+      } else {
+        float density = (float) mapview.width / map_widget_width();
+
+        cx += tileset_tile_width(tileset) * map_zoom / 2;
+        cy += tileset_tile_height(tileset) * map_zoom / 2;
+        from = gui()->mapview_wdg->mapTo(gui(),
+                                         QPoint(qRound(cx / density),
+                                                qRound(cy / density)));
+        by = QPoint(w[2].toInt(), w[3].toInt());
+      }
+    } else if (w.size() > 4) {
+      from = QPoint(w[1].toInt(), w[2].toInt());
+      by = QPoint(w[3].toInt(), w[4].toInt());
+    } else {
+      ok = false;
+    }
+    if (ok) {
+      // Press, eight moves and release through the window, as a real drag
+      QWindow *win = gui()->windowHandle();
+      QWidget *under = gui()->childAt(from);
+
+      drive_log(QString("   drag from %1,%2 by %3,%4, under %5")
+                .arg(from.x()).arg(from.y()).arg(by.x()).arg(by.y())
+                .arg(under != nullptr ? under->metaObject()->className()
+                                      : "nothing"));
+      QApplication::setActiveWindow(gui());
+      // The map reads QCursor::pos() on a press, as on a real screen
+      QCursor::setPos(gui()->mapToGlobal(from));
+      QTest::mouseMove(win, from);
+      QTest::mousePress(win, Qt::LeftButton, Qt::NoModifier, from);
+      for (int i = 1; i <= 8; i++) {
+        QCursor::setPos(gui()->mapToGlobal(from + by * i / 8));
+        QTest::mouseMove(win, from + by * i / 8);
+      }
+      QTest::mouseRelease(win, Qt::LeftButton, Qt::NoModifier, from + by);
+    }
+  } else if (cmd == "mapwheel" && w.size() > 2) {
+    // Two-finger trackpad scroll by DX, DY points, or a mouse wheel's
+    // angle with "notch"
+    QWidget *mv = gui()->mapview_wdg;
+    QPoint local = mv->rect().center();
+    QPoint d(w[1].toInt(), w[2].toInt());
+    bool notch = (w.size() > 3 && w[3] == "notch");
+    QWheelEvent we(QPointF(local), QPointF(mv->mapToGlobal(local)),
+                   notch ? QPoint() : d, d, Qt::NoButton, Qt::NoModifier,
+                   notch ? Qt::NoScrollPhase : Qt::ScrollUpdate, false);
+
+    QApplication::sendEvent(mv, &we);
+  } else if (cmd == "scroll" && w.size() > 2) {
+    set_mapview_origin(mapview.gui_x0 + w[1].toInt(),
+                       mapview.gui_y0 + w[2].toInt(), map_zoom);
+  } else if (cmd == "option" && w.size() > 1) {
+    QString name = (w.size() > 2 ? w[1] : QString("gui_qt_freeciv45_panels"));
+
+    option_bool_set(optset_option_by_name(client_optset,
+                                          name.toUtf8().constData()),
+                    w.last() == "on");
+  } else if (cmd == "meet" && w.size() > 1) {
+    // meet <player number>: ask that player for a diplomacy meeting
+    dsend_packet_diplomacy_init_meeting_req(&client.conn, w[1].toInt());
+    drive_log(QString("meet %1").arg(w[1]));
+  } else if (cmd == "dtab" && w.size() > 1) {
+    // dtab <n>: show the n-th meeting in the open diplomacy dialog
+    QTabWidget *dd = qobject_cast<QTabWidget *>(gui()->game_tab_widget->currentWidget());
+
+    if (dd != nullptr) {
+      dd->setCurrentIndex(w[1].toInt());
+    }
+  } else if (cmd == "chat" && w.size() > 1) {
+    send_chat(QStringList(w.mid(1)).join(' ').toUtf8().constData());
+  } else if (cmd == "dismiss") {
+    if (QApplication::activePopupWidget() != nullptr) {
+      drive_log(QString("   closing %1").arg(
+                QApplication::activePopupWidget()->metaObject()->className()));
+      QApplication::activePopupWidget()->close();
+      QApplication::processEvents();
+    }
+    // Close modal boxes as a player's OK or close button would
+    for (int i = 0; i < 10 && QApplication::activeModalWidget() != nullptr;
+         i++) {
+      QWidget *m = QApplication::activeModalWidget();
+      QDialog *d = qobject_cast<QDialog *>(m);
+
+      drive_log(QString("   closing %1").arg(m->metaObject()->className()));
+      if (d != nullptr) {
+        d->reject();
+      } else {
+        m->close();
+      }
+      QApplication::processEvents();
+    }
+  } else if (cmd == "unit" && w.size() > 1) {
+    struct unit *punit = game_unit_by_number(w[1].toInt());
+
+    if (punit == nullptr) {
+      drive_log("   unit #" + w[1] + " not known");
+    } else {
+      int x, y;
+
+      index_to_map_pos(&x, &y, tile_index(unit_tile(punit)));
+      drive_log(QString("   unit #%1 %2 at (%3,%4) activity %5 moves %6"
+                        " orders %7")
+                .arg(punit->id).arg(unit_rule_name(punit)).arg(x).arg(y)
+                .arg(get_activity_text(punit->activity))
+                .arg(punit->moves_left)
+                .arg(punit->has_orders ? "yes" : "no"));
+    }
+  } else if (cmd == "opencity" && w.size() > 1) {
+    QString name = QStringList(w.mid(1)).join(' ');
+    struct city *found = nullptr;
+
+    if (client_player() != nullptr) {
+      city_list_iterate(client_player()->cities, pcity) {
+        if (name == city_name_get(pcity)) {
+          found = pcity;
+        }
+      } city_list_iterate_end;
+    }
+    if (found == nullptr) {
+      drive_log("   !! no such city");
+    } else {
+      qtg_real_city_dialog_popup(found);
+    }
+  } else if (cmd == "city" && w.size() > 1) {
+    QString name = QStringList(w.mid(1)).join(' ');
+    bool found = false;
+
+    if (client_player() != nullptr) {
+      city_list_iterate(client_player()->cities, pcity) {
+        if (name == city_name_get(pcity)) {
+          int x, y;
+
+          index_to_map_pos(&x, &y, tile_index(city_tile(pcity)));
+          drive_log(QString("   city %1 at (%2,%3) size %4 builds %5"
+                            " stock %6 bought %7 colored %8 gold %9")
+                    .arg(name).arg(x).arg(y).arg(city_size_get(pcity))
+                    .arg(universal_rule_name(&pcity->production))
+                    .arg(pcity->shield_stock)
+                    .arg(pcity->did_buy ? "yes" : "no")
+                    .arg(pcity->client.colored ? "yes" : "no")
+                    .arg(client_player()->economic.gold));
+          found = true;
+        }
+      } city_list_iterate_end;
+    }
+    if (!found) {
+      drive_log("   no own city " + name);
+    }
+  } else if (cmd == "chooser" && w.size() > 2) {
+    QAbstractItemView *view = nullptr;
+
+    foreach (QWidget *t, QApplication::topLevelWidgets()) {
+      if (t->isVisible() && t->inherits("production_widget")) {
+        view = qobject_cast<QAbstractItemView *>(t);
+      }
+    }
+    if (view == nullptr) {
+      drive_log("   !! no chooser open");
+    } else {
+      QModelIndex idx = view->model()->index(w[1].toInt(), w[2].toInt());
+
+      drive_log(QString("   chooser %1 rows, picking \"%2\"")
+                .arg(view->model()->rowCount())
+                .arg(idx.data(Qt::DisplayRole).toString()));
+      view->selectionModel()->select(idx,
+                                     QItemSelectionModel::ClearAndSelect);
+    }
+  } else if (cmd == "accept") {
+    QDialog *d = qobject_cast<QDialog *>(QApplication::activeModalWidget());
+
+    if (d == nullptr) {
+      // hud_message_box is shown non-modal; take the newest visible box
+      foreach (QWidget *t, QApplication::topLevelWidgets()) {
+        if (t->isVisible() && qobject_cast<QMessageBox *>(t) != nullptr) {
+          d = qobject_cast<QDialog *>(t);
+        }
+      }
+    }
+    if (d == nullptr) {
+      drive_log("   !! no box to accept");
+    } else {
+      drive_log(QString("   accepting %1").arg(d->metaObject()->className()));
+      d->accept();
+    }
+  } else if (cmd == "endturn") {
+    key_end_turn();
+  } else if (cmd == "page" && w.size() > 1 && w[1] == "main") {
+    gui()->switch_page(PAGE_MAIN);
+  } else if (cmd == "saveopts") {
+    // as on leaving the client: write the options file
+    options_save(NULL);
+  } else if (cmd == "pointer" && w.size() > 2) {
+    // Leave the pointer at X,Y in map-view points (negative or past the
+    // size is off the map) and log the map's origin there
+    QWidget *mv = gui()->mapview_wdg;
+    QPoint at(w[1].toInt(), w[2].toInt());
+
+    QApplication::setActiveWindow(gui());
+    QCursor::setPos(mv->mapToGlobal(at));
+    drive_log(QString("   pointer at %1,%2 of a %3x%4 map, origin %5,%6")
+              .arg(at.x()).arg(at.y()).arg(mv->width()).arg(mv->height())
+              .arg(mapview.gui_x0).arg(mapview.gui_y0));
+  } else if (cmd == "state") {
+    log_state(w.size() > 1 ? w[1] : QString());
+  } else if (cmd == "shot" && w.size() > 1) {
+    shot(w[1]);
+  } else if (cmd == "quit") {
+    // The runner kills the client once it sees this line: quitting
+    // in game opens a confirmation box.
+    drive_log("== quit");
+  }
+  drive_timer->setInterval(pace);
+}
+
+/************************************************************************//**
+  Timer tick: wait for a game with a focus unit, then run the lines
+****************************************************************************/
+static void tick()
+{
+  if (!started) {
+    if (client_state() == C_S_RUNNING && can_client_change_view()
+        && focus_head() != nullptr
+        && gui()->unitbar_wdg != nullptr) {
+      started = true;
+      gui()->raise();
+      gui()->activateWindow();
+      QApplication::setActiveWindow(gui());
+      drive_log(QString("== game running, starting the script"
+                        " (window active: %1)")
+                .arg(gui()->isActiveWindow() ? "yes" : "no"));
+      drive_timer->setInterval(3000);
+    }
+    return;
+  }
+  while (next_line < lines.size()) {
+    QString l = lines[next_line++].trimmed();
+
+    if (!l.isEmpty() && !l.startsWith('#')) {
+      run_line(l);
+      return;
+    }
+  }
+  drive_timer->stop();
+}
+
+/************************************************************************//**
+  Start the driver when FREECIV_UI_DRIVE names a script
+****************************************************************************/
+void ui_drive_start()
+{
+  const char *script = getenv("FREECIV_UI_DRIVE");
+  const char *out = getenv("FREECIV_UI_DRIVE_OUT");
+  QFile f;
+
+  if (script == nullptr || drive_timer != nullptr) {
+    return;
+  }
+  f.setFileName(script);
+  if (!f.open(QIODevice::ReadOnly | QIODevice::Text)) {
+    return;
+  }
+  lines = QString::fromUtf8(f.readAll()).split('\n');
+  out_dir = out != nullptr ? QString(out) : QDir::currentPath();
+  QDir().mkpath(out_dir);
+  drive_timer = new QTimer(gui());
+  QObject::connect(drive_timer, &QTimer::timeout, tick);
+  drive_timer->start(500);
+  // FREECIV_UI_DRIVE_NOW: run the lines from the start page on, without
+  // waiting for a game (for "Start new game" checks)
+  if (getenv("FREECIV_UI_DRIVE_NOW") != nullptr) {
+    started = true;
+    drive_log("== starting the script at once");
+  }
+}
