+/************************************************************************//**
+  Append to drive.log
+****************************************************************************/
+static void drive_log(const QString &s)
+{
+  QFile f(out_dir + "/drive.log");
+
+  if (f.open(QIODevice::Append | QIODevice::Text)) {
+    QTextStream ts(&f);
+
+    ts << s << "\n";
+  }
+}
