+/************************************************************************//**
+  The head focus unit, or nullptr; before a game there is no focus list
+****************************************************************************/
+static struct unit *focus_head()
+{
+  return get_num_units_in_focus() > 0 ? head_of_units_in_focus() : nullptr;
+}
