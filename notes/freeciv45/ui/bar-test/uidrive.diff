+/************************************************************************//**
+  One line describing the client's unit focus and the bar
+****************************************************************************/
+static void log_state(const QString &label)
+{
+  QString s = QString("== %1  turn %2").arg(label).arg(game.info.turn);
+
+  s += QString("  title \"%1\"").arg(gui()->windowTitle());
+  s += QString("  tileset %1  ruleset \"%2\"")
+       .arg(tileset != nullptr ? tileset_basename(tileset) : "none")
+       .arg(game.control.name);
+  unit_bar *bar = gui()->unitbar_wdg;
+  QStringList chips, acts, texts;
+
+  s += QString("  hover_state %1").arg((int) hover_state);
+  if (get_num_units_in_focus() > 0) {
+    unit_list_iterate(get_units_in_focus(), punit) {
+      int x, y;
+
+      index_to_map_pos(&x, &y, tile_index(unit_tile(punit)));
+      s += QString("\n   focus #%1 %2 at (%3,%4) activity %5 moves %6 hp %7"
+                   " orders %8 done %9 ssa %10")
+           .arg(punit->id).arg(unit_rule_name(punit)).arg(x).arg(y)
+           .arg(get_activity_text(punit->activity))
+           .arg(punit->moves_left).arg(punit->hp)
+           .arg(punit->has_orders ? "yes" : "no")
+           .arg(punit->done_moving ? "yes" : "no")
+           .arg((int) punit->ssa_controller);
+    } unit_list_iterate_end;
+  }
+  if (get_num_units_in_focus() == 0) {
+    s += "\n   focus: none";
+  } else {
+    s += "\n   stack";
+    unit_list_iterate(unit_tile(focus_head())->units, punit) {
+      if (unit_owner(punit) == client_player()) {
+        s += QString(" #%1:%2%3").arg(punit->id)
+             .arg(get_activity_text(punit->activity))
+             .arg(punit->done_moving ? "(done)" : "");
+      }
+    } unit_list_iterate_end;
+  }
+  s += QString("\n   window active %1")
+       .arg(gui()->isActiveWindow() ? "yes" : "no");
+  if (bar != nullptr) {
+    foreach (QLabel *l, visible_in_bar<QLabel>()) {
+      texts << l->text();
+    }
+    foreach (unit_chip *c, visible_in_bar<unit_chip>()) {
+      chips << c->toolTip();
+    }
+    foreach (unit_action_button *b, visible_in_bar<unit_action_button>()) {
+      acts << b->toolTip();
+    }
+    s += QString("\n   bar visible %1 at %2,%3 %4x%5")
+         .arg(bar->isVisible() ? "yes" : "no")
+         .arg(bar->x()).arg(bar->y()).arg(bar->width()).arg(bar->height());
+    if (bar->isVisible()) {
+      s += QString("\n   labels [%1]\n   chips [%2]\n   actions [%3]")
+           .arg(texts.join(" | "), chips.join(" | "), acts.join(" | "));
+    }
+  }
+  {
+    // The city overlay's parts, found by their theme names
+    QStringList parts;
+    const char *names[] = { "city_yields", "city_sections",
+                            "city_production", "city_footer" };
+
+    for (const char *n : names) {
+      QWidget *p = gui()->findChild<QWidget *>(n);
+
+      if (p != nullptr && p->isVisible()) {
+        parts << QString("%1 %2,%3 %4x%5").arg(n).arg(p->x()).arg(p->y())
+                 .arg(p->width()).arg(p->height());
+      }
+    }
+    if (!parts.isEmpty()) {
+      QStringList otexts;
+
+      foreach (QLabel *l, gui()->findChildren<QLabel *>()) {
+        if (l->isVisible() && !l->text().isEmpty()
+            && l->parentWidget() != nullptr
+            && l->window() == gui()
+            && QString(l->parentWidget()->objectName()).startsWith("city_")) {
+          otexts << l->text().simplified();
+        }
+      }
+      s += QString("\n   city overlay [%1]\n   overlay text [%2]")
+           .arg(parts.join(" | "), otexts.join(" | "));
+    }
+    s += QString("\n   minimap visible %1, chat visible %2")
+         .arg(gui()->minimapview_wdg->isVisible() ? "yes" : "no")
+         .arg(gui()->infotab->isVisible() ? "yes" : "no");
+  }
+  {
+    // The Freeciv45 edges: top strip, edge column, and the old sidebar
+    QWidget *strip = gui()->findChild<QWidget *>("top_strip");
+    QWidget *col = gui()->findChild<QWidget *>("edge_column");
+    QWidget *tab = gui()->game_tab_widget->currentWidget();
+
+    if (strip != nullptr && strip->isVisible()) {
+      QStringList stexts;
+
+      foreach (QAbstractButton *b, strip->findChildren<QAbstractButton *>()) {
+        if (b->isVisible()) {
+          stexts << b->text() + (b->isEnabled() ? "" : " (disabled)")
+                    + (b->property("attention").toBool() ? " (!)" : "");
+        }
+      }
+      s += QString("\n   top strip %1x%2 [%3]").arg(strip->width())
+           .arg(strip->height()).arg(stexts.join(" | "));
+      {
+        QToolButton *ind = strip->findChild<QToolButton *>("strip_indicators");
+
+        if (ind != nullptr) {
+          QPoint at = ind->mapTo(gui(), QPoint(0, 0));
+
+          s += QString("\n   indicators %1,%2 %3x%4 icon %5x%6 tip \"%7\"")
+               .arg(at.x()).arg(at.y()).arg(ind->width()).arg(ind->height())
+               .arg(ind->iconSize().width()).arg(ind->iconSize().height())
+               .arg(ind->toolTip().replace('\n', " / "));
+        }
+      }
+    } else {
+      s += "\n   top strip hidden";
+    }
+    if (col != nullptr && col->isVisible()) {
+      QStringList tips;
+
+      foreach (QAbstractButton *b, col->findChildren<QAbstractButton *>()) {
+        if (b->isVisible()) {
+          tips << (b->text().isEmpty()
+                   ? b->toolTip().replace('\n', " / ")
+                   : b->text() + " " + b->toolTip().replace('\n', " / "));
+        }
+      }
+      s += QString("\n   edge column %1,%2 %3x%4 [%5]").arg(col->x())
+           .arg(col->y()).arg(col->width()).arg(col->height())
+           .arg(tips.join(" | "));
+    } else {
+      s += "\n   edge column hidden";
+    }
+    {
+      QWidget *wn = gui()->findChild<QWidget *>("what_next_button");
+      QWidget *mm = gui()->minimapview_wdg;
+
+      if (wn != nullptr && wn->isVisible()) {
+        QLabel *t = wn->findChild<QLabel *>("what_next_text");
+        QLabel *c = wn->findChild<QLabel *>("what_next_count");
+
+        s += QString("\n   what next %1,%2 %3x%4 [%5%6] step %7%8"
+                     " (minimap %9,%10 %11x%12)")
+             .arg(wn->x()).arg(wn->y()).arg(wn->width()).arg(wn->height())
+             .arg(t != nullptr ? t->text() : QString())
+             .arg(c != nullptr && c->isVisible() ? " | " + c->text()
+                                                  : QString())
+             .arg(wn->property("step").toString())
+             .arg(wn->isEnabled() ? "" : " (disabled)")
+             .arg(mm->x()).arg(mm->y()).arg(mm->width()).arg(mm->height());
+      } else {
+        s += "\n   what next hidden";
+      }
+    }
+    s += QString("\n   sidebar visible %1, game tab %2 (%3)")
+         .arg(gui()->sidebar_wdg->isVisible() ? "yes" : "no")
+         .arg(gui()->game_tab_widget->currentIndex())
+         .arg(tab != nullptr ? tab->metaObject()->className() : "none");
+    s += QString(" of %1 [").arg(gui()->game_tab_widget->count());
+    for (int ti = 0; ti < gui()->game_tab_widget->count(); ti++) {
+      s += QString(" %1").arg(gui()->game_tab_widget->widget(ti)->metaObject()->className());
+    }
+    s += " ]";
+  }
+  s += QString("\n   hud_units visible %1")
+       .arg(gui()->unitinfo_wdg->isVisible() ? "yes" : "no");
+  s += QString("\n   map origin %1,%2").arg(mapview.gui_x0).arg(mapview.gui_y0);
+  s += QString("\n   move range %1 tiles%2").arg(move_range_size())
+         .arg(move_range_hidden() ? " (hidden)" : "");
+  {
+    QStringList tops;
+
+    foreach (QWidget *w, QApplication::topLevelWidgets()) {
+      if (w->isVisible() && w != gui() && !w->inherits("QTipLabel")) {
+        QMessageBox *mb = qobject_cast<QMessageBox *>(w);
+
+        QMenu *menu = qobject_cast<QMenu *>(w);
+        QString items;
+
+        if (menu != nullptr) {
+          QStringList names;
+
+          foreach (QAction *a, menu->actions()) {
+            if (!a->isSeparator()) {
+              names << a->text() + (a->isEnabled() ? "" : " (off)");
+            }
+          }
+          items = QString(" [%1 items: %2]").arg(names.size())
+                  .arg(QStringList(names.mid(0, 6)).join(", "));
+        }
+        tops << QString(w->metaObject()->className())
+                + (w->isModal() ? " (modal)" : "")
+                + (mb != nullptr ? " \"" + mb->text().left(80) + "\"" : "")
+                + items;
+      }
+    }
+    s += QString("\n   other windows [%1]").arg(tops.join(", "));
+    if (QApplication::activeModalWidget() != nullptr) {
+      s += QString("\n   active modal %1").arg(
+           QApplication::activeModalWidget()->metaObject()->className());
+    }
+  }
+  s += QString("\n   tooltip %1")
+       .arg(QToolTip::isVisible() ? "\"" + QToolTip::text() + "\"" : "none");
+  drive_log(s);
+}
