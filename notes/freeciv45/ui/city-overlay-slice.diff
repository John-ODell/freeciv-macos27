+/************************************************************************//**
+  A section: a flat heading button with an arrow, and a body under it.
+****************************************************************************/
+city_section::city_section(const QString &section_key, QWidget *parent)
+  : QWidget(parent)
+{
+  QVBoxLayout *box = new QVBoxLayout(this);
+  QFont bold = font();
+
+  key = section_key;
+  setObjectName("city_section");
+  box->setContentsMargins(0, 0, 0, 0);
+  box->setSpacing(4);
+  heading = new QToolButton(this);
+  heading->setAutoRaise(true);
+  heading->setToolButtonStyle(Qt::ToolButtonTextBesideIcon);
+  heading->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+  heading->setFocusPolicy(Qt::TabFocus);
+  bold.setBold(true);
+  heading->setFont(bold);
+  connect(heading, &QToolButton::clicked, this, &city_section::toggle);
+  body = new QWidget(this);
+  body_box = new QVBoxLayout(body);
+  body_box->setContentsMargins(18, 0, 0, 4);
+  body_box->setSpacing(2);
+  box->addWidget(heading);
+  box->addWidget(body);
+  apply_fold();
+}
+
+/************************************************************************//**
+  Set the heading's text.
+****************************************************************************/
+void city_section::set_title(const QString &t)
+{
+  title = t;
+  heading->setText(title);
+}
+
+/************************************************************************//**
+  Remove the body's widgets. A refresh can come from inside one of them,
+  so they are deleted later.
+****************************************************************************/
+void city_section::clear_body()
+{
+  QLayoutItem *item;
+
+  while ((item = body_box->takeAt(0)) != nullptr) {
+    if (item->widget() != nullptr) {
+      item->widget()->hide();
+      item->widget()->deleteLater();
+    }
+    delete item;
+  }
+}
+
+/************************************************************************//**
+  Fold or unfold, and remember it.
+****************************************************************************/
+void city_section::toggle()
+{
+  if (folded_sections.contains(key)) {
+    folded_sections.remove(key);
+  } else {
+    folded_sections.insert(key);
+  }
+  apply_fold();
+  // The column shrinks or grows with it, now rather than on the next
+  // layout pass, so it is the right size before it repaints
+  layout()->invalidate();
+  layout()->activate();
+  if (parentWidget() != nullptr && parentWidget()->layout() != nullptr) {
+    parentWidget()->layout()->invalidate();
+    parentWidget()->layout()->activate();
+    parentWidget()->adjustSize();
+  }
+}
+
+/************************************************************************//**
+  Show the body and the arrow for the current fold state.
+****************************************************************************/
+void city_section::apply_fold()
+{
+  bool folded = folded_sections.contains(key);
+
+  heading->setArrowType(folded ? Qt::RightArrow : Qt::DownArrow);
+  body->setVisible(!folded);
+}
