+/************************************************************************//**
+  A sprite's pixmap scaled to a logical height, sharp at the widget's
+  pixel ratio.
+****************************************************************************/
+static QPixmap sprite_pixmap(struct sprite *spr, int height, qreal dpr)
+{
+  QPixmap pm;
+
+  if (spr == nullptr || spr->pm == nullptr || spr->pm->isNull()) {
+    return pm;
+  }
+  pm = spr->pm->scaledToHeight(qRound(height * dpr),
+                               Qt::SmoothTransformation);
+  pm.setDevicePixelRatio(dpr);
+
+  return pm;
+}
