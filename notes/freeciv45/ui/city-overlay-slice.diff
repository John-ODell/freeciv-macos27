+/************************************************************************//**
+  Yields: a title line, a growth line, then a row of name / value tiles.
+****************************************************************************/
+city_yields::city_yields(QWidget *parent) : city_part("city_yields", parent)
+{
+  QFont small_font = *fc_font::instance()->get_font(fonts::notify_label);
+  QVBoxLayout *box = new QVBoxLayout(this);
+  QGridLayout *grid = new QGridLayout;
+  // TRANS: city overlay yield tiles; keep short
+  const char *names[] = { N_("Food"), N_("Shields"), N_("Trade"),
+                          N_("Gold"), N_("Luxury"), N_("Science"),
+                          N_("Culture") };
+
+  box->setContentsMargins(10, 8, 10, 8);
+  box->setSpacing(2);
+  title_label = new QLabel(this);
+  growth_label = new QLabel(this);
+  growth_label->setFont(small_font);
+  box->addWidget(title_label);
+  box->addWidget(growth_label);
+
+  grid->setHorizontalSpacing(8);
+  grid->setVerticalSpacing(0);
+  for (int i = 0; i < (int) ARRAY_SIZE(names); i++) {
+    QLabel *n = new QLabel(QString(_(names[i])), this);
+    QLabel *v = new QLabel(this);
+    QFont bold = v->font();
+
+    n->setFont(small_font);
+    n->setAlignment(Qt::AlignHCenter);
+    bold.setBold(true);
+    v->setFont(bold);
+    v->setAlignment(Qt::AlignHCenter);
+    grid->addWidget(n, 0, i);
+    grid->addWidget(v, 1, i);
+    name_labels.append(n);
+    value_labels.append(v);
+  }
+  box->addLayout(grid);
+  setFixedWidth(YIELDS_WIDTH);
+}
+
+/************************************************************************//**
+  Fill the yields from the city, the way the full dialog's info panel
+  does (citydlg.cpp, update_info_label).
+****************************************************************************/
+void city_yields::refresh(struct city *pcity)
+{
+  char buf[1024];
+  int turns = city_turns_to_grow(pcity);
+  QString growth;
+  const Output_type_id outputs[] = { O_FOOD, O_SHIELD, O_TRADE, O_GOLD,
+                                     O_LUXURY, O_SCIENCE };
+
+  // TRANS: city overlay title: city name, size
+  title_label->setText(QString(_("<b>%1</b>   size %2"))
+                       .arg(QString(city_name_get(pcity)).toHtmlEscaped(),
+                            QString::number(city_size_get(pcity))));
+
+  if (turns == 0) {
+    growth = QString(_("growth blocked"));
+  } else if (turns == FC_INFINITY) {
+    growth = QString(_("not growing"));
+  } else if (turns < 0) {
+    growth = QString(PL_("starving in %1 turn", "starving in %1 turns",
+                         -turns)).arg(-turns);
+  } else {
+    growth = QString(PL_("grows in %1 turn", "grows in %1 turns",
+                         turns)).arg(turns);
+  }
+  // TRANS: city overlay: growth, then granary stock / size
+  growth_label->setText(QString(_("%1   granary %2/%3"))
+                        .arg(growth,
+                             QString::number(pcity->food_stock),
+                             QString::number(
+                               city_granary_size(city_size_get(pcity)))));
+
+  for (int i = 0; i < (int) ARRAY_SIZE(outputs); i++) {
+    Output_type_id o = outputs[i];
+    QString val;
+
+    if (o == O_LUXURY || o == O_SCIENCE) {
+      val = QString::number(pcity->prod[o]);
+    } else {
+      val = QString::asprintf("%+d", pcity->surplus[o]);
+    }
+    value_labels[i]->setText(val);
+    get_city_dialog_output_text(pcity, o, buf, sizeof(buf));
+    value_labels[i]->setToolTip("<pre>" + QString(buf).toHtmlEscaped()
+                                + "</pre>");
+    name_labels[i]->setToolTip(value_labels[i]->toolTip());
+  }
+  value_labels.last()->setText(QString::number(pcity->client.culture));
+  get_city_dialog_culture_text(pcity, buf, sizeof(buf));
+  value_labels.last()->setToolTip("<pre>" + QString(buf).toHtmlEscaped()
+                                  + "</pre>");
+  name_labels.last()->setToolTip(value_labels.last()->toolTip());
+  adjustSize();
+}
