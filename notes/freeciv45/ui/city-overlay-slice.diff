+/************************************************************************//**
+  The column may not grow past the map; the buildings list scrolls.
+****************************************************************************/
+void city_sections::set_max_height(int h)
+{
+  // Room for the margins, two headings and the citizens row
+  scroll_max = qMax(60, h - 140);
+  buildings_scroll->setFixedHeight(qMin(buildings_list->sizeHint().height(),
+                                        scroll_max));
+  setMaximumHeight(h);
+}
+
+/************************************************************************//**
+  Citizens: the tileset's citizen icons in their final mood, then a
+  count line.
+****************************************************************************/
+void city_sections::fill_citizens(struct city *pcity)
+{
+  enum citizen_category categories[MAX_CITY_SIZE];
+  int n = get_city_citizen_types(pcity, FEELING_FINAL, categories);
+  qreal dpr = devicePixelRatioF();
+  int avail = SECTIONS_WIDTH - 16 - 18;
+  int w = 0, h = 0, per_row, rows;
+  QPixmap row_pix;
+  QLabel *icons, *counts;
+  QStringList parts;
+
+  citizens->clear_body();
+  // TRANS: city overlay section heading
+  citizens->set_title(QString(_("Citizens")));
+
+  if (n > 0) {
+    struct sprite *first = get_citizen_sprite(tileset, categories[0], 0,
+                                              pcity);
+
+    if (first != nullptr && first->pm != nullptr) {
+      w = first->pm->width();
+      h = first->pm->height();
+    }
+  }
+  if (w > 0 && h > 0) {
+    QPainter p;
+
+    per_row = qMax(1, avail / w);
+    rows = (n + per_row - 1) / per_row;
+    row_pix = QPixmap(qRound(qMin(n, per_row) * w * dpr),
+                      qRound(rows * h * dpr));
+    row_pix.setDevicePixelRatio(dpr);
+    row_pix.fill(Qt::transparent);
+    p.begin(&row_pix);
+    for (int i = 0; i < n; i++) {
+      struct sprite *spr = get_citizen_sprite(tileset, categories[i], i,
+                                              pcity);
+
+      if (spr != nullptr && spr->pm != nullptr) {
+        p.drawPixmap((i % per_row) * w, (i / per_row) * h, *spr->pm);
+      }
+    }
+    p.end();
+    icons = new QLabel(this);
+    icons->setPixmap(row_pix);
+    citizens->body_layout()->addWidget(icons);
+    icons->show();
+  }
+
+  if (pcity->feel[CITIZEN_HAPPY][FEELING_FINAL] > 0) {
+    parts << QString(_("%1 happy"))
+             .arg(pcity->feel[CITIZEN_HAPPY][FEELING_FINAL]);
+  }
+  if (pcity->feel[CITIZEN_CONTENT][FEELING_FINAL] > 0) {
+    parts << QString(_("%1 content"))
+             .arg(pcity->feel[CITIZEN_CONTENT][FEELING_FINAL]);
+  }
+  if (pcity->feel[CITIZEN_UNHAPPY][FEELING_FINAL] > 0) {
+    parts << QString(_("%1 unhappy"))
+             .arg(pcity->feel[CITIZEN_UNHAPPY][FEELING_FINAL]);
+  }
+  if (pcity->feel[CITIZEN_ANGRY][FEELING_FINAL] > 0) {
+    parts << QString(_("%1 angry"))
+             .arg(pcity->feel[CITIZEN_ANGRY][FEELING_FINAL]);
+  }
+  specialist_type_iterate(sp) {
+    if (pcity->specialists[sp] > 0) {
+      parts << QString("%1 %2").arg(pcity->specialists[sp])
+               .arg(specialist_plural_translation(specialist_by_number(sp)));
+    }
+  } specialist_type_iterate_end;
+  counts = new QLabel(parts.join(", "), this);
+  counts->setFont(*fc_font::instance()->get_font(fonts::notify_label));
+  counts->setWordWrap(true);
+  citizens->body_layout()->addWidget(counts);
+  counts->show();
+}
+
+/************************************************************************//**
+  Buildings: what the city has, wonders first, upkeep in the heading;
+  each row's tooltip is the building's help, as in the full dialog.
+****************************************************************************/
+void city_sections::fill_buildings(struct city *pcity)
+{
+  struct universal targets[MAX_NUM_PRODUCTION_TARGETS];
+  struct item items[MAX_NUM_PRODUCTION_TARGETS];
+  int used, upkeep = 0;
+  QList<const struct impr_type *> wonders, others;
+  qreal dpr = devicePixelRatioF();
+  QLayoutItem *item;
+
+  while ((item = buildings_box->takeAt(0)) != nullptr) {
+    if (item->widget() != nullptr) {
+      item->widget()->hide();
+      item->widget()->deleteLater();
+    }
+    delete item;
+  }
+
+  used = collect_already_built_targets(targets, pcity);
+  name_and_sort_items(targets, used, items, false, pcity);
+  for (int i = 0; i < used; i++) {
+    const struct impr_type *pimprove = items[i].item.value.building;
+
+    if (items[i].item.kind != VUT_IMPROVEMENT) {
+      continue;
+    }
+    upkeep += city_improvement_upkeep(pcity, pimprove);
+    if (is_wonder(pimprove)) {
+      wonders.append(pimprove);
+    } else {
+      others.append(pimprove);
+    }
+  }
+
+  // TRANS: city overlay section heading: buildings, their upkeep
+  buildings->set_title(QString(_("Buildings (upkeep %1)")).arg(upkeep));
+
+  foreach (const struct impr_type *pimprove, wonders + others) {
+    QWidget *row = new QWidget(buildings_list);
+    QHBoxLayout *h = new QHBoxLayout(row);
+    QLabel *pix = new QLabel(row);
+    QLabel *name = new QLabel(QString(city_improvement_name_translation(
+                                        pcity, pimprove)), row);
+
+    h->setContentsMargins(0, 0, 0, 0);
+    h->setSpacing(6);
+    pix->setFixedSize(BUILDING_IMAGE * 3 / 2, BUILDING_IMAGE);
+    pix->setPixmap(sprite_pixmap(get_building_sprite(tileset, pimprove),
+                                 BUILDING_IMAGE, dpr));
+    if (is_wonder(pimprove)) {
+      QFont bold = name->font();
+
+      bold.setBold(true);
+      name->setFont(bold);
+    }
+    h->addWidget(pix);
+    h->addWidget(name, 1);
+    row->setToolTip(get_tooltip_improvement(pimprove, pcity, true)
+                    .trimmed());
+    buildings_box->addWidget(row);
+    row->show();
+  }
+  if (wonders.isEmpty() && others.isEmpty()) {
+    QLabel *none = new QLabel(QString(_("None yet")), buildings_list);
+
+    buildings_box->addWidget(none);
+    none->show();
+  }
+  // As tall as the list, up to what the map leaves; then it scrolls
+  buildings_scroll->setFixedHeight(qMin(buildings_list->sizeHint().height(),
+                                        scroll_max));
+}
+
+/************************************************************************//**
+  Production: Change and Buy on top, then the build with its image, the
+  shields and turns line, and a progress bar.
+****************************************************************************/
+city_production::city_production(QWidget *parent)
+  : city_part("city_production", parent)
+{
+  QVBoxLayout *box = new QVBoxLayout(this);
+  QHBoxLayout *buttons = new QHBoxLayout;
+  QHBoxLayout *build = new QHBoxLayout;
+  QVBoxLayout *text = new QVBoxLayout;
+  QFont bold;
+
+  city_id = 0;
+  box->setContentsMargins(10, 8, 10, 10);
+  box->setSpacing(6);
+  // TRANS: city overlay production button
+  change_button = new QPushButton(QString(_("Change")), this);
+  change_button->setToolTip(QString(_("Choose what the city builds")));
+  buy_button = new QPushButton(QString(_("Buy")), this);
+  connect(change_button, &QPushButton::clicked,
+          this, &city_production::change);
+  connect(buy_button, &QPushButton::clicked, this, &city_production::buy);
+  buttons->addWidget(change_button);
+  buttons->addWidget(buy_button);
+  buttons->addStretch(1);
+  box->addLayout(buttons);
+
+  pix_label = new QLabel(this);
+  pix_label->setFixedSize(PRODUCTION_IMAGE * 3 / 2, PRODUCTION_IMAGE);
+  pix_label->setAlignment(Qt::AlignCenter);
+  name_label = new QLabel(this);
+  bold = name_label->font();
+  bold.setBold(true);
+  name_label->setFont(bold);
+  turns_label = new QLabel(this);
+  turns_label->setFont(*fc_font::instance()->get_font(fonts::notify_label));
+  progress = new QProgressBar(this);
+  progress->setTextVisible(false);
+  progress->setFixedHeight(6);
+  text->setSpacing(2);
+  text->addWidget(name_label);
+  text->addWidget(turns_label);
+  text->addWidget(progress);
+  build->setSpacing(10);
+  build->addWidget(pix_label);
+  build->addLayout(text, 1);
+  box->addLayout(build);
+  setFixedWidth(PRODUCTION_WIDTH);
+}
+
+/************************************************************************//**
+  Fill from the city's current build, as the full dialog's production
+  bar and Buy button do (citydlg.cpp, update_building and
+  update_buy_button).
+****************************************************************************/
+void city_production::refresh(struct city *pcity)
+{
+  char buf[64];
+  int cost = city_production_build_shield_cost(pcity);
+  int value = pcity->client.buy_cost;
+  struct sprite *spr = nullptr;
+  bool can_buy = city_can_buy(pcity);
+  int gold = (client_player() != nullptr)
+             ? client_player()->economic.gold : 0;
+
+  city_id = pcity->id;
+  if (pcity->production.kind == VUT_UTYPE) {
+    spr = get_unittype_sprite(tileset, pcity->production.value.utype,
+                              ACTIVITY_LAST, direction8_invalid());
+  } else if (pcity->production.kind == VUT_IMPROVEMENT) {
+    spr = get_building_sprite(tileset, pcity->production.value.building);
+  }
+  pix_label->setPixmap(sprite_pixmap(spr, PRODUCTION_IMAGE,
+                                     devicePixelRatioF()));
+  name_label->setText(QString(city_production_name_translation(pcity)));
+  get_city_dialog_production(pcity, buf, sizeof(buf));
+  turns_label->setText(QString(buf).simplified());
+  progress->setRange(0, qMax(1, cost));
+  progress->setValue(qBound(0, pcity->shield_stock, qMax(1, cost)));
+
+  buy_button->setText(QString(PL_("Buy (%1 gold)", "Buy (%1 gold)", value))
+                      .arg(value));
+  change_button->setEnabled(can_client_issue_orders());
+  if (!can_buy) {
+    buy_button->setEnabled(false);
+    if (pcity->did_buy) {
+      buy_button->setToolTip(QString(_("Already bought this turn")));
+    } else if (pcity->turn_founded == game.info.turn) {
+      buy_button->setToolTip(QString(_("Cannot buy in the turn the city "
+                                       "was founded")));
+    } else {
+      buy_button->setToolTip(QString(_("This cannot be bought now")));
+    }
+  } else if (gold < value) {
+    buy_button->setEnabled(false);
+    buy_button->setToolTip(QString(PL_("Treasury contains %1 gold.",
+                                       "Treasury contains %1 gold.",
+                                       gold)).arg(gold));
+  } else {
+    buy_button->setEnabled(true);
+    buy_button->setToolTip(QString(PL_("Treasury contains %1 gold.",
+                                       "Treasury contains %1 gold.",
+                                       gold)).arg(gold));
+  }
+  adjustSize();
+}
+
+/************************************************************************//**
+  Open the full dialog's production chooser for this city; a click
+  there changes the build now.
+****************************************************************************/
+void city_production::change()
+{
+  struct city *pcity = game_city_by_number(city_id);
+  production_widget *pw;
+
+  if (pcity == nullptr || !can_client_issue_orders()) {
+    return;
+  }
+  pw = new production_widget(this, pcity, false, 0, 0, true);
+  pw->show();
+}
+
+/************************************************************************//**
+  Ask, then buy, as the full dialog does.
+****************************************************************************/
+void city_production::buy()
+{
+  char buf[1024], buf2[1024];
+  struct city *pcity = game_city_by_number(city_id);
+  hud_message_box *ask;
+  int id = city_id;
+
+  if (pcity == nullptr || !can_client_issue_orders()) {
+    return;
+  }
+  ask = new hud_message_box(gui()->central_wdg);
+  fc_snprintf(buf2, ARRAY_SIZE(buf2), PL_("Treasury contains %d gold.",
+                                          "Treasury contains %d gold.",
+                                          client_player()->economic.gold),
+              client_player()->economic.gold);
+  fc_snprintf(buf, ARRAY_SIZE(buf), PL_("Buy %s for %d gold?",
+                                        "Buy %s for %d gold?",
+                                        pcity->client.buy_cost),
+              city_production_name_translation(pcity),
+              pcity->client.buy_cost);
+  ask->set_text_title(buf, buf2);
+  ask->setStandardButtons(QMessageBox::Cancel | QMessageBox::Ok);
+  ask->setDefaultButton(QMessageBox::Cancel);
+  ask->setAttribute(Qt::WA_DeleteOnClose);
+  connect(ask, &hud_message_box::accepted, this, [=]() {
+    struct city *bcity = game_city_by_number(id);
+
+    if (bcity != nullptr) {
+      city_buy_production(bcity);
+    }
+  });
+  ask->show();
+}
+
+/************************************************************************//**
+  Footer: Full dialog (Enter) and Return to map (Escape).
+****************************************************************************/
+city_footer::city_footer(QWidget *parent) : city_part("city_footer", parent)
+{
+  QHBoxLayout *box = new QHBoxLayout(this);
+  QPushButton *full, *back;
+
+  box->setContentsMargins(8, 6, 8, 6);
+  box->setSpacing(8);
+  // TRANS: city overlay footer button
+  full = new QPushButton(QString(_("Full dialog")), this);
+  full->setToolTip(QString(_("Open the city dialog (Enter)")));
+  // TRANS: city overlay footer button
+  back = new QPushButton(QString(_("Return to map")), this);
+  back->setToolTip(QString(_("Close the city view (Escape)")));
+  box->addWidget(full);
+  box->addWidget(back);
+  connect(full, &QPushButton::clicked, this, [=]() {
+    gui()->cityoverlay_wdg->full_dialog();
+  });
+  connect(back, &QPushButton::clicked, this, [=]() {
+    gui()->cityoverlay_wdg->close_overlay();
+  });
+  setFixedWidth(FOOTER_WIDTH);
+}
+
+/************************************************************************//**
+  The overlay: four parts on the map view, all hidden until a city opens.
+****************************************************************************/
+city_overlay::city_overlay(QWidget *map_view) : QObject(map_view)
+{
+  map = map_view;
+  city_id = 0;
+  colored_here = false;
+  minimap_was_visible = false;
+  chat_was_visible = false;
+  yields = new city_yields(map);
+  sections = new city_sections(map);
+  production = new city_production(map);
+  footer = new city_footer(map);
+}
+
+/************************************************************************//**
+  The city shown, or nullptr when closed or the city is gone.
+****************************************************************************/
+struct city *city_overlay::shown_city() const
+{
+  return (city_id != 0) ? game_city_by_number(city_id) : nullptr;
+}
+
+/************************************************************************//**
+  Draw or stop drawing the city's worked tiles on the map.
+****************************************************************************/
+void city_overlay::set_colored(struct city *pcity, bool on)
+{
+  if (pcity != nullptr && (pcity->client.colored ? 1 : 0) != (on ? 1 : 0)) {
+    toggle_city_color(pcity);
+  }
+}
+
+/************************************************************************//**
+  Open the overlay for a city, or swap to it when open for another one.
+  The map centres on the city and draws its worked tiles; the unit bar,
+  the minimap and the chat give the edges up until it closes.
+****************************************************************************/
+void city_overlay::open_for(struct city *pcity)
+{
+  struct city *old = shown_city();
+
+  if (pcity == nullptr) {
+    return;
+  }
+  if (old != pcity) {
+    if (old != nullptr && colored_here) {
+      set_colored(old, false);
+    }
+    colored_here = !pcity->client.colored;
+    set_colored(pcity, true);
+  }
+  if (!is_open()) {
+    minimap_was_visible = gui()->minimapview_wdg->isVisible();
+    chat_was_visible = gui()->infotab->isVisible();
+    gui()->minimapview_wdg->hide();
+    gui()->infotab->hide();
+  }
+  city_id = pcity->id;
+  if (gui()->unitbar_wdg != nullptr) {
+    gui()->unitbar_wdg->hide();
+  }
+  center_tile_mapcanvas(city_tile(pcity));
+  refresh();
+}
+
+/************************************************************************//**
+  Fill the parts from the city; close when it is gone or no longer ours.
+****************************************************************************/
+void city_overlay::refresh()
+{
+  struct city *pcity = shown_city();
+
+  if (!is_open()) {
+    return;
+  }
+  if (pcity == nullptr || city_owner(pcity) != client_player()) {
+    close_overlay();
+    return;
+  }
+  if (!pcity->client.colored) {
+    // A new turn turns every city's worked-tile drawing off
+    // (packhand.c, handle_start_phase); keep it on while open.
+    set_colored(pcity, true);
+    colored_here = true;
+  }
+  yields->refresh(pcity);
+  sections->refresh(pcity);
+  production->refresh(pcity);
+  place();
+  yields->show();
+  sections->show();
+  production->show();
+  footer->show();
+  yields->raise();
+  sections->raise();
+  production->raise();
+  footer->raise();
+}
+
+/************************************************************************//**
+  Close: hide the parts, stop drawing the worked tiles if the overlay
+  started it, give the edges back. The map stays where it is.
+****************************************************************************/
+void city_overlay::close_overlay()
+{
+  struct city *pcity = shown_city();
+
+  if (!is_open()) {
+    return;
+  }
+  if (colored_here) {
+    set_colored(pcity, false);
+  }
+  colored_here = false;
+  city_id = 0;
+  yields->hide();
+  sections->hide();
+  production->hide();
+  footer->hide();
+  if (minimap_was_visible) {
+    gui()->minimapview_wdg->show();
+  }
+  if (chat_was_visible) {
+    gui()->infotab->show();
+  }
+  if (gui()->unitbar_wdg != nullptr) {
+    gui()->unitbar_wdg->refresh(get_units_in_focus());
+  }
+}
+
+/************************************************************************//**
+  Close the overlay and open today's full dialog for the same city.
+****************************************************************************/
+void city_overlay::full_dialog()
+{
+  struct city *pcity = shown_city();
+
+  close_overlay();
+  if (pcity != nullptr) {
+    real_city_dialog_popup_full(pcity);
+  }
+}
+
+/************************************************************************//**
+  Put each part on its edge of the map (panels.md section 3.3).
+****************************************************************************/
+void city_overlay::place()
+{
+  int w = map->width();
+  int h = map->height();
+
+  yields->adjustSize();
+  production->adjustSize();
+  footer->adjustSize();
+  sections->set_max_height(h - 2 * EDGE_MARGIN);
+  sections->adjustSize();
+  yields->move(EDGE_MARGIN, EDGE_MARGIN);
+  sections->move(w - sections->width() - EDGE_MARGIN, EDGE_MARGIN);
+  production->move(EDGE_MARGIN, h - production->height() - EDGE_MARGIN);
+  footer->move((w - footer->width()) / 2,
+               h - footer->height() - EDGE_MARGIN);
+}
+
+/************************************************************************//**
+  Whether the overlay is open; the unit bar stays hidden while it is.
+****************************************************************************/
+bool city_overlay_is_open()
+{
+  return gui()->cityoverlay_wdg != nullptr
+         && gui()->cityoverlay_wdg->is_open();
+}
