+/************************************************************************//**
+  The right column: Citizens, then Buildings in a scroll area.
+****************************************************************************/
+city_sections::city_sections(QWidget *parent)
+  : city_part("city_sections", parent)
+{
+  QVBoxLayout *box = new QVBoxLayout(this);
+
+  box->setContentsMargins(8, 8, 8, 8);
+  box->setSpacing(6);
+  scroll_max = 400;
+  citizens = new city_section("citizens", this);
+  buildings = new city_section("buildings", this);
+  buildings_list = new QWidget;
+  buildings_list->setObjectName("city_buildings");
+  buildings_box = new QVBoxLayout(buildings_list);
+  buildings_box->setContentsMargins(0, 0, 0, 0);
+  buildings_box->setSpacing(2);
+  buildings_scroll = new QScrollArea(buildings);
+  buildings_scroll->setFrameShape(QFrame::NoFrame);
+  buildings_scroll->setWidgetResizable(true);
+  buildings_scroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+  buildings_scroll->viewport()->setAutoFillBackground(false);
+  buildings_scroll->setWidget(buildings_list);
+  buildings->body_layout()->addWidget(buildings_scroll);
+  box->addWidget(citizens);
+  box->addWidget(buildings);
+  setFixedWidth(SECTIONS_WIDTH);
+}
