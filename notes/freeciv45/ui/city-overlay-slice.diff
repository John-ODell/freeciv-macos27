+/************************************************************************//**
+  Fill both sections.
+****************************************************************************/
+void city_sections::refresh(struct city *pcity)
+{
+  setUpdatesEnabled(false);
+  fill_citizens(pcity);
+  fill_buildings(pcity);
+  setUpdatesEnabled(true);
+  adjustSize();
+}
