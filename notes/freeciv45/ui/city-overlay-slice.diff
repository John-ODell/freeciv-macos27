+  QVBoxLayout *buildings_box;
+  int scroll_max;
+};
+
+/****************************************************************************
+  Bottom left: the current build, Change and Buy
+****************************************************************************/
+class city_production : public city_part
+{
+  Q_OBJECT
+public:
+  city_production(QWidget *parent);
+  void refresh(struct city *pcity);
+private slots:
+  void change();
+  void buy();
+private:
+  QPushButton *change_button;
+  QPushButton *buy_button;
+  QLabel *pix_label;
+  QLabel *name_label;
+  QLabel *turns_label;
+  QProgressBar *progress;
+  int city_id;
+};
+
+/****************************************************************************
+  Bottom centre: Full dialog and Return to map
+****************************************************************************/
+class city_footer : public city_part
+{
+  Q_OBJECT
+public:
+  city_footer(QWidget *parent);
+};
+
+/****************************************************************************
+  The city overlay: a mode of the map view, not a window
+****************************************************************************/
+class city_overlay : public QObject
+{
+  Q_OBJECT
+public:
+  city_overlay(QWidget *map);
+  void open_for(struct city *pcity);
+  void refresh();
+  void place();
+  bool is_open() const { return city_id != 0; }
+  struct city *shown_city() const;
+public slots:
+  void close_overlay();
+  void full_dialog();
+private:
+  void set_colored(struct city *pcity, bool on);
+  QWidget *map;
+  city_yields *yields;
+  city_sections *sections;
+  city_production *production;
+  city_footer *footer;
+  int city_id;
+  bool colored_here;
+  bool minimap_was_visible;
+  bool chat_was_visible;
+};
+
+bool city_overlay_is_open();
+
+#endif // FC__CITYOVERLAY_H
