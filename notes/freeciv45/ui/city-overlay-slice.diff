+/************************************************************************//**
+  A part: named for the theme, styled by resource.qss as a frame.
+****************************************************************************/
+city_part::city_part(const char *name, QWidget *parent) : QFrame(parent)
+{
+  setObjectName(name);
+  setFrameShape(QFrame::StyledPanel);
+  setFocusPolicy(Qt::NoFocus);
+  hide();
+}
